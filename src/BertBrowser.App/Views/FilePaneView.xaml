<UserControl x:Class="BertBrowser.App.Views.FilePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PaneViewModel}"
             AutomationProperties.AutomationId="Pane">
    <UserControl.Resources>
        <Style x:Key="TabStripButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The active pane is outlined so it's obvious which of several open directories the next
         keystroke lands in. -->
    <Border BorderThickness="1" Background="White">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#DDD"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActivePane}" Value="True">
                        <Setter Property="BorderBrush" Value="#1C86D1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel>
            <!-- Tab strip. Always shown, even with one tab: the "+" is how you discover tabs. -->
            <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Tabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MinWidth="90" MaxWidth="200" Margin="2,2,0,0"
                                            CornerRadius="3,3,0,0" Padding="8,3"
                                            PreviewMouseDown="TabHeader_PreviewMouseDown"
                                            ToolTip="{Binding CurrentPath}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Duplicate tab"
                                                          Command="{Binding PlacementTarget.Tag.DuplicateTabCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Close other tabs"
                                                          Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Close tab" InputGestureText="Ctrl+W"
                                                          Command="{Binding PlacementTarget.Tag.CloseTabCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource TabStripButton}"
                                                    Margin="6,0,0,0" Padding="3,0" ToolTip="Close tab (Ctrl+W)"
                                                    Content="&#xE711;"
                                                    Command="{Binding DataContext.CloseTabCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                        <Button Style="{StaticResource TabStripButton}" Content="&#xE710;"
                                ToolTip="New tab (Ctrl+T)" Command="{Binding NewTabCommand}"/>
                        <Border Width="1" Margin="4,5" Background="#D0D0D0"/>
                        <Button Style="{StaticResource TabStripButton}" Content="&#xE76F;"
                                ToolTip="Split pane to the right (Ctrl+Alt+Right)"
                                Command="{Binding SplitVerticalCommand}"/>
                        <Button Style="{StaticResource TabStripButton}" Content="&#xE76E;"
                                ToolTip="Split pane below (Ctrl+Alt+Down)"
                                Command="{Binding SplitHorizontalCommand}"/>
                        <Button x:Name="ClosePaneButton" Style="{StaticResource TabStripButton}"
                                Content="&#xE8BB;" ToolTip="Close pane (Ctrl+Shift+W)"
                                Command="{Binding ClosePaneCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Every tab's view stays alive here and is only shown or hidden: a TabControl would
                 rebuild the content on each switch, losing the list's scroll position, its
                 selection, and its realized rows. -->
            <Grid x:Name="TabHost"/>
        </DockPanel>
    </Border>
</UserControl>
