<UserControl x:Class="BertBrowser.App.Views.PreviewPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:pv="clr-namespace:BertBrowser.Core.Services.Preview;assembly=BertBrowser.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PreviewPaneViewModel}"
             AutomationProperties.AutomationId="PreviewPane"
             Background="{StaticResource Theme.Window.Background}"
             BorderThickness="1,0,0,0"
             BorderBrush="{StaticResource Theme.Border.Default}">
    <!--
      One tab's preview. Every body below is bound to its own Has* flag rather than to a
      DataTrigger chain, because exactly one of them is ever true and a reader should be able to
      see that at a glance.

      The left edge is drawn here and not on the GridSplitter beside it. Theme.Splitter.Background
      is transparent in every built-in (the splitter only colours on hover and drag), and this pane
      shares Theme.Window.Background with the file list — so with nothing between them the two
      regions read as one surface. Border.Default rather than Border.Subtle: this is the seam
      between two panels, not a rule inside one, and Subtle is nearly invisible against the
      window background it would sit on. It rides on the UserControl's own template border,
      which honours BorderBrush/BorderThickness exactly as it already honours Background above.
    -->
    <UserControl.Resources>
        <!-- Merged rather than relied upon from a sibling: StaticResource searches a dictionary's
             own merged children, never its siblings. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Theme/Tokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PreviewFooterText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Theme.Text.Muted}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="Margin" Value="8,3,8,4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header: the name, then type / size / modified, and the dimensions once an image
             has actually been decoded. The fit-width button sits beside it rather than in the
             action strip below: it acts on the pane's own column width, not on what the body
             shows, so it belongs with the chrome that is always there. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Theme.Border.Subtle}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}"/>
                    <TextBlock Text="{Binding SubTitle}" FontSize="11"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="FitWidthButton" Grid.Column="1" Style="{StaticResource ToolbarButton}"
                        VerticalAlignment="Top" Margin="6,0,0,0"
                        Click="FitWidth_Click"
                        AutomationProperties.AutomationId="FitWidthButton"
                        ToolTip="Expand the pane to fit its contents">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitWidth}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Per-kind actions. Only the ones that apply to what is showing are visible. -->
        <Border DockPanel.Dock="Top" Padding="4,2"
                Visibility="{Binding HasActions, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <!-- Auto / Raw / Hex. Offered for any file the classifier did not refuse — the
                     binary dead-end included, since that message is exactly where hex is wanted.
                     Never for a folder or a cloud placeholder: see CanChooseMode. -->
                <Border BorderThickness="1" CornerRadius="4" Margin="2,0,6,0"
                        BorderBrush="{StaticResource Theme.Border.Subtle}"
                        Visibility="{Binding CanChooseMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Auto" ToolTip="Show the file the way its type suggests"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="{x:Static pv:PreviewMode.Auto}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PreviewModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Theme.Toolbar.CheckedForeground}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Raw" ToolTip="Decode the bytes as text, whatever the file claims to be"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="{x:Static pv:PreviewMode.Text}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PreviewModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRawMode}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Theme.Toolbar.CheckedForeground}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Hex" ToolTip="A hex dump: offset, bytes, ASCII"
                                Command="{Binding SetModeCommand}"
                                CommandParameter="{x:Static pv:PreviewMode.Hex}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PreviewModeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHexMode}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Theme.Toolbar.CheckedForeground}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding ToggleFitCommand}"
                        Content="{Binding FitLabel}"
                        ToolTip="Fit to the pane, or show at 100% and pan (double-click the image)"
                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
                <!-- Not offered over a dump: its rows are a fixed width, and wrapping them would
                     put half of one under the offset of the next. -->
                <Button Style="{StaticResource ToolbarButton}" Content="Wrap"
                        Command="{Binding ToggleWrapCommand}"
                        ToolTip="Wrap long lines (turns the line numbers off)"
                        Visibility="{Binding ShowWrapButton, Converter={StaticResource BoolToVisibility}}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Copy"
                        Click="CopyText_Click"
                        ToolTip="Copy the previewed text"
                        Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Details, from the shell's property handlers. Curated per kind, not the whole dump —
             the Properties dialog is where everything lives. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Theme.Border.Subtle}" Padding="8,4"
                Visibility="{Binding HasMetadata, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Metadata}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MetaLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Margin="0,0,10,0" FontSize="11"
                                       Foreground="{StaticResource Theme.Text.Muted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Whichever footer belongs to the body that is showing. -->
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PreviewFooterText}"
                   Text="{Binding TextFooter}"
                   Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PreviewFooterText}"
                   Text="{Binding ArchiveFooter}"
                   Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource PreviewFooterText}"
                   Text="{Binding FontFooter}"
                   Visibility="{Binding HasFont, Converter={StaticResource BoolToVisibility}}"/>

        <Grid>
            <!-- Image. The chequerboard is built in code-behind from the theme's two colours and
                 rebuilt when they change: a tiling brush caches its realisation, so recolouring a
                 brush inside one does not repaint it. -->
            <ScrollViewer x:Name="ImageScroller"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                <Border x:Name="ImageBackdrop" MouseLeftButtonDown="Image_MouseDown">
                    <Image x:Name="PreviewImage" Source="{Binding Image}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" StretchDirection="DownOnly"/>
                </Border>
            </ScrollViewer>

            <!-- Text and code. A RichTextBox rather than a TextBlock so the text can be selected
                 and copied, which Explorer's pane cannot do; the gutter is a single TextBlock
                 translated by the editor's scroll offset. -->
            <Grid Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="GutterHost" Grid.Column="0" ClipToBounds="True"
                        BorderThickness="0,0,1,0" BorderBrush="{StaticResource Theme.Border.Subtle}"
                        Visibility="{Binding ShowLineNumbers, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock x:Name="Gutter" TextAlignment="Right" Margin="6,4,6,4"
                               Foreground="{StaticResource Theme.Text.Muted}"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Top">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="GutterOffset"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
                <RichTextBox x:Name="TextView" Grid.Column="1" IsReadOnly="True"
                             BorderThickness="0" Padding="0"
                             IsUndoEnabled="False" AcceptsReturn="False"
                             VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Archive contents. Nothing is extracted to show this. -->
            <ListView ItemsSource="{Binding ArchiveEntries}" BorderThickness="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="240">
                            <GridViewColumnHeader Content="Name"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90">
                            <GridViewColumnHeader Content="Size"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeBytes, Converter={StaticResource ByteSize}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90">
                            <GridViewColumnHeader Content="Packed"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CompressedBytes, Converter={StaticResource ByteSize}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Font specimen, rendered with the face in the file itself. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFont, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="10">
                    <TextBlock Text="ABCDEFGHIJKLM&#x0a;NOPQRSTUVWXYZ&#x0a;abcdefghijklmnopqrstuvwxyz&#x0a;0123456789  &amp;@$£€ .,;:!?"
                               FontFamily="{Binding FontSpecimen}" FontSize="22" TextWrapping="Wrap"/>
                    <Separator Margin="0,10"/>
                    <TextBlock Text="Sphinx of black quartz, judge my vow."
                               FontFamily="{Binding FontSpecimen}" FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock Text="Sphinx of black quartz, judge my vow."
                               FontFamily="{Binding FontSpecimen}" FontSize="18" TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock Text="Sphinx of black quartz, judge my vow."
                               FontFamily="{Binding FontSpecimen}" FontSize="24" TextWrapping="Wrap" Margin="0,3"/>
                    <TextBlock Text="Sphinx of black quartz"
                               FontFamily="{Binding FontSpecimen}" FontSize="36" TextWrapping="Wrap" Margin="0,3"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Media. The poster frame is all there is until the user presses play — nothing is
                 opened, nothing makes a sound, and the harness photographs the poster. -->
            <Grid Visibility="{Binding HasMedia, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding MediaSource, Converter={StaticResource NullToVisible}}"/>
                <MediaElement x:Name="MediaView" LoadedBehavior="Manual" UnloadedBehavior="Close"
                              ScrubbingEnabled="True" Stretch="Uniform"
                              MediaOpened="Media_Opened" MediaEnded="Media_Ended" MediaFailed="Media_Failed"
                              Visibility="{Binding MediaSource, Converter={StaticResource NullToCollapsed}}"/>

                <Button Grid.Row="0" Style="{StaticResource ToolbarButton}" Content="▶  Play"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14,8"
                        Command="{Binding PlayMediaCommand}"
                        Visibility="{Binding MediaSource, Converter={StaticResource NullToVisible}}"/>

                <Grid Grid.Row="1" Margin="6,4" x:Name="Transport"
                      Visibility="{Binding MediaSource, Converter={StaticResource NullToCollapsed}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayPause" Style="{StaticResource ToolbarButton}" Content="❚❚"
                            Click="PlayPause_Click" MinWidth="30"/>
                    <Slider x:Name="Seek" Grid.Column="1" Margin="6,0" VerticalAlignment="Center"
                            Minimum="0" IsMoveToPointEnabled="True"
                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted"/>
                    <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center"
                               FontSize="11" Margin="0,0,8,0"
                               Foreground="{StaticResource Theme.Text.Secondary}"/>
                    <Slider Grid.Column="3" VerticalAlignment="Center" Minimum="0" Maximum="1"
                            Value="{Binding Volume, ElementName=MediaView, Mode=TwoWay}"
                            ToolTip="Volume"/>
                </Grid>
            </Grid>

            <!-- Loading, and the reason there is nothing. Both sit over the bodies rather than
                 beside them, so an empty pane is never simply blank. -->
            <TextBlock Text="Loading…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.Text.Muted}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="16" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Text.Muted}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</UserControl>
