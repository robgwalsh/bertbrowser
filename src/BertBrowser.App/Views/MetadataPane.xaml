<UserControl x:Class="BertBrowser.App.Views.MetadataPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MetadataViewModel}"
             AutomationProperties.AutomationId="MetadataPane"
             Background="{StaticResource Theme.Window.Background}"
             BorderThickness="1,0,0,0"
             BorderBrush="{StaticResource Theme.Border.Default}">
    <UserControl.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
        </Style>

        <!-- A field's box, drawn as the line of text a detail is until it is pointed at or typed
             in. The negative margin is the box's own border and padding, so its text starts where
             a detail's value does. A changed field keeps its outline: that is the mark of one. -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Margin" Value="-4,0,0,0"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Input.Border}"/>
                    <Setter Property="Background" Value="{StaticResource Theme.Input.Background}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource Theme.Input.Background}"/>
                    <Setter Property="Foreground" Value="{StaticResource Theme.Input.Foreground}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Input.Border}"/>
                    <Setter Property="Background" Value="{StaticResource Theme.Input.Background}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Theme.Error.Foreground}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!--
      One tab's metadata: the same column the preview stands in, showing the other thing there is
      to know about a selection — and letting it be changed. The left edge is drawn here for the
      reason the preview pane draws its own: the splitter beside it is transparent at rest.
    -->
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource Theme.Border.Subtle}" Padding="8,6">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Title}"/>
        </Border>

        <!-- Apply, and what it would do or just did. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource Theme.Border.Subtle}" Padding="8,6"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinWidth="70" Margin="8,0,0,0" Content="Apply"
                        VerticalAlignment="Center" Command="{Binding ApplyCommand}"
                        AutomationProperties.AutomationId="MetadataApply"/>
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           AutomationProperties.AutomationId="MetadataSummary"/>
            </DockPanel>
        </Border>

        <Grid>
            <!-- An unexplained blank pane reads as a failure, so it says why it is empty. -->
            <TextBlock Text="Select something to see and edit its metadata." Margin="10" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Text.Secondary}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <!-- One label column for the details and the fields alike, so the two read as one table. -->
                <StackPanel Margin="8,6" Grid.IsSharedSizeScope="True">
                    <!-- What nobody can type: facts about the data rather than tags in it. From the
                         shell's property handlers, so it covers every type Windows understands. First,
                         because it is what a glance at a file is usually for. -->
                    <StackPanel Margin="0,0,0,8"
                                Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Details" Style="{StaticResource SectionHeading}"/>
                        <ItemsControl ItemsSource="{Binding Details}" Focusable="False"
                                      AutomationProperties.AutomationId="MetadataDetails">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Margin="0,0,10,0" FontSize="11"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- The fields, set like the details above them: a row of text each, which only
                         shows itself to be a box under the pointer or the caret. -->
                    <TextBlock Text="Fields" Style="{StaticResource SectionHeading}"
                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False"
                                  AutomationProperties.AutomationId="MetadataFields">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Margin="0,0,10,0" FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Theme.Text.Secondary}"/>

                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"
                                             ToolTip="{Binding Hint}"
                                             AutomationProperties.Name="{Binding Label}"/>

                                    <!-- Over the box, not in it: placeholder text must never be something
                                         the box could hand back as its value. -->
                                    <TextBlock Grid.Column="1" Text="(multiple values)" FontSize="11"
                                               VerticalAlignment="Center" IsHitTestVisible="False" FontStyle="Italic"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               Visibility="{Binding ShowsMixedPlaceholder, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- A date is typed like any other field; this is the other way in. -->
                                    <ToggleButton x:Name="PickDate" Grid.Column="2" Margin="2,0,0,0" Padding="2,0"
                                                  Background="Transparent" BorderThickness="0"
                                                  VerticalAlignment="Center"
                                                  Foreground="{StaticResource Theme.Text.Secondary}"
                                                  ToolTip="Pick a date"
                                                  AutomationProperties.Name="Pick a date"
                                                  Visibility="{Binding IsDate, Converter={StaticResource BoolToVisibility}}">
                                        <Path Style="{StaticResource IconPath}" Width="12" Height="12"
                                              Data="{StaticResource Icon.FileDates}"/>
                                    </ToggleButton>
                                    <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=PickDate}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True"
                                           IsOpen="{Binding IsChecked, ElementName=PickDate, Mode=TwoWay}">
                                        <Calendar SelectedDate="{Binding PickedDate, Mode=TwoWay}"
                                                  PreviewMouseUp="Calendar_PreviewMouseUp"/>
                                    </Popup>

                                    <Button Grid.Column="3" Style="{StaticResource ToolbarButton}"
                                            Margin="2,0,0,0" Padding="2,0" MinWidth="0" MinHeight="0" Height="16" VerticalAlignment="Center"
                                            Foreground="{StaticResource Theme.Text.Secondary}"
                                            Command="{Binding RevertCommand}"
                                            ToolTip="Put this field back as it was"
                                            AutomationProperties.Name="Revert"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                                        <Path Style="{StaticResource IconPath}" Width="12" Height="12"
                                              Data="{StaticResource Icon.Undo}"/>
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Note}"
                                               FontSize="10" Margin="0,0,0,1"
                                               Visibility="{Binding ShowsNote, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Theme.Error.Foreground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The cover picture: an album's sleeve, embedded in the file. Acts at once, like
                         the removals below — a picture is chosen from a file, not typed. -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding CanHoldPicture, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Cover picture" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Border HorizontalAlignment="Left" MaxWidth="160" MaxHeight="160" Margin="0,0,0,6"
                                BorderThickness="1" BorderBrush="{StaticResource Theme.Border.Subtle}"
                                Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}">
                            <Image Source="{Binding Picture}" Stretch="Uniform"
                                   AutomationProperties.AutomationId="MetadataPicture"/>
                        </Border>
                        <TextBlock Text="{Binding PictureNote}" FontSize="11" Margin="0,0,0,6" FontStyle="Italic"
                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                   Visibility="{Binding HasPictureNote, Converter={StaticResource BoolToVisibility}}"/>
                        <WrapPanel>
                            <Button Content="Choose…" Margin="0,0,6,4" Padding="8,2" Click="ChoosePicture_Click"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    ToolTip="Embed a picture file as the cover"
                                    AutomationProperties.AutomationId="MetadataChoosePicture"/>
                            <Button Content="Save as…" Margin="0,0,6,4" Padding="8,2" Click="SavePicture_Click"
                                    Visibility="{Binding HasPicture, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Save the embedded picture as a file"/>
                            <Button Content="Remove" Margin="0,0,0,4" Padding="8,2"
                                    Command="{Binding RemovePictureCommand}"
                                    AutomationProperties.AutomationId="MetadataRemovePicture"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Removing. Buttons that act at once rather than boxes to tick and apply: each is
                         a whole request on its own, and both are one undo away from never having happened. -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding LocationNote}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"
                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                   AutomationProperties.AutomationId="MetadataLocationNote"/>
                        <WrapPanel>
                            <Button Content="Remove location" Margin="0,0,6,4" Padding="8,2"
                                    Command="{Binding RemoveLocationCommand}"
                                    ToolTip="Take the GPS position out of these pictures and leave everything else."
                                    AutomationProperties.AutomationId="MetadataRemoveLocation"/>
                            <Button Content="Remove all metadata" Margin="0,0,0,4" Padding="8,2"
                                    Command="{Binding RemoveAllCommand}"
                                    ToolTip="Take out everything that describes these files. A picture keeps its rotation and colour profile."
                                    AutomationProperties.AutomationId="MetadataRemoveAll"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- The selection, once there is more than one thing in it or something to say
                         about the one: which items a field reaches, and why one was left out. -->
                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,12,0,0" Focusable="False"
                                  AutomationProperties.AutomationId="MetadataFiles">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Margin="6,0,0,0" CornerRadius="3" Padding="5,0"
                                                VerticalAlignment="Center">
                                            <!-- Existing tokens only, the ones the checksum verdicts use. -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Changed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="{StaticResource Theme.Error.Background}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding State}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Detail}" Margin="22,1,0,0" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
