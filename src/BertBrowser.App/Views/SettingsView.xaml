<!--
  Settings, shown in place of everything below the main window's title bar rather than as a dialog
  (MainWindow.ShowSettings). There is no Save or Cancel: every change is written as it is made
  (SettingsViewModel.Apply), so Back and Esc only ever mean "back to the folders".
-->
<UserControl x:Class="BertBrowser.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
        xmlns:v="clr-namespace:BertBrowser.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        d:DesignWidth="1000" d:DesignHeight="700"
        Background="{StaticResource Theme.Window.Background}"
        TextElement.Foreground="{StaticResource Theme.Text.Primary}"
        KeyDown="View_KeyDown">
    <UserControl.Resources>
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- The explanatory line under a control. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Where the dialog had Save and Cancel. Everything applies as it is changed, so all that
             is left to offer is the way back to the folders. -->
        <Border DockPanel.Dock="Top" Padding="8,6"
                Background="{StaticResource Theme.Surface.Background}"
                BorderThickness="0,1,0,1" BorderBrush="{StaticResource Theme.Border.Subtle}">
            <!-- Close on the right: the Settings button that opened this sits at the right of the
                 title bar, so that is where the pointer already is. 12 rather than IconPath's 16,
                 because the dismiss glyph fills its box edge to edge, as the search boxes' does. -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="Back_Click"
                        VerticalAlignment="Center"
                        ToolTip="Close settings (Esc)"
                        AutomationProperties.AutomationId="SettingsClose"
                        AutomationProperties.Name="Close settings">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}"
                          Width="12" Height="12"/>
                </Button>
                <!-- The bottom margin lifts the text by its descender space, so the middle of the
                     letters, not the middle of the line box, lines up with the close button. -->
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,2"/>
            </DockPanel>
        </Border>

        <!-- Navigation. One page is visible at a time; the pages themselves are below. -->
        <Border DockPanel.Dock="Left" Width="200"
                Background="{StaticResource Theme.Surface.Background}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource Theme.Border.Subtle}">
            <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     AutomationProperties.AutomationId="SettingsCategoryList"
                     AutomationProperties.Name="Settings categories">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{Binding Icon}"
                                  Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- An entry that cannot be written yet. Said here rather than by jumping pages or raising
             a dialog, because a half-typed command is what every command looks like while it is
             being typed. -->
        <Border DockPanel.Dock="Top" Padding="18,6"
                Background="{StaticResource Theme.Warning.Background}"
                Visibility="{Binding PendingProblem, Converter={StaticResource NullToCollapsed}}"
                AutomationProperties.AutomationId="SettingsPendingProblem">
            <TextBlock Text="{Binding PendingProblem}" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Warning.Foreground}"/>
        </Border>

        <!-- Scrolls so a short window still reaches the bottom of a long page, and the width is
             capped so a maximised window does not stretch every hint across the monitor. MinHeight
             is the viewport so the list pages still fill the space when there is room; given less,
             their lists grow to their content and the page scrolls instead. -->
        <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <!-- The Context menu page never scrolls as a whole: it takes exactly the viewport, and
                 its two columns scroll inside themselves, so a drag between them reaches every row.
                 Disabled rather than Hidden is what hands the page a finite height to fill. -->
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                     Value="{x:Static vm:SettingsCategory.ContextMenu}">
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                        </DataTrigger>
                        <!-- The Keyboard page too: its list scrolls inside itself so the recorder
                             strip beneath it never leaves the screen. -->
                        <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                     Value="{x:Static vm:SettingsCategory.Keyboard}">
                            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <!-- A capped star column rather than MaxWidth on the page itself, which would centre it
                 once the window is wider than the cap. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroller}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="900"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Margin="18,16">

                <!-- General -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.General}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="General" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Show hidden items" IsChecked="{Binding ShowHiddenItems}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Show hidden files and folders in listings and search results"/>

                    <CheckBox Content="Open archives as folders" Margin="0,12,0,0"
                              IsChecked="{Binding EnterArchivesOnDoubleClick}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Double-clicking a zip, 7z, tar or rar walks into it. With this off they open in whichever program owns them — and the breadcrumb, Enter and typing the path still go in."/>

                    <CheckBox Content="Middle-click a drive/device to open a new panel" Margin="0,12,0,0"
                              IsChecked="{Binding OpenDrivesInNewPanel}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Middle-clicking a drive or device in the DRIVES &amp; DEVICES sidebar opens it in a new panel instead of a new tab. A plain click always opens a new tab."/>

                    <CheckBox Content="Restore last session on startup" Margin="0,12,0,0"
                              IsChecked="{Binding RestoreLastSession}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="When off, the app always opens a single tab at the folder below instead of wherever the panes were left."/>

                    <DockPanel Margin="0,8,0,0" IsEnabled="{Binding RestoreLastSession, Converter={StaticResource InverseBool}}">
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseStartupPath_Click"/>
                        <TextBox Text="{Binding StartupDefaultPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="Vertical scroll speed" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScrollSpeedText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="36"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="1" Maximum="6"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Value="{Binding ScrollSpeed, Mode=TwoWay}"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="Tile aspect ratio" VerticalAlignment="Center"/>
                        <!-- ItemTemplate rather than DisplayMemberPath, for the reason spelled out
                             on the theme picker: the retemplated box renders its closed state from
                             SelectionBoxItemTemplate, which WPF derives from ItemTemplate alone. -->
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding TileAspectOptions}"
                                  SelectedItem="{Binding TileAspect, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- Machine state, not a stored setting: this writes the shell's Directory and
                         Drive open verbs under HKCU the moment it is ticked, through its own
                         service rather than the settings file. -->
                    <StackPanel Visibility="{Binding CanChooseFolderHandler, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,4,0,14"/>

                        <CheckBox Content="Open folders in BertBrowser instead of File Explorer"
                                  IsChecked="{Binding OpenFoldersHere}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="This PC and Control Panel keep opening in File Explorer, and so does a zip opened from Explorer — BertBrowser browses archives in its own window. So does anything that runs explorer.exe by name — Win+E, the taskbar icon, and some apps' &quot;Show in folder&quot;."/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Foreground="{StaticResource Theme.Warning.Foreground}"
                                   Text="{Binding FolderHandlerWarning}"
                                   Visibility="{Binding HasFolderHandlerWarning, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Preview -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Preview}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Preview" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Show the preview pane in new tabs" IsChecked="{Binding ShowPreviewPane}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               v:Cmd.Text="Each tab keeps its own preview pane, so one pane can preview while another shows a full-width list. This is what a new tab starts with; {view.preview} toggles the one in front of you."/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Read at most" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewTextLimitText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="60"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="64" Maximum="8192"
                                TickFrequency="64" IsSnapToTickEnabled="True"
                                Value="{Binding PreviewTextLimitKb, Mode=TwoWay}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Trim text after this amount."/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Search inside files up to" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ContentSearchLimitText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="60"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="64" Maximum="8192"
                                TickFrequency="64" IsSnapToTickEnabled="True"
                                Value="{Binding ContentSearchLimitKb, Mode=TwoWay}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="How much of each file content: reads. A file longer than this is searched to here and no further, and the status bar says so rather than reporting it as a miss."/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="Previews don't hold file locks!"/>
                </StackPanel>

                <!--
                  Search index: the elevated helper's switches. Its own page because the helper now
                  outlives the app — a process still running with an administrator token after the
                  window closes deserves somewhere that says so, and a way to stop it.
                -->
                <StackPanel AutomationProperties.AutomationId="SettingsSearchIndexPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.SearchIndex}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Search index" Style="{StaticResource PageHeading}"/>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Stop" Padding="12,4" Margin="8,0,0,0"
                                Command="{Binding StopIndexerCommand}"
                                IsEnabled="{Binding CanStopIndexer}"
                                AutomationProperties.AutomationId="StopIndexer"/>
                        <Button DockPanel.Dock="Right" Content="Start" Padding="12,4"
                                Command="{Binding StartIndexerNowCommand}"
                                IsEnabled="{Binding CanStartIndexerNow}"
                                AutomationProperties.AutomationId="StartIndexerNow"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                   AutomationProperties.AutomationId="IndexerStatus">
                            <Run Text="Background indexer:"/><Run Text=" "/><Run Text="{Binding IndexerStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <Separator Margin="0,4,0,14"/>

                    <CheckBox Content="Start the indexer when BertBrowser launches"
                              IsChecked="{Binding StartIndexerAtLaunch}"
                              AutomationProperties.AutomationId="StartIndexerAtLaunch"/>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding CanChooseAutoStart, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Start the indexer automatically when I sign in"
                                  IsChecked="{Binding StartIndexerAtLogon}"
                                  AutomationProperties.AutomationId="StartIndexerAtLogon"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Foreground="{StaticResource Theme.Warning.Foreground}"
                                   Text="{Binding AutoStartWarning}"
                                   Visibility="{Binding HasAutoStartWarning, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.AutomationId="AutoStartWarning"/>
                    </StackPanel>
                </StackPanel>

                <!--
                  History: the change timeline's switch. Its own page rather than a line on General
                  because what it records is sensitive enough to deserve the explanation beside it,
                  and off by default for the same reason.
                -->
                <StackPanel AutomationProperties.AutomationId="SettingsHistoryPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.History}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="History" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Record file changes" IsChecked="{Binding RecordFileChanges}"
                              AutomationProperties.AutomationId="RecordFileChanges"/>
                    <TextBlock Style="{StaticResource Hint}"
                               v:Cmd.Text="Keeps a log of every file created, changed, deleted or renamed on every indexed drive, so the &quot;What changed&quot; window ({tools.changes}) can show what an installer or a build just did. The log lives in BertBrowser's own database in your profile folder, readable by anything that can read your files — which is why it is off unless you turn it on. Turning it off deletes what was kept, straight away."/>

                    <DockPanel Margin="0,4,0,0" IsEnabled="{Binding RecordFileChanges}">
                        <TextBlock Text="Keep changes for" VerticalAlignment="Center"/>
                        <!-- ItemTemplate rather than DisplayMemberPath, for the reason spelled out
                             on the theme picker. -->
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding RetentionOptions}"
                                  SelectedValue="{Binding FileChangeRetentionHours, Mode=TwoWay}"
                                  SelectedValuePath="Hours"
                                  AutomationProperties.Name="Keep changes for">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Older changes are dropped as new ones arrive. Whatever you pick, the log never grows past half a million rows."/>

                    <Separator Margin="0,4,0,14"/>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear history now" Padding="12,4"
                                Command="{Binding ClearHistoryCommand}"
                                IsEnabled="{Binding CanClearHistory}"
                                AutomationProperties.AutomationId="ClearHistory"/>
                        <TextBlock Text="{Binding RecordedCountText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                   AutomationProperties.AutomationId="RecordedCount"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Deletes the log straight away."/>

                    <!--
                      The undo history's limits. On this page because it is the other history the
                      app keeps — but unlike the change log it is on by default, since nothing it
                      holds outlives the session, and the hint says so.
                    -->
                    <TextBlock Text="Undo" FontWeight="SemiBold" Margin="0,22,0,8"/>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Keep up to" VerticalAlignment="Center"/>
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding UndoStepOptions}"
                                  SelectedValue="{Binding UndoMaxSteps, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  AutomationProperties.Name="Undo steps kept">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Hold up to this much set-aside data" VerticalAlignment="Center"/>
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding UndoHeldOptions}"
                                  SelectedValue="{Binding UndoMaxHeldGigabytes, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  AutomationProperties.Name="Undo data held">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               v:Cmd.Text="Undo history lasts for this session only; {edit.undo-history} shows it. To make undo possible, BertBrowser holds on to what you replace or delete into its own holding folder, and an edited archive's original. When the history goes past either limit, the oldest actions are released and what they held is removed for good. The same happens when you clear the history or close BertBrowser. The action you would undo next is never released, however large it is. Items sent to the Recycle Bin stay there either way."/>
                </StackPanel>

                <!-- Appearance persists through IThemeService rather than SettingsViewModel.Apply,
                     but to the user it behaves like everything else here: picking applies. -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Appearance}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Appearance" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Match Windows light/dark"
                              IsChecked="{Binding Appearance.FollowSystemTheme}"
                              AutomationProperties.AutomationId="FollowSystemTheme"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Switches theme when Windows does, without a restart. Turning on Windows high contrast switches to High Contrast Dark whatever is picked below, and turning it off comes back here."/>

                    <!-- The single picker: what you get when you are not following. -->
                    <DockPanel Visibility="{Binding Appearance.FollowSystemTheme, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button DockPanel.Dock="Right" Content="Customise colours…" Margin="8,0,0,0"
                                Click="CustomiseTheme_Click"
                                ToolTip="Edit any colour in this theme and save it as your own"/>
                        <!-- ItemTemplate, not DisplayMemberPath: the themed ComboBox template drives
                             its closed state from SelectionBoxItemTemplate, which WPF only fills in
                             from ItemTemplate. With DisplayMemberPath the box shows ToString(). -->
                        <ComboBox ItemsSource="{Binding Appearance.Themes}"
                                  SelectedItem="{Binding Appearance.SelectedTheme, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource ThemeNameTemplate}"
                                  AutomationProperties.AutomationId="ThemePicker"
                                  AutomationProperties.Name="Theme"/>
                    </DockPanel>

                    <!-- ...and the pair that replaces it while following. -->
                    <!-- A Grid rather than two DockPanels so both combos share one column and line
                         up: with the button docked into the first row only, a DockPanel would let
                         the dark combo run on under it. -->
                    <Grid Visibility="{Binding Appearance.FollowSystemTheme, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Light theme"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding Appearance.LightThemes}"
                                  SelectedItem="{Binding Appearance.SelectedLightTheme, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource ThemeNameTemplate}"
                                  AutomationProperties.AutomationId="LightThemePicker"
                                  AutomationProperties.Name="Light theme"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Customise colours…"
                                Margin="8,0,0,0" Click="CustomiseTheme_Click"
                                ToolTip="Edit any colour in the theme currently in use and save it as your own"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dark theme"
                                   VerticalAlignment="Center" Margin="0,6,12,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                  ItemsSource="{Binding Appearance.DarkThemes}"
                                  SelectedItem="{Binding Appearance.SelectedDarkTheme, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource ThemeNameTemplate}"
                                  AutomationProperties.AutomationId="DarkThemePicker"
                                  AutomationProperties.Name="Dark theme"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource Theme.Warning.Foreground}"
                               Text="{Binding Appearance.IssueText}"
                               Visibility="{Binding Appearance.IssueText, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>

                <!-- File types on the New submenu -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.NewItems}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="New file types"
                               Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               Text="These appear on the New submenu of the file list and folder tree, in this order. A type with no template file makes an empty file. New ▸ Folder is always offered and is not listed here."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Type list, in menu order -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add" Padding="12,3" Margin="0,0,6,0"
                                        Command="{Binding AddNewFileTypeCommand}"/>
                                <Button Content="Remove" Padding="12,3" Margin="0,0,6,0"
                                        Command="{Binding RemoveNewFileTypeCommand}"/>
                                <Button Content="↑" Padding="9,3" Margin="0,0,6,0" ToolTip="Move up"
                                        Command="{Binding MoveNewFileTypeUpCommand}"/>
                                <Button Content="↓" Padding="9,3" ToolTip="Move down"
                                        Command="{Binding MoveNewFileTypeDownCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding NewFileTypes}"
                                     SelectedItem="{Binding SelectedNewFileType, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <CheckBox DockPanel.Dock="Left" Margin="0,0,6,0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      ToolTip="Show this type on the New menu"/>
                                            <TextBlock Text="{Binding Extension}" Margin="6,0,0,0"
                                                       DockPanel.Dock="Right" Opacity="0.6"/>
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Editor for the selected type -->
                        <Grid Grid.Column="2" VerticalAlignment="Top">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNewFileType}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.Label, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extension:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.Extension, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Template:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,6,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.TemplatePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="…" Width="28" Margin="0,0,0,8"
                                    ToolTip="Browse for a template file" Click="BrowseTemplate_Click"/>

                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                       Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Leave blank to create an empty file."/>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <Button Content="Import from Windows…" Padding="12,3"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ImportFromWindowsCommand}"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Adds the file types Windows offers in its own New menu."/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource Theme.Text.Secondary}"
                                           Text="{Binding ImportStatus}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>


                <!-- The default columns a new tab starts from -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Columns}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="Columns" Style="{StaticResource PageHeading}"
                               Margin="0,0,0,4"/>

                    <!-- Two buttons where there were four: the popup behind Add reaches the whole
                         property system, and dragging a row replaced the up and down pair. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddColumnButton" Padding="10,3" Margin="0,0,6,0"
                                Click="AddColumn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}"
                                           Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add column"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Reset" Padding="12,3" Command="{Binding ResetColumnsCommand}"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                   Foreground="{StaticResource Theme.Text.Muted}"
                                   Text="Drag to reorder. Scroll a width to change it."/>
                    </StackPanel>

                    <ListBox x:Name="ColumnDefaultsList"
                             AutomationProperties.AutomationId="ColumnDefaultsList"
                             ItemsSource="{Binding Columns}"
                             SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="ColumnList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <!-- One line per column, not two: the canonical name moved onto the row
                                 beside the header, which is what took the height off these. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Fixed rather than Auto: Name has no × and the width boxes would
                                             otherwise sit a button further right on that one row. -->
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The grip is a label, not a handle: the whole row is draggable,
                                         and a target this small would be a worse one. E75F is the dot
                                         gripper — E76F next to it is two thin bars that read as an
                                         equals sign at this size. -->
                                    <Path Style="{StaticResource IconPath}" Grid.Column="0" Data="{StaticResource Icon.Reorder}" Margin="2,0,8,0" Width="12" Height="12"
                                               VerticalAlignment="Center" Opacity="0.55"/>

                                    <!-- DockPanel, not a horizontal StackPanel: a stack hands both
                                         children their full desired width, so the canonical name
                                         would be hard-clipped by the column instead of trimmed. -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Header}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- What lands in settings.json, and the only way to tell
                                             two similarly-named properties apart. Empty for a
                                             built-in, whose id is its header. -->
                                        <TextBlock Text="{Binding Detail}" Margin="8,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                    </DockPanel>
                                    <TextBox Grid.Column="2" Width="52" VerticalAlignment="Center"
                                             Padding="4,2" TextAlignment="Right"
                                             ToolTip="Width in pixels. Scroll to change it, or hold Ctrl to scroll by one."
                                             PreviewMouseWheel="ColumnWidth_Wheel"
                                             Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>

                                    <!-- Hover-revealed, so a list of columns reads as a list of
                                         columns rather than a column of buttons. Absent on Name,
                                         the one row that cannot be removed. -->
                                    <Button Grid.Column="3" Width="22" Height="22" Margin="4,0,0,0"
                                            ToolTip="Remove this column"
                                            Visibility="{Binding Removable, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.RemoveColumnCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Content>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}"
                                                       Width="11" Height="11"/>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsMouseOver,
                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!--
                  Saved searches: the Workspaces page's twin, below. Edit rather than Rename, because
                  the dialog it opens is the sidebar's Edit — name, query and scope together.
                -->
                <StackPanel AutomationProperties.AutomationId="SettingsSavedSearchesPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.SavedSearches}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Saved searches" Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>

                    <TextBlock Text="Show saved searches" Margin="0,0,0,6"/>
                    <RadioButton GroupName="SavedSearchesPlacement" Content="In the sidebar"
                                 Margin="0,0,0,6"
                                 IsChecked="{Binding SavedSearchesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Sidebar}"
                                 AutomationProperties.AutomationId="SavedSearchesInSidebar"/>
                    <RadioButton GroupName="SavedSearchesPlacement" Content="In the title bar, beside the app name"
                                 Margin="0,0,0,6"
                                 IsChecked="{Binding SavedSearchesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=TitleBar}"
                                 AutomationProperties.AutomationId="SavedSearchesInTitleBar"/>
                    <RadioButton GroupName="SavedSearchesPlacement" Content="Nowhere"
                                 IsChecked="{Binding SavedSearchesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Hidden}"
                                 AutomationProperties.AutomationId="SavedSearchesHidden"/>

                    <Separator Margin="0,4,0,14"/>

                    <TextBlock Text="Your saved searches" Style="{StaticResource PageHeading}" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                               Text="Nothing saved yet. Type a search, then press the save button inside the search box."
                               Visibility="{Binding SavedSearches.HasItems, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}"
                               AutomationProperties.AutomationId="SettingsSavedSearchesEmpty"/>

                    <StackPanel Visibility="{Binding SavedSearches.HasItems, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <!-- Column headings; the widths repeat the row template's, as on Workspaces. -->
                        <Grid Margin="11,0,9,4" TextElement.Foreground="{StaticResource Theme.Text.Secondary}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="Searches" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="Created" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="Last run" FontSize="11"/>
                        </Grid>

                        <ListBox x:Name="SavedSearchList"
                                 ItemsSource="{Binding SavedSearches.Items}"
                                 SelectedItem="{Binding SelectedSavedSearch, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewKeyDown="SavedSearchList_KeyDown"
                                 AutomationProperties.AutomationId="SettingsSavedSearchList"
                                 AutomationProperties.Name="Saved searches">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="10,6,8,6"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- The name, and under it the query exactly as it runs. -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Query}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Theme.Text.Secondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Query}"/>
                                        </StackPanel>
                                        <!-- A pinned folder is named in the tooltip; the column
                                             is too narrow for a path. -->
                                        <TextBlock Grid.Column="1" Text="{Binding ScopeColumnText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ScopeText}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LastUsedText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ToolbarButton}" Width="24" Height="24" Padding="5"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Edit name, search and scope (F2)"
                                                    Click="SavedSearchEdit_Click"
                                                    AutomationProperties.Name="Edit saved search">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Rename}"/>
                                            </Button>
                                            <Button Style="{StaticResource ToolbarButton}" Width="24" Height="24" Padding="5"
                                                    ToolTip="Delete (Del)"
                                                    Click="SavedSearchDelete_Click"
                                                    AutomationProperties.Name="Delete saved search">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Deleting a saved search removes only the search — no file it found is touched."/>
                    </StackPanel>
                </StackPanel>

                <!--
                  Workspaces: where the switcher lives, and every saved one in detail. A StackPanel
                  rather than a filling DockPanel so the list grows to its rows and the page scrolls,
                  which keeps the header row over the columns it names — a list scrolling on its own
                  would take a scrollbar's width off the rows and not off the header.
                  Rename and delete act straight away through the shell, like the sidebar's menu.
                -->
                <StackPanel AutomationProperties.AutomationId="SettingsWorkspacesPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Workspaces}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Workspaces" Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,14"
                               Text="A workspace is your panes and tabs saved under a name, to switch back to in one click. Switching replaces the panes you have open."/>

                    <TextBlock Text="Show the workspace switcher" Margin="0,0,0,6"/>
                    <RadioButton GroupName="WorkspacesPlacement" Content="In the sidebar"
                                 Margin="0,0,0,6"
                                 IsChecked="{Binding WorkspacesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Sidebar}"
                                 AutomationProperties.AutomationId="WorkspacesInSidebar"/>
                    <RadioButton GroupName="WorkspacesPlacement" Content="In the title bar, beside the app name"
                                 Margin="0,0,0,6"
                                 IsChecked="{Binding WorkspacesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=TitleBar}"
                                 AutomationProperties.AutomationId="WorkspacesInTitleBar"/>
                    <RadioButton GroupName="WorkspacesPlacement" Content="Nowhere"
                                 IsChecked="{Binding WorkspacesPlacement, Converter={StaticResource EnumEqualsBool}, ConverterParameter=Hidden}"
                                 AutomationProperties.AutomationId="WorkspacesHidden"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Nowhere only hides the switcher. Your workspaces are kept, and stay listed below."/>

                    <Separator Margin="0,4,0,14"/>

                    <TextBlock Text="Saved workspaces" Style="{StaticResource PageHeading}" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,0"
                               Text="Nothing saved yet. Use the + beside WORKSPACES in the sidebar, or Save current layout in the title bar's workspace menu."
                               Visibility="{Binding Workspaces.HasItems, Converter={StaticResource InverseBoolToVisibility}, FallbackValue=Visible}"
                               AutomationProperties.AutomationId="SettingsWorkspacesEmpty"/>

                    <StackPanel Visibility="{Binding Workspaces.HasItems, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <!-- Column headings. The widths repeat the row template's, and the left
                             margin is the list's border plus its row padding. -->
                        <Grid Margin="11,0,9,4" TextElement.Foreground="{StaticResource Theme.Text.Secondary}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Name" FontSize="11"/>
                            <TextBlock Grid.Column="1" Text="Layout" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="Created" FontSize="11"/>
                            <TextBlock Grid.Column="3" Text="Last opened" FontSize="11"/>
                        </Grid>

                        <ListBox x:Name="WorkspaceList"
                                 ItemsSource="{Binding Workspaces.Items}"
                                 SelectedItem="{Binding SelectedWorkspace, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewKeyDown="WorkspaceList_KeyDown"
                                 AutomationProperties.AutomationId="SettingsWorkspaceList"
                                 AutomationProperties.Name="Saved workspaces">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="10,6,8,6"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- The name, and under it the folders it opens: what tells
                                             two similarly named workspaces apart. -->
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FoldersText}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Theme.Text.Secondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FoldersToolTip}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ShapeText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CreatedText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LastUsedText}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ToolbarButton}" Width="24" Height="24" Padding="5"
                                                    Margin="0,0,4,0"
                                                    ToolTip="Rename (F2)"
                                                    Click="WorkspaceRename_Click"
                                                    AutomationProperties.Name="Rename workspace">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Rename}"/>
                                            </Button>
                                            <Button Style="{StaticResource ToolbarButton}" Width="24" Height="24" Padding="5"
                                                    ToolTip="Delete (Del)"
                                                    Click="WorkspaceDelete_Click"
                                                    AutomationProperties.Name="Delete workspace">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Deleting a workspace removes only its name and layout — no folder or file is touched."/>
                    </StackPanel>
                </StackPanel>

                <!--
                  Keyboard: every command with the keys that run it. Like the Context menu page it
                  takes exactly the viewport (see PageScroller's style) and the list scrolls inside
                  itself, so the recorder strip under it is always in sight — it is where a shortcut
                  being taken, refused or offered for reassignment is said. Nothing here waits on the
                  page's debounce: KeymapService writes each change as it is made
                  (SettingsViewModel.Keyboard).
                -->
                <DockPanel x:Name="KeyboardPage" AutomationProperties.AutomationId="SettingsKeyboardPage">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Keyboard}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="Keyboard" Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,12"
                               v:Cmd.Text="Every command, and the keys that run it. Select one and choose Change, then press the keys you want. The command palette ({app.palette}) finds any of these by name."/>

                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Reset all" MinWidth="88" Margin="8,0,0,0"
                                Command="{Binding ResetAllKeysCommand}"
                                ToolTip="Put every command back to the shortcut it ships with"
                                AutomationProperties.AutomationId="KeyboardResetAll"/>
                        <Button DockPanel.Dock="Right" Content="Find by key…" MinWidth="104" Margin="8,0,0,0"
                                Command="{Binding FindKeyCommand}"
                                ToolTip="Press a shortcut to see which command it runs"
                                AutomationProperties.AutomationId="KeyboardFindByKey"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}" Width="12" Height="12"
                                      IsHitTestVisible="False" Fill="{StaticResource Theme.Text.Secondary}"/>
                                <TextBox x:Name="KeyFilterBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         Padding="0,3,6,3" VerticalContentAlignment="Center"
                                         Text="{Binding KeyFilter, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="KeyboardFilter"
                                         AutomationProperties.Name="Filter commands"/>
                                <TextBlock Grid.Column="1" Margin="2,0,0,0" Text="Filter by name, category or shortcut"
                                           IsHitTestVisible="False" VerticalAlignment="Center"
                                           Foreground="{StaticResource Theme.Text.Placeholder}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=KeyFilterBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>

                    <!-- The recorder. Always here, so the list above does not jump when it starts
                         listening: at rest it holds the selected command's actions, and while it is
                         listening it says what it heard. -->
                    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="12,9" CornerRadius="4"
                            Background="{StaticResource Theme.Surface.Raised}"
                            BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ReassignKeyButton" Content="Reassign" MinWidth="88" Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ReassignKeyCommand}"
                                        Visibility="{Binding CanReassignKey, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.AutomationId="KeyboardReassign"/>
                                <Button Content="Cancel" MinWidth="88" Margin="8,0,0,0"
                                        Command="{Binding CancelKeyCaptureCommand}"
                                        Visibility="{Binding ShowsRecorder, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding ShowsRecorder, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Button Content="Change…" MinWidth="88" Margin="8,0,0,0"
                                            Command="{Binding ChangeKeyCommand}"
                                            ToolTip="Replace this command's shortcut (Enter)"
                                            AutomationProperties.AutomationId="KeyboardChange"/>
                                    <Button Content="Add another…" MinWidth="104" Margin="8,0,0,0"
                                            Command="{Binding AddKeyCommand}"
                                            ToolTip="Give this command a second shortcut"/>
                                    <Button Content="Remove" MinWidth="80" Margin="8,0,0,0"
                                            Command="{Binding RemoveKeysCommand}"
                                            ToolTip="Leave this command with no shortcut (Del)"/>
                                    <Button Content="Reset" MinWidth="80" Margin="8,0,0,0"
                                            Command="{Binding ResetKeyCommand}"
                                            ToolTip="Put back the shortcut it ships with"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid VerticalAlignment="Center">
                                <!-- Listening: what was asked, heard, refused or found taken. -->
                                <TextBlock x:Name="RecorderLine" Text="{Binding RecorderText}" TextWrapping="Wrap"
                                           Visibility="{Binding ShowsRecorder, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.AutomationId="KeyboardRecorder"/>
                                <!-- At rest: which command the buttons act on. -->
                                <TextBlock TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Theme.Text.Secondary}"
                                           Visibility="{Binding ShowsRecorder, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding SelectedKeyRow.Name}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedKeyRow}" Value="{x:Null}">
                                                    <Setter Property="Text" Value="Select a command to change its shortcut."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="KeyList"
                             ItemsSource="{Binding KeyRows}"
                             SelectedItem="{Binding SelectedKeyRow, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="KeyList_KeyDown"
                             MouseDoubleClick="KeyList_DoubleClick"
                             AutomationProperties.AutomationId="SettingsKeyList"
                             AutomationProperties.Name="Commands and their shortcuts">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="10,5,10,5"/>
                                <Style.Triggers>
                                    <!-- A category heading is a label: it cannot be selected,
                                         arrowed onto or clicked. -->
                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="Padding" Value="10,12,10,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto" MinWidth="170"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="HeadingText" Grid.ColumnSpan="5" Text="{Binding Name}"
                                               FontSize="10.5" FontWeight="SemiBold" Visibility="Collapsed"
                                               TextOptions.TextFormattingMode="Ideal"
                                               Foreground="{StaticResource Theme.Text.Muted}"/>

                                    <Path x:Name="RowIcon" Style="{StaticResource IconPath}" Data="{Binding Icon}"
                                          HorizontalAlignment="Left" Width="15" Height="15"/>
                                    <TextBlock x:Name="RowName" Grid.Column="1" Text="{Binding Name}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <!-- Where the shortcut is live, when that is not simply "while
                                         the folders are showing" — the answer to "why did that key
                                         do nothing?". -->
                                    <TextBlock x:Name="RowWhere" Grid.Column="2" Text="{Binding Where}" FontSize="11"
                                               Opacity="0.62" VerticalAlignment="Center"/>

                                    <!-- Each shortcut as a key cap of its own, so two read as two. -->
                                    <ItemsControl x:Name="RowChords" Grid.Column="3" ItemsSource="{Binding Chords}"
                                                  VerticalAlignment="Center" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,0" Padding="6,1" CornerRadius="3"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}">
                                                    <TextBlock Text="{Binding}" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Changed from what it ships with. A dot rather than a word:
                                         the column is narrow and the tooltip says what Reset restores. -->
                                    <Ellipse x:Name="ChangedDot" Grid.Column="4" Width="7" Height="7"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Fill="{StaticResource Theme.Accent.Background}"
                                             ToolTip="{Binding DefaultText}" Visibility="Collapsed"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                        <Setter TargetName="HeadingText" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="RowIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="RowName" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="RowWhere" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="RowChords" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                        <Setter TargetName="ChangedDot" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!--
                  Context menu: the menu itself on the left, drawn the way it draws itself, and
                  everything that could be on it on the right. The preview is the whole truth of the
                  page — an entry is on the menu when it has a row there — so there are no tick boxes
                  to disagree with it (SettingsViewModel.ContextMenu). Its height is the viewport's
                  (see PageScroller's style), so the two columns scroll inside themselves and a drag
                  across can reach both ends of the menu.
                -->
                <DockPanel x:Name="ContextMenuPage" AutomationProperties.AutomationId="SettingsContextMenuPage">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.ContextMenu}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="Context menu"
                               Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- The menu -->
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Your menu" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Padding="10,3" Margin="0,0,6,0" Command="{Binding AddMenuSeparatorCommand}"
                                        AutomationProperties.AutomationId="AddMenuSeparator">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}"
                                              Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Separator"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Reset" Padding="12,3" Command="{Binding ResetMenuCommand}"
                                        ToolTip="BertBrowser's entries back in their original order, all on the menu"/>
                                <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Theme.Text.Muted}"
                                           Text="Alt+↑/↓ moves · Del removes"/>
                            </StackPanel>

                            <Border Background="{StaticResource Theme.Menu.Background}"
                                    BorderBrush="{StaticResource Theme.Menu.Border}" BorderThickness="1" Padding="2">
                                <ListBox x:Name="MenuLayoutList"
                                         AutomationProperties.AutomationId="MenuLayoutList"
                                         ItemsSource="{Binding MenuRows}"
                                         SelectedItem="{Binding SelectedMenuRow, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Theme.Menu.Foreground}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="MenuLayoutList_KeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Other programs' rows fade while the master switch
                                                     is off: kept in place, but not on the menu. -->
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Kind}" Value="Shell"/>
                                                                    <Condition Value="False"
                                                                               Binding="{Binding DataContext.ShowShellExtensions,
                                                                                         RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <!-- An entry, laid out like a menu item: icon, name,
                                                     gesture. The detail is the page's own note —
                                                     "file list only", "your command". -->
                                                <Grid Height="26"
                                                      Visibility="{Binding Kind, Converter={StaticResource EnumNotEqualsVisibility}, ConverterParameter=Separator}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- The grip is a label, not a handle: the whole
                                                         row is draggable. -->
                                                    <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Reorder}"
                                                          Width="10" Height="10" Margin="2,0,0,0" Opacity="0.45"
                                                          VerticalAlignment="Center"/>
                                                    <Path Grid.Column="1" Style="{StaticResource MenuIconPath}" Data="{Binding Icon}"
                                                          Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMore}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Muted}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11" Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Theme.Text.Muted}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Gesture}" Margin="12,0,4,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Theme.Menu.GestureForeground}"/>
                                                    <Button Grid.Column="5" Width="22" Height="22" Margin="2,0,0,0"
                                                            ToolTip="Take this off the menu (Del)"
                                                            AutomationProperties.Name="Remove from menu"
                                                            Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.RemoveMenuRowCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}"
                                                              Width="10" Height="10"/>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True"
                                                                                 Binding="{Binding IsMouseOver,
                                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Value="True"
                                                                                 Binding="{Binding IsSelected,
                                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>

                                                <!-- A separator, drawn as the menu draws one, with the
                                                     same × so it can be taken out like anything else. -->
                                                <Grid Height="14"
                                                      Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="1" Height="1" Margin="0,0,4,0" VerticalAlignment="Center"
                                                               Fill="{StaticResource Theme.Menu.Separator}"/>
                                                    <Button Grid.Column="2" Width="22" Height="14" Margin="2,0,0,0" Padding="0"
                                                            ToolTip="Remove this separator (Del)"
                                                            AutomationProperties.Name="Remove separator"
                                                            Command="{Binding DataContext.RemoveMenuRowCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}"
                                                              Width="9" Height="9"/>
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True"
                                                                                 Binding="{Binding IsMouseOver,
                                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Value="True"
                                                                                 Binding="{Binding IsSelected,
                                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </DockPanel>

                        <!-- What can go on it, in the three places entries come from. -->
                        <ScrollViewer x:Name="MenuChoicesScroller" Grid.Column="2"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <!-- Add or Remove, by whether the entry is on the menu. -->
                                <Style x:Key="MenuChoiceToggle" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                    <Setter Property="Padding" Value="8,2"/>
                                    <Setter Property="MinWidth" Value="64"/>
                                    <Setter Property="Content" Value="Add"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource Theme.Text.Link}"/>
                                    <Setter Property="ToolTip" Value="Put this on the menu"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInMenu}" Value="True">
                                            <Setter Property="Content" Value="Remove"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Muted}"/>
                                            <Setter Property="ToolTip" Value="Take this off the menu"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- A name on the menu already is quieter than one that could be added. -->
                                <Style x:Key="MenuChoiceName" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInMenu}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                                <DataTemplate x:Key="MenuChoiceRow">
                                    <Grid Height="28" Background="Transparent" Cursor="Hand"
                                          ToolTip="Drag onto the menu to put it exactly where you want">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Style="{StaticResource IconPath}" Data="{Binding Icon}"
                                              Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MenuChoiceName}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Margin="8,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Theme.Text.Muted}"/>
                                        <Button Grid.Column="3" Style="{StaticResource MenuChoiceToggle}" Cursor="Arrow"
                                                Command="{Binding DataContext.ToggleMenuChoiceCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ScrollViewer.Resources>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="BertBrowser" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="BuiltInChoiceList"
                                              AutomationProperties.AutomationId="BuiltInChoiceList"
                                              ItemsSource="{Binding BuiltInChoices}"
                                              ItemTemplate="{StaticResource MenuChoiceRow}"/>

                                <TextBlock Text="Windows shell extensions" FontWeight="SemiBold" Margin="0,20,0,4"/>
                                <CheckBox Content="Show entries added by other programs"
                                          IsChecked="{Binding ShowShellExtensions}"
                                          AutomationProperties.AutomationId="ShowShellExtensions"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4"
                                           Text="{Binding ShellExtensionsStatus}"
                                           Visibility="{Binding ShellExtensionsStatus, Converter={StaticResource NullToCollapsed}}"/>
                                <ItemsControl x:Name="ShellChoiceList"
                                              AutomationProperties.AutomationId="ShellChoiceList"
                                              ItemsSource="{Binding ShellChoices}"
                                              IsEnabled="{Binding ShowShellExtensions}"
                                              ItemTemplate="{StaticResource MenuChoiceRow}"/>

                                <TextBlock Text="Your commands" FontWeight="SemiBold" Margin="0,20,0,4"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                           Text="Programs of your own. In Arguments, {path}, {name} and {dir} expand per item — quote tokens that may contain spaces, e.g. &quot;{path}&quot;. Blank arguments default to the quoted full path."/>
                                <ListBox x:Name="CommandChoiceList"
                                         AutomationProperties.AutomationId="CommandChoiceList"
                                         ItemsSource="{Binding Commands}"
                                         SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewMouseWheel="NestedList_PreviewMouseWheel">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="28" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Width="14" Height="14"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                            <Setter Property="Data" Value="{StaticResource Icon.CustomCommand}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RunElevated}" Value="True">
                                                                    <Setter Property="Data" Value="{StaticResource Icon.Shield}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MenuChoiceName}"/>
                                                <Button Grid.Column="2" Style="{StaticResource MenuChoiceToggle}"
                                                        Command="{Binding DataContext.ToggleMenuChoiceCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Padding="10,3" Margin="0,0,6,0" Command="{Binding NewCustomCommandCommand}"
                                            AutomationProperties.AutomationId="NewCustomCommand">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}"
                                                  Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="New command"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Delete" Padding="12,3" Command="{Binding DeleteCustomCommandCommand}"
                                            ToolTip="Delete the selected command"/>
                                </StackPanel>

                                <!-- Editor for the selected command, whichever column it was selected in. -->
                                <Grid x:Name="CommandEditor" Margin="0,14,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCommand}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.AutomationId="CommandName"
                                             Text="{Binding SelectedCommand.Name, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Program:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,8"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding SelectedCommand.Command, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="…" Width="28" Margin="0,0,0,8"
                                            ToolTip="Browse for a program" Click="Browse_Click"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                             VerticalContentAlignment="Center"
                                             ToolTip="{}{path} = full path, {name} = file name, {dir} = parent directory"
                                             Text="{Binding SelectedCommand.Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <CheckBox Content="Show for files" IsChecked="{Binding SelectedCommand.AppliesToFiles}"
                                                  Margin="0,0,16,0"/>
                                        <CheckBox Content="Show for folders" IsChecked="{Binding SelectedCommand.AppliesToDirectories}"/>
                                    </StackPanel>

                                    <!-- Its own row rather than beside the "show for" pair: those two say
                                         where the command appears, this one says what it can do. -->
                                    <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              Content="Run as administrator"
                                              ToolTip="Windows asks for confirmation each time this command runs."
                                              IsChecked="{Binding SelectedCommand.RunElevated}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
