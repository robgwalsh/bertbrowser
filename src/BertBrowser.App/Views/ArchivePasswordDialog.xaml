<v:ThemedWindow x:Class="BertBrowser.App.Views.ArchivePasswordDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Title="Password" Width="440" SizeToContent="Height" MinHeight="170"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Unlock" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- A PasswordBox, never a TextBox: this is the one input in the app whose contents
                 must not be readable over a shoulder, and it is also why nothing here is kept
                 anywhere but memory for the life of the process. -->
            <PasswordBox x:Name="PasswordEntry" PasswordChanged="Password_Changed"/>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Text.Secondary}"
                       Text="Remembered until BertBrowser closes, and never written to disk."/>

            <TextBlock x:Name="ProblemText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Error.Foreground}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</v:ThemedWindow>
