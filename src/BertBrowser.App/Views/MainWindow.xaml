<v:ThemedWindow x:Class="BertBrowser.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
        xmlns:v="clr-namespace:BertBrowser.App.Views"
        Title="BertBrowser" Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        ShowsAppIcon="True"
        Background="{StaticResource Theme.Window.Background}"
        TextElement.Foreground="{StaticResource Theme.Text.Primary}"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Back" Command="{Binding ActiveTab.BackCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding ActiveTab.BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ActiveTab.ForwardCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding ActiveTab.UpCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ActiveTab.RefreshCommand}"/>
        <!-- Ctrl+Z, Ctrl+Y, Ctrl+Shift+Z and Ctrl+Alt+Z (the undo history) are handled in
             code-behind, not bound here: a window-level binding would take them away from the
             search and path boxes, where they must still undo and redo typing. Ctrl+C/X/V and
             Alt+Enter likewise belong to whichever pane has focus, so they live in DirectoryTabView. -->

        <!-- Tabs. Routed through ActivePane, so they act on the pane the user is working in. -->
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ActivePane.NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding ActivePane.CloseTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding ActivePane.NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding ActivePane.PreviousTabCommand}"/>
        <!-- The parameter is a string because that is all KeyBinding supplies; "8" means "last". -->
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="8"/>

        <!-- Panes. Ctrl+Alt+arrow rather than Ctrl+Shift+arrow, which extends a list selection.
             Plain Tab stays WPF's focus traversal — it has to keep working inside the search and
             path boxes — so pane cycling is F6. -->
        <KeyBinding Key="Right" Modifiers="Ctrl+Alt" Command="{Binding ActivePane.SplitVerticalCommand}"/>
        <KeyBinding Key="Down" Modifiers="Ctrl+Alt" Command="{Binding ActivePane.SplitHorizontalCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl+Shift" Command="{Binding ActivePane.ClosePaneCommand}"/>
        <KeyBinding Key="F6" Command="{Binding FocusNextPaneCommand}"/>
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding FocusPreviousPaneCommand}"/>

        <!-- Disk usage. Safe as a window binding rather than a guarded PreviewKeyDown: it cannot
             collide with typing the way Ctrl+F or Ctrl+Z can. -->
        <KeyBinding Key="D" Modifiers="Ctrl+Shift" Command="{Binding AnalyseDiskUsageCommand}"/>

        <!-- Duplicates. Same reasoning as Ctrl+Shift+D above; U because D is taken. -->
        <KeyBinding Key="U" Modifiers="Ctrl+Shift" Command="{Binding FindDuplicatesCommand}"/>

        <!-- What changed. Same reasoning again; H for history. -->
        <KeyBinding Key="H" Modifiers="Ctrl+Shift" Command="{Binding ShowChangesCommand}"/>

        <!-- Compare this pane with the one beside it, and press it again to stop. F7 because that
             is where every other two-pane file manager puts it, and a bare function key is safe for
             the same reason Ctrl+Shift+D is. -->
        <KeyBinding Key="F7" Command="{Binding CompareWithOtherPaneCommand}"/>

        <!-- Reopen the last tab closed in this pane. -->
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ActivePane.ReopenClosedTabCommand}"/>

        <!-- The preview pane, for the tab that has focus. Safe here for the same reason
             Ctrl+Shift+D is: P is not a text-editing key, so it cannot be taken away from the
             search or path box. Explorer's Alt+P is handled in code-behind instead, because an
             Alt chord arrives as Key.System with the real key in SystemKey. -->
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding ActiveTab.TogglePreviewCommand}"/>

        <!-- The flat branch view. Ctrl+B is what Directory Opus, XYplorer, Total Commander and
             Double Commander all bind this to, so it is the one gesture somebody arriving from
             another file manager already knows. Safe here for the reason Ctrl+P is: B is not a
             text-editing key, so it cannot be taken away from the search or path box. -->
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ActiveTab.ToggleFlatCommand}"/>
    </Window.InputBindings>

    <!--
      The window-wide toolbar lives in the title bar rather than in a strip of its own: the address
      bar, search box, progress and error banner are all per directory now and live inside each
      pane's DirectoryTabView. Back/Forward/Up/Refresh moved into that same per-tab row too — see
      DirectoryTabView.xaml — since two panes each need their own navigation, not one that silently
      acts on whichever pane is active. The KeyBindings above still route through ActiveTab.*Command
      and are unaffected.
    -->
    <v:ThemedWindow.TitleBarContent>
        <DockPanel Margin="12,0,4,0" TextElement.Foreground="{StaticResource Theme.TitleBar.Foreground}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <!--
                  Undo and Redo, each a split button in the shape every editor's are: the face takes
                  one step, the chevron lists the history so a click can go back several at once.
                  The tooltip says what the face would do, so nobody undoes blind.
                -->
                <Button Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" Padding="8,4,4,4"
                        ToolTip="{Binding UndoDescription}" ToolTipService.ShowOnDisabled="False"
                        Command="{Binding UndoCommand}"
                        AutomationProperties.Name="Undo">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/>
                </Button>
                <Button x:Name="UndoMenuButton" Style="{StaticResource ToolbarButton}" Margin="0" Padding="2,4"
                        MinWidth="14" ToolTip="Undo history" Click="UndoMenu_Click"
                        AutomationProperties.Name="Undo history">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10"/>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Margin="4,0,0,0" Padding="8,4,4,4"
                        ToolTip="{Binding RedoDescription}" ToolTipService.ShowOnDisabled="False"
                        Command="{Binding RedoCommand}"
                        AutomationProperties.Name="Redo">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/>
                </Button>
                <Button x:Name="RedoMenuButton" Style="{StaticResource ToolbarButton}" Margin="0,0,10,0" Padding="2,4"
                        MinWidth="14" ToolTip="Redo history" Click="RedoMenu_Click"
                        AutomationProperties.Name="Redo history">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10"/>
                </Button>

                <!-- "Show hidden items" lives in the Settings dialog only; it is a preference
                     you set once, not something the caption strip needs a button for. -->
                <Button Style="{StaticResource ToolbarButton}"
                        ToolTip="Disk usage treemaps (Ctrl+Shift+D)"
                        Command="{Binding AnalyseDiskUsageCommand}"
                        AutomationProperties.Name="Disk usage">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.DiskUsage}"/>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        ToolTip="Find duplicate files (Ctrl+Shift+U)"
                        Command="{Binding FindDuplicatesCommand}"
                        AutomationProperties.Name="Duplicates">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Duplicates}"/>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        ToolTip="Recent file changes (Ctrl+Shift+H)"
                        Command="{Binding ShowChangesCommand}"
                        AutomationProperties.Name="What changed">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Changes}"/>
                </Button>

                <Button x:Name="CompareButton" Style="{StaticResource ToolbarButton}"
                        ToolTip="Compare this pane with the one beside it (F7)"
                        Command="{Binding CompareWithOtherPaneCommand}"
                        AutomationProperties.Name="Compare folders">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Compare}"/>
                </Button>

                <Button Style="{StaticResource ToolbarButton}"
                        ToolTip="Settings"
                        Click="Settings_Click">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Settings}"/>
                </Button>
            </StackPanel>

            <!--
              The workspace switcher, when Settings puts it here rather than in the sidebar. Docked
              left, so it sits just after the name and version the window template draws before
              this content, and the search box keeps centring itself in what is left. Named after
              the workspace the window last came from, or plain "Workspaces" before there is one.
            -->
            <Button x:Name="WorkspaceSwitcher" DockPanel.Dock="Left" Margin="2,0,12,0"
                    VerticalAlignment="Center" MaxWidth="220"
                    Style="{StaticResource HeaderDropdownButton}"
                    Click="WorkspaceSwitcher_Click"
                    ToolTip="Switch workspace"
                    Visibility="{Binding ShowWorkspacesInTitleBar, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="WorkspaceSwitcher"
                    AutomationProperties.Name="Workspaces">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.SplitRight}" Width="13" Height="13" Margin="0,0,7,0"
                          VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                    <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Margin="8,1,0,0"
                          VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding CurrentWorkspaceName}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentWorkspaceName}" Value="{x:Null}">
                                        <Setter Property="Text" Value="Workspaces"/>
                                        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Button>

            <!-- Saved searches, likewise, when Settings puts them here. After the workspaces so the
                 two sit side by side when both are up here. Always labelled the same: unlike a
                 workspace, running a search does not make it "where the window is". -->
            <Button x:Name="SavedSearchSwitcher" DockPanel.Dock="Left" Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource HeaderDropdownButton}"
                    Click="SavedSearchSwitcher_Click"
                    ToolTip="Run a saved search"
                    Visibility="{Binding ShowSavedSearchesInTitleBar, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="SavedSearchSwitcher"
                    AutomationProperties.Name="Saved searches">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="0,0,7,0"
                          VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                    <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}"
                          Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Margin="8,1,0,0"
                          VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                    <TextBlock Text="Saved searches" VerticalAlignment="Center"
                               Foreground="{StaticResource Theme.Text.Secondary}"/>
                </DockPanel>
            </Button>

            <!--
              Whole-PC search. It lives up here, once per window, because the per-tab box below
              is folder-local only now — one box, one scope, nothing to choose before typing.
              It is always open: it used to fold into a magnifier button, which saved a little
              caption strip and cost a click before every search, in the one place a file
              browser is most often reached for. The query itself belongs to the active tab,
              since that is the list the hits appear in. Centered in the title bar's remaining
              space — the last, undocked child, so DockPanel hands it that whole span and its own
              HorizontalAlignment centers it rather than stretching it edge to edge.
            -->
            <StackPanel x:Name="GlobalSearchGroup" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Style="{StaticResource HeaderFieldBorder}" Width="300">
                        <DockPanel>
                            <Path Style="{StaticResource IconPath}" DockPanel.Dock="Left"
                                       Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="8,0,6,0"
                                       VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                            <Button DockPanel.Dock="Right" ToolTip="Clear search (Esc)"
                                    Command="{Binding ActiveTab.ClearSearchCommand}"
                                    Style="{StaticResource GlobalSearchClearButton}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}" Width="12" Height="12"/>
                            </Button>
                            <!-- Keep this search under a name; shown and hidden with the ✕. -->
                            <Button DockPanel.Dock="Right" ToolTip="Save this search…"
                                    Click="SaveGlobalSearch_Click"
                                    AutomationProperties.AutomationId="SaveGlobalSearchButton"
                                    AutomationProperties.Name="Save this search"
                                    Style="{StaticResource GlobalSearchClearButton}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Width="12" Height="12"/>
                            </Button>
                            <!--
                              UseLayoutRounding="False" here and on the TextBox/TextBlock below: at
                              200% (and other non-100%) display scaling, WPF independently snaps each
                              nested element's Padding/Margin to the device-pixel grid, and the
                              TextBox's template nests more of them (Border, ScrollViewer,
                              TextBoxView) than the plain placeholder TextBlock does — so their
                              rounding errors accumulate differently and the caret/typed text lands a
                              character past where the placeholder sits. Turning rounding off makes
                              both use the same exact (unsnapped) DIP math instead.
                            -->
                            <Grid UseLayoutRounding="False">
                                <TextBox x:Name="GlobalSearchBox" BorderThickness="0" Background="Transparent"
                                         UseLayoutRounding="False" VerticalContentAlignment="Center"
                                         Foreground="{StaticResource Theme.Text.Primary}"
                                         AutomationProperties.AutomationId="GlobalSearchBox"
                                         AutomationProperties.Name="Search this PC"
                                         Text="{Binding ActiveTab.GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="GlobalSearchBox_KeyDown"
                                         ToolTip="Search every indexed drive (Ctrl+Shift+F)"/>
                                <TextBlock Text="Search this PC" Foreground="{StaticResource Theme.Text.Placeholder}"
                                           UseLayoutRounding="False"
                                           Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveTab.GlobalSearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                <!-- The syntax reference, to the right of the field it explains. A button rather
                     than the tooltip alone, because the filter list outgrew the shape of a
                     tooltip: this one can be scrolled, and kept open while the query is typed. -->
                <Button Style="{StaticResource ToolbarButton}"
                        Click="SearchSyntax_Click"
                        AutomationProperties.AutomationId="SearchSyntaxButton"
                        AutomationProperties.Name="Search syntax"
                        ToolTip="What you can type here">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Properties}"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </v:ThemedWindow.TitleBarContent>

    <!-- Settings replaces everything below the title bar, not a dialog over it (ShowSettings). The
         folders are Hidden rather than Collapsed while it is up, so panes keep their layout and
         scroll positions for the way back. -->
    <Grid>
    <DockPanel x:Name="BrowserRoot">
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding ActiveTab.StatusText}"/>
            </StatusBarItem>
            <!-- Sticks around after a move or a rename so the way back stays visible once the
                 result message has been replaced by something else. A link to the whole history,
                 since that is where the rest of the way back is. -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding UndoDescription, Converter={StaticResource NullToCollapsed}}">
                <Button Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                        Click="UndoHistoryLink_Click"
                        ToolTip="Show the undo history (Ctrl+Alt+Z)"
                        AutomationProperties.AutomationId="StatusUndo">
                    <TextBlock Text="{Binding UndoDescription}" Foreground="{StaticResource Theme.Text.Link}"/>
                </Button>
            </StatusBarItem>
            <!-- Current file-list selection (blank when nothing is selected). -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding ActiveTab.SelectionSummary, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ActiveTab.SelectionSummary}" Foreground="{StaticResource Theme.Text.Secondary}" Margin="10,0,0,0"/>
            </StatusBarItem>
            <!-- A running transfer: how far through it is in bytes, how fast, how long is left, and
                 the way out of it. Bound to the nullable view model rather than to IsTransferring so
                 the same strip can be posed for a capture without a transfer actually running.
                 The bar is determinate only when the size index could total the plan; otherwise it
                 is indeterminate beside a throughput figure, because a determinate bar pinned at 0%
                 reads as a stall rather than as an unmeasured volume. -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding TransferProgress, Converter={StaticResource NullToCollapsed}}">
                <!-- Every binding names TransferProgress in full rather than the panel switching
                     DataContext to it once with `DataContext="{Binding TransferProgress}"`. That
                     form binds the DataContext against the DataContext it is setting, which is a
                     trap worth staying out of on a panel whose every sibling here binds to the
                     shell. -->
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="80" Margin="10,0,8,0" VerticalAlignment="Center"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding TransferProgress.Fraction, Mode=OneWay}"
                                 IsIndeterminate="{Binding TransferProgress.IsIndeterminate}"
                                 Focusable="False" IsHitTestVisible="False"/>
                    <!-- StatusBar tokens, not Theme.Text.*: this strip is the accent colour, and the
                         contrast suite covers these against it. -->
                    <TextBlock Text="{Binding TransferProgress.Headline}" MaxWidth="340"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Theme.StatusBar.Foreground}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TransferProgress.DetailText}" Margin="10,0,0,0"
                               Foreground="{StaticResource Theme.StatusBar.Foreground}" Opacity="0.8"
                               VerticalAlignment="Center"/>
                    <!-- How many more are queued behind this one. Blank rather than "0 waiting" when
                         there is only the running job, so the strip carries no separator with
                         nothing after it. -->
                    <TextBlock Text="{Binding TransferQueue.WaitingText}" Margin="10,0,0,0"
                               Foreground="{StaticResource Theme.StatusBar.Foreground}" Opacity="0.8"
                               VerticalAlignment="Center"/>
                    <!-- Pause and Resume are one slot: only ever one of them applies, and a run that
                         is not queued (a sync hosts its own progress) offers neither. -->
                    <Button Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                            Foreground="{StaticResource Theme.StatusBar.Foreground}"
                            Content="Pause" VerticalAlignment="Center"
                            ToolTip="Hold this transfer where it is. Nothing else can be moved, renamed or deleted while it is paused."
                            Command="{Binding TransferQueue.PauseCommand}"
                            Visibility="{Binding TransferQueue.IsPaused, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <Button Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                            Foreground="{StaticResource Theme.StatusBar.Foreground}"
                            Content="Resume" FontWeight="SemiBold" VerticalAlignment="Center"
                            ToolTip="Carry on from where it stopped"
                            Command="{Binding TransferQueue.ResumeCommand}"
                            Visibility="{Binding TransferQueue.IsPaused, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                            Foreground="{StaticResource Theme.StatusBar.Foreground}"
                            Content="Details" VerticalAlignment="Center"
                            ToolTip="Show every item in this transfer, and everything queued behind it"
                            Click="TransferDetails_Click"/>
                    <Button Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                            Foreground="{StaticResource Theme.StatusBar.Foreground}"
                            Content="Cancel" FontWeight="SemiBold" VerticalAlignment="Center"
                            ToolTip="Stop this transfer. Whatever has already been transferred stays, and can be undone."
                            Command="{Binding TransferProgress.CancelCommand}"/>
                </StackPanel>
            </StatusBarItem>
            <!-- Background MFT indexing progress (blank when idle), or why there is no index.
                 When the reason is one the user can act on — a declined elevation prompt, a helper
                 that died — the same text becomes a button that asks again. Nothing retries on a
                 timer: every retry is a UAC prompt. -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding IndexingStatus, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Orientation="Horizontal">
                    <!-- StatusBar tokens, not Theme.Text.Link: the link colour is chosen to read
                         against the body background, and this strip is the accent colour. The
                         contrast suite covers these two against it. -->
                    <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Indexing}"
                               Fill="{StaticResource Theme.StatusBar.Foreground}" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IndexingStatus}" Foreground="{StaticResource Theme.StatusBar.Foreground}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IndexingCanRetry}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Style="{StaticResource LinkButton}"
                            Foreground="{StaticResource Theme.StatusBar.Foreground}"
                            Command="{Binding RetryIndexingCommand}"
                            ToolTip="Ask for administrator rights again so drives can be indexed"
                            VerticalAlignment="Center"
                            Visibility="{Binding IndexingCanRetry, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock>
                            <Run Text="{Binding IndexingStatus, Mode=OneWay}"/><Run Text="  Try again"
                                 FontWeight="SemiBold"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <!-- Thumbnail size: min = details list, dragging right grows thumbnails. -->
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" ToolTip="Thumbnail size — drag left for the details list">
                    <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.DetailsList}"
                               Margin="0,0,6,0" Fill="{StaticResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                    <Slider x:Name="ThumbSlider" Width="130" Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            Value="{Binding ActiveTab.FileList.ThumbnailScale, Mode=TwoWay}"
                            AutomationProperties.Name="Thumbnail size"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- The offer to start the index helper, when none is running.
             Declared AFTER the status bar on purpose: a DockPanel gives the first-declared
             Dock="Bottom" child the true bottom edge, so this sits *above* the accent strip.
             Swapping the two would bury the status bar under it.

             Neutral surface tokens rather than Theme.Warning.*, also on purpose: nothing is wrong
             here. The app works, search falls back to a crawl, and this is an offer rather than a
             problem — colouring it as a warning would make every launch look like a failure.

             Whether it appears at all is IndexerBannerRules, in Core, and ShowIndexerBanner is a
             plain bool: a binding path through a null intermediate *fails* rather than yielding
             null, the converter never runs, and Visibility falls back to Visible — see the compare
             banner below for the strip that taught us that. -->
        <Border DockPanel.Dock="Bottom" Padding="10,7"
                Background="{StaticResource Theme.Surface.Raised}"
                BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowIndexerBanner, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="IndexerBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource LinkButton}"
                        ToolTip="Hide this until the next time BertBrowser starts"
                        Command="{Binding DismissIndexerBannerCommand}"
                        AutomationProperties.AutomationId="IndexerBannerDismiss"/>
                <Button DockPanel.Dock="Right" MinWidth="110" Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        ToolTip="Ask for administrator rights so drives can be indexed"
                        Command="{Binding StartIndexerCommand}"
                        Visibility="{Binding IndexerBannerCanStart, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="IndexerBannerStart">
                    <StackPanel Orientation="Horizontal">
                        <!-- The shield says this raises a UAC prompt, the same as everywhere else
                             in the app that asks for administrator rights. -->
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12"
                              Data="{StaticResource Icon.Shield}" Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Start indexer" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Width="14" Height="14"
                      Data="{StaticResource Icon.Indexing}" Margin="2,0,8,0"
                      Fill="{StaticResource Theme.Text.Secondary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding IndexerBannerMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar: drives/devices (top, fills rest) + saved searches + bookmarks (below, only as tall as needed) -->
            <Grid Grid.Column="0" Background="{StaticResource Theme.Surface.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Saved searches (between the drives and the bookmarks; sized to content).
                     A click runs one in the active tab; the menu has the rest. Only here when
                     Settings has not moved them to the title bar or hidden them. -->
                <DockPanel Grid.Row="1"
                           Visibility="{Binding ShowSavedSearchesInSidebar, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,1,0,0">
                        <TextBlock Text="SAVED SEARCHES" Style="{StaticResource SidebarHeader}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="10,0,10,8" Foreground="{StaticResource Theme.Text.Muted}" FontSize="11"
                               TextWrapping="Wrap" Text="Save a search from the search box to keep it here."
                               AutomationProperties.AutomationId="SavedSearchEmptyText"
                               Visibility="{Binding SavedSearches.HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SavedSearches.HasItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SavedSearches.Items}" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="SavedSearchList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SsRow" Background="Transparent" Padding="10,4"
                                            MouseUp="SavedSearchRow_MouseUp"
                                            ToolTip="{Binding ToolTip}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Run" Click="SavedSearchRun_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Search}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Run in new tab" Click="SavedSearchRunInNewTab_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.OpenInNewTab}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Edit…" Click="SavedSearchEdit_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Rename}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Delete" Click="SavedSearchDelete_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Delete}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                                  Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="1,0,8,0"
                                                  VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ScopeText}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" FontSize="11" MaxWidth="90"
                                                       Foreground="{StaticResource Theme.Text.Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="SsRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SsRow" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Workspaces (between the saved searches and the bookmarks; sized to content).
                     A click switches to one, replacing the current panes/tabs; the menu has the
                     rest. There's no per-tab save equivalent — a workspace is a whole-window
                     snapshot — so the save trigger sits in the header itself. Only here when
                     Settings has not moved the switcher to the title bar or hidden it. -->
                <DockPanel Grid.Row="2"
                           Visibility="{Binding ShowWorkspacesInSidebar, Converter={StaticResource BoolToVisibility}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="0,4,8,0" VerticalAlignment="Center"
                                    Width="21" Height="21" Padding="4"
                                    Style="{StaticResource ToolbarButton}"
                                    ToolTip="Save the current layout as a workspace"
                                    Click="SaveWorkspace_Click"
                                    AutomationProperties.AutomationId="SaveWorkspace"
                                    AutomationProperties.Name="Save workspace">
                                <Path Style="{StaticResource IconPath}" Width="13" Height="13" Data="{StaticResource Icon.Add}"/>
                            </Button>
                            <TextBlock Text="WORKSPACES" Style="{StaticResource SidebarHeader}"/>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="10,0,10,8" Foreground="{StaticResource Theme.Text.Muted}" FontSize="11"
                               TextWrapping="Wrap" Text="Save the current panes and tabs here, to switch back to them by name."
                               AutomationProperties.AutomationId="SavedWorkspaceEmptyText"
                               Visibility="{Binding SavedWorkspaces.HasItems, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding SavedWorkspaces.HasItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding SavedWorkspaces.Items}" Margin="0,0,0,6"
                                      AutomationProperties.AutomationId="SavedWorkspaceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="WsRow" Background="Transparent" Padding="10,4"
                                            MouseUp="WorkspaceRow_MouseUp"
                                            ToolTip="{Binding ToolTip}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Switch to" Click="WorkspaceSwitch_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.SplitRight}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Rename…" Click="WorkspaceRename_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Rename}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Delete" Click="WorkspaceDelete_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Delete}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                                  Data="{StaticResource Icon.SplitRight}" Width="13" Height="13" Margin="1,0,8,0"
                                                  VerticalAlignment="Center" Fill="{StaticResource Theme.Text.Secondary}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="WsRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="WsRow" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Bookmarks (below the saved searches; sized to content) -->
                <DockPanel Grid.Row="3">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,1,0,0">
                        <TextBlock Text="BOOKMARKS" Style="{StaticResource SidebarHeader}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="10,0,10,8" Foreground="{StaticResource Theme.Text.Muted}" FontSize="11"
                               TextWrapping="Wrap" Text="Right-click a file or folder to bookmark it."
                               Visibility="{Binding Bookmarks.HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Bookmarks.HasBookmarks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Bookmarks.Items}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="BmRow" Background="Transparent" Padding="10,4"
                                            MouseLeftButtonUp="BookmarkRow_MouseUp" ToolTip="{Binding FullPath}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open in new tab" Click="BookmarkOpenInNewTab_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.OpenInNewTab}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Tag="open-new-pane" Header="Open in new pane">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.OpenInNewPane}"/></MenuItem.Icon>
                                                    <MenuItem Header="To the right" Click="BookmarkOpenInPaneRight_Click"/>
                                                    <MenuItem Header="Below" Click="BookmarkOpenInPaneBelow_Click"/>
                                                </MenuItem>
                                                <MenuItem Header="Open" Click="BookmarkOpen_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Open}"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Remove bookmark" Click="BookmarkRemove_Click">
                                                    <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Delete}"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Opacity="{Binding IconOpacity}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="BmRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BmRow" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Drives, devices and their folders: a tree filling the sidebar above the other
                     sections, under the same kind of header they have (no rule above it: it is
                     the first thing in the sidebar). -->
            <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="DRIVES" Style="{StaticResource SidebarHeader}"/>
            <!-- Padding's right edge is the scrollbar gutter SidebarTreeStyle draws the bar into;
                 it must match the ScrollBar style's 12px width. -->
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Tree.Roots}" BorderThickness="0"
                      Background="{StaticResource Theme.Surface.Background}" Padding="0,0,12,0"
                      Style="{StaticResource SidebarTreeStyle}"
                      ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="False"
                      Loaded="FolderTree_Loaded"
                      MouseDoubleClick="FolderTree_DoubleClick"
                      PreviewMouseWheel="Scroll_PreviewMouseWheel"
                      ContextMenuOpening="FolderTree_ContextMenuOpening">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <!-- Laid out by ContextMenuComposer, in the order the file list's menu uses. -->
                        <MenuItem x:Name="TreeNewMenuItem" Tag="new" Header="New">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Add}"/></MenuItem.Icon>
                            <MenuItem Header="Folder" Click="TreeNewFolder_Click">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.NewFolder}"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- The configured file types are built here at ContextMenuOpening. -->
                            <Separator x:Name="TreeNewFileTypesSeparator"/>
                            <Separator/>
                            <MenuItem Header="Empty file…" Click="TreeNewEmptyFile_Click">
                                <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.NewFile}"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Tag="open-new-tab" Header="Open in new tab" Click="TreeOpenInNewTab_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.OpenInNewTab}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="open-new-pane" Header="Open in new pane">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.OpenInNewPane}"/></MenuItem.Icon>
                            <MenuItem Header="To the right" Click="TreeOpenInPaneRight_Click"/>
                            <MenuItem Header="Below" Click="TreeOpenInPaneBelow_Click"/>
                        </MenuItem>
                        <MenuItem Tag="open-terminal" Header="Open in Terminal" Click="TreeOpenTerminal_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Terminal}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="open-vscode" Header="Open in VS Code" Click="TreeOpenVSCode_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.VSCode}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="TreeBookmarkMenuItem" Tag="bookmark" Header="Bookmark" Click="TreeBookmark_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Bookmark}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="TreeDeleteMenuItem" Tag="delete" Header="Delete…" Click="TreeDelete_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Delete}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="copy-path" Header="Copy as path" Click="TreeCopyPath_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Copy}"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Right-clicking a drive here is the gesture this feature exists for. -->
                        <MenuItem Tag="disk-usage" Header="Analyse disk usage…" Click="TreeDiskUsage_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.DiskUsage}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="duplicates" Header="Find duplicates…" Click="TreeDuplicates_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Duplicates}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="changes" Header="What changed here…" Click="TreeChanges_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Changes}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Tag="properties" Header="Properties…" Click="TreeProperties_Click">
                            <MenuItem.Icon><Path Style="{StaticResource MenuIconPath}" Data="{StaticResource Icon.Properties}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <DockPanel Background="Transparent"
                                   PreviewMouseLeftButtonDown="FolderTreeItem_PreviewMouseDown"
                                   PreviewMouseDown="FolderTreeItem_PreviewMiddleClick">
                            <Image x:Name="RowIcon" DockPanel.Dock="Left" Source="{Binding Icon}"
                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Opacity="{Binding IconOpacity}"/>
                            <!-- Docked right so it keeps its space and the name is what trims.
                                 Dimmed by opacity rather than a muted brush: that way it stays
                                 legible against a selected row, whose foreground it inherits. -->
                            <TextBlock x:Name="RowSize" DockPanel.Dock="Right" Text="{Binding SizeText}"
                                       Margin="8,0,2,0" VerticalAlignment="Center"
                                       FontSize="10.5" Opacity="0.65"/>
                            <TextBlock x:Name="RowName" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>

            <!-- Panes. Built in code: the arrangement is a tree of grids and splitters, which
                 XAML cannot express declaratively (ColumnDefinitions are not bindable). -->
            <!--
              The panes, with the compare banner above them.

              The banner sits here rather than inside a pane because a comparison is one thing
              spanning two of them: put in a pane it would have to appear twice and say the same
              thing, and neither copy could own the End button.
            -->
            <DockPanel Grid.Column="2">
                <!--
                  One container for both banners, with the only visibility binding that decides
                  whether either is there.

                  It is a wrapper rather than two sibling banners because of what the caveat's own
                  binding does when there is no comparison: the path CompareSession.Message cannot
                  resolve through a null, so the binding *fails* rather than producing null, the
                  converter is never called, and Visibility falls back to its default — Visible. An
                  empty warning-coloured strip then sits above the panes for the whole session. The
                  binding below is on a path that always resolves, and the inner ones only run when
                  there is something for them to read.
                -->
                <StackPanel x:Name="CompareBanner" DockPanel.Dock="Top"
                            Visibility="{Binding CompareSession, Converter={StaticResource NullToCollapsed}}">
                <Border Padding="8,5"
                        Background="{StaticResource Theme.Surface.Raised}"
                        BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                              Data="{StaticResource Icon.Compare}" Margin="2,0,8,0"/>

                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="12,0,2,0"
                                Content="End" ToolTip="Stop comparing and clear the colours"
                                Command="{Binding CompareSession.EndByRequestCommand}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                Content="Rescan" ToolTip="Read both folders again"
                                Command="{Binding CompareSession.RescanCommand}"/>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" MinWidth="90"
                                Content="Sync →" ToolTip="Make the right side match the left"
                                Command="{Binding CompareSession.SyncCommand}"/>
                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Content="Only differences"
                                  IsChecked="{Binding CompareSession.DifferencesOnly}"/>

                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CompareSession.Summary, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Said separately from the summary: a caveat changes what the numbers beside it
                     are worth, and running the two together reads as one sentence. FallbackValue
                     because an unresolvable path leaves Visibility at Visible, not Collapsed. -->
                <Border Padding="8,4"
                        Background="{StaticResource Theme.Warning.Background}"
                        Visibility="{Binding CompareSession.Message, FallbackValue=Collapsed,
                                             Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding CompareSession.Message}" TextWrapping="Wrap"
                               Foreground="{StaticResource Theme.Warning.Foreground}"/>
                </Border>
                </StackPanel>

                <Border x:Name="PaneHostSite"/>
            </DockPanel>
        </Grid>
    </DockPanel>
    <ContentControl x:Name="SettingsHost" Focusable="False" IsTabStop="False"/>
    </Grid>
</v:ThemedWindow>
