<Window x:Class="BertBrowser.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
        xmlns:v="clr-namespace:BertBrowser.App.Views"
        Title="BertBrowser" Width="1200" Height="750"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Back" Command="{Binding ActiveTab.BackCommand}"/>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding ActiveTab.BackCommand}"/>
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding ActiveTab.ForwardCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding ActiveTab.UpCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ActiveTab.RefreshCommand}"/>
        <!-- Ctrl+Z is handled in code-behind, not bound here: a window-level binding would take it
             away from the search and path boxes, where it must still undo typing. Ctrl+C/X/V and
             Alt+Enter likewise belong to whichever pane has focus, so they live in DirectoryTabView. -->

        <!-- Tabs. Routed through ActivePane, so they act on the pane the user is working in. -->
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ActivePane.NewTabCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding ActivePane.CloseTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding ActivePane.NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding ActivePane.PreviousTabCommand}"/>
        <!-- The parameter is a string because that is all KeyBinding supplies; "8" means "last". -->
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="6"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="7"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding ActivePane.ActivateTabAtCommand}" CommandParameter="8"/>

        <!-- Panes. Ctrl+Alt+arrow rather than Ctrl+Shift+arrow, which extends a list selection.
             Plain Tab stays WPF's focus traversal — it has to keep working inside the search and
             path boxes — so pane cycling is F6. -->
        <KeyBinding Key="Right" Modifiers="Ctrl+Alt" Command="{Binding ActivePane.SplitVerticalCommand}"/>
        <KeyBinding Key="Down" Modifiers="Ctrl+Alt" Command="{Binding ActivePane.SplitHorizontalCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl+Shift" Command="{Binding ActivePane.ClosePaneCommand}"/>
        <KeyBinding Key="F6" Command="{Binding FocusNextPaneCommand}"/>
        <KeyBinding Key="F6" Modifiers="Shift" Command="{Binding FocusPreviousPaneCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Header: window-wide toolbar only. The address bar, search box, progress and error
             banner are per directory now, and live inside each pane's DirectoryTabView. Navigation
             stays here and acts on the active pane. -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <DockPanel Margin="6,4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarButton}" ToolTip="Back (Alt+Left)"
                            Command="{Binding ActiveTab.BackCommand}">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72B;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" ToolTip="Forward (Alt+Right)"
                            Command="{Binding ActiveTab.ForwardCommand}">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72A;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" ToolTip="Up (Alt+Up)"
                            Command="{Binding ActiveTab.UpCommand}">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE74A;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" ToolTip="Refresh (F5)"
                            Command="{Binding ActiveTab.RefreshCommand}">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE72C;"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <ToggleButton Padding="8,4" Margin="2,0" MinWidth="28"
                                  IsChecked="{Binding ShowHiddenItems}"
                                  AutomationProperties.AutomationId="ShowHiddenToggle"
                                  AutomationProperties.Name="Show hidden items"
                                  ToolTip="Show hidden files and folders">
                        <TextBlock>
                            <TextBlock.Style>
                                <!-- Eye when showing hidden items, eye-with-slash when not. -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ToolbarIcon}">
                                    <Setter Property="Text" Value="&#xED1A;"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                     Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                            <Setter Property="Text" Value="&#xE7B3;"/>
                                            <Setter Property="Foreground" Value="#1C86D1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolbarButton}"
                            ToolTip="Settings — custom context menu commands"
                            Click="Settings_Click">
                        <TextBlock Style="{StaticResource ToolbarIcon}" Text="&#xE713;"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding ActiveTab.StatusText}"/>
            </StatusBarItem>
            <!-- Sticks around after a drop so the way back stays visible once the result
                 message has been replaced by something else. -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding UndoTransferDescription, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding UndoTransferDescription}" Foreground="#1C86D1" Margin="10,0,0,0"/>
            </StatusBarItem>
            <!-- Current file-list selection (blank when nothing is selected). -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding ActiveTab.SelectionSummary, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding ActiveTab.SelectionSummary}" Foreground="#555" Margin="10,0,0,0"/>
            </StatusBarItem>
            <!-- Background MFT indexing progress (blank when idle). -->
            <StatusBarItem DockPanel.Dock="Left"
                           Visibility="{Binding IndexingStatus, Converter={StaticResource NullToCollapsed}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ToolbarIcon}" FontSize="12" Text="&#xE9D9;"
                               Foreground="#1C86D1" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IndexingStatus}" Foreground="#1C86D1" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <!-- Thumbnail size: min = details list, dragging right grows thumbnails. -->
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal" ToolTip="Thumbnail size — drag left for the details list">
                    <TextBlock Style="{StaticResource ToolbarIcon}" FontSize="13" Text="&#xE8FD;"
                               Margin="0,0,6,0" Foreground="#666" VerticalAlignment="Center"/>
                    <Slider x:Name="ThumbSlider" Width="130" Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            Value="{Binding ActiveTab.FileList.ThumbnailScale, Mode=TwoWay}"
                            AutomationProperties.Name="Thumbnail size"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar: drives/devices (top, fills rest) + bookmarks (below, only as tall as needed) -->
            <Grid Grid.Column="0" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bookmarks (below the drive list; sized to content) -->
                <DockPanel Grid.Row="1">
                    <Border DockPanel.Dock="Top" BorderBrush="#EEE" BorderThickness="0,1,0,0">
                        <TextBlock Text="BOOKMARKS" Style="{StaticResource SidebarHeader}"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="10,0,10,8" Foreground="#AAA" FontSize="11"
                               TextWrapping="Wrap" Text="Right-click a file or folder to bookmark it."
                               Visibility="{Binding Bookmarks.HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Bookmarks.HasBookmarks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Bookmarks.Items}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="BmRow" Background="Transparent" Padding="10,4"
                                            MouseLeftButtonUp="BookmarkRow_MouseUp" ToolTip="{Binding FullPath}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open in new tab" Click="BookmarkOpenInNewTab_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Open in new pane">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B0;"/></MenuItem.Icon>
                                                    <MenuItem Header="To the right" Click="BookmarkOpenInPaneRight_Click"/>
                                                    <MenuItem Header="Below" Click="BookmarkOpenInPaneBelow_Click"/>
                                                </MenuItem>
                                                <MenuItem Header="Open" Click="BookmarkOpen_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Remove bookmark" Click="BookmarkRemove_Click">
                                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;"/></MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Opacity="{Binding IconOpacity}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="BmRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BmRow" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Drives & devices (fills the sidebar above the bookmarks) -->
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="DRIVES &amp; DEVICES" Style="{StaticResource SidebarHeader}"/>
                    <Grid>
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Tree.Roots}" BorderThickness="0"
                      Background="White" Padding="0,2"
                      ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="False"
                      Loaded="FolderTree_Loaded"
                      MouseDoubleClick="FolderTree_DoubleClick"
                      PreviewMouseWheel="Scroll_PreviewMouseWheel"
                      ContextMenuOpening="FolderTree_ContextMenuOpening">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in new tab" Click="TreeOpenInNewTab_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in new pane">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B0;"/></MenuItem.Icon>
                            <MenuItem Header="To the right" Click="TreeOpenInPaneRight_Click"/>
                            <MenuItem Header="Below" Click="TreeOpenInPaneBelow_Click"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open in Terminal" Click="TreeOpenTerminal_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in VS Code" Click="TreeOpenVSCode_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="TreeBookmarkMenuItem" Header="Bookmark" Click="TreeBookmark_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE734;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="TreeCustomCommandsSeparator" Visibility="Collapsed"/>
                        <Separator/>
                        <MenuItem Header="Properties…" Click="TreeProperties_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <DockPanel Background="Transparent"
                                   PreviewMouseLeftButtonDown="FolderTreeItem_PreviewMouseDown"
                                   MouseLeftButtonUp="FolderTreeItem_Click">
                            <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                   Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                   Opacity="{Binding IconOpacity}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

                        <!-- Sticky header: the currently open directory, pinned to the top of the
                             tree once its own row scrolls out of view above, so it's always one
                             click away from collapsing. DataContext (the current node) and
                             visibility are driven from code-behind on scroll. -->
                        <Border x:Name="PinnedRow" VerticalAlignment="Top" Visibility="Collapsed"
                                Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                MinHeight="26" SnapsToDevicePixels="True" Cursor="Hand"
                                MouseLeftButtonUp="PinnedRow_Click"
                                ToolTip="Collapse the current folder">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.15"
                                                  BlurRadius="4" ShadowDepth="1" Direction="270"/>
                            </Border.Effect>
                            <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="M 0,0 L 4.5,4.5 L 9,0" Stroke="#555555" StrokeThickness="1.2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <DockPanel Grid.Column="1" Margin="0,0,4,0">
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                           Width="16" Height="16" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Opacity="{Binding IconOpacity}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#EEE"/>

            <!-- Panes. Built in code: the arrangement is a tree of grids and splitters, which
                 XAML cannot express declaratively (ColumnDefinitions are not bindable). -->
            <Border x:Name="PaneHostSite" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
