<v:ThemedWindow x:Class="BertBrowser.App.Views.SettingsWindow"
        xmlns:v="clr-namespace:BertBrowser.App.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Settings" Width="740" Height="560" MinWidth="580" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Theme.Surface.Background}"
        TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <v:ThemedWindow.Resources>
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- The explanatory line under a control. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </v:ThemedWindow.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="14,10"
                Background="{StaticResource Theme.Surface.Background}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource Theme.Border.Subtle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Padding="16,4" Margin="0,0,6,0" IsDefault="True" Click="Save_Click"/>
                <Button Content="Cancel" Padding="16,4" IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- Navigation. One page is visible at a time; the pages themselves are below. -->
        <Border DockPanel.Dock="Left" Width="172"
                Background="{StaticResource Theme.Surface.Background}"
                BorderThickness="0,0,1,0" BorderBrush="{StaticResource Theme.Border.Subtle}">
            <ListBox ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     AutomationProperties.AutomationId="SettingsCategoryList"
                     AutomationProperties.Name="Settings categories">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{Binding Icon}"
                                  Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Background="{StaticResource Theme.Window.Background}">
            <Grid Margin="18,16,18,16">

                <!-- General -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.General}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="General" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Show hidden items" IsChecked="{Binding ShowHiddenItems}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Show hidden files and folders in listings and search results"/>

                    <CheckBox Content="Open archives as folders" Margin="0,12,0,0"
                              IsChecked="{Binding EnterArchivesOnDoubleClick}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Double-clicking a zip, 7z, tar or rar walks into it. With this off they open in whichever program owns them — and the breadcrumb, Enter and typing the path still go in."/>

                    <CheckBox Content="Open drives/devices in a new panel" Margin="0,12,0,0"
                              IsChecked="{Binding OpenDrivesInNewPanel}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="In the sidebar's card view of DRIVES &amp; DEVICES, clicking a drive or device opens it in a new panel instead of a new tab."/>

                    <CheckBox Content="Restore last session on startup" Margin="0,12,0,0"
                              IsChecked="{Binding RestoreLastSession}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="When off, the app always opens a single tab at the folder below instead of wherever the panes were left."/>

                    <DockPanel Margin="0,8,0,0" IsEnabled="{Binding RestoreLastSession, Converter={StaticResource InverseBool}}">
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseStartupPath_Click"/>
                        <TextBox Text="{Binding StartupDefaultPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="Vertical scroll speed" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ScrollSpeedText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="36"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="1" Maximum="6"
                                TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Value="{Binding ScrollSpeed, Mode=TwoWay}"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="Tile aspect ratio" VerticalAlignment="Center"/>
                        <!-- ItemTemplate rather than DisplayMemberPath, for the reason spelled out
                             on the theme picker: the retemplated box renders its closed state from
                             SelectionBoxItemTemplate, which WPF derives from ItemTemplate alone. -->
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding TileAspectOptions}"
                                  SelectedItem="{Binding TileAspect, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <!-- Machine state, not a stored setting: this writes the shell's Directory and
                         Drive open verbs under HKCU the moment it is ticked. Cancel cannot un-write
                         a registry key, so it says so rather than pretending to be held until Save. -->
                    <StackPanel Visibility="{Binding CanChooseFolderHandler, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,4,0,14"/>

                        <CheckBox Content="Open folders in BertBrowser instead of File Explorer"
                                  IsChecked="{Binding OpenFoldersHere}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Text="This PC and Control Panel keep opening in File Explorer, and so does a zip opened from Explorer — BertBrowser browses archives in its own window. So does anything that runs explorer.exe by name — Win+E, the taskbar icon, and some apps' &quot;Show in folder&quot;."/>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                   Foreground="{StaticResource Theme.Warning.Foreground}"
                                   Text="{Binding FolderHandlerWarning}"
                                   Visibility="{Binding HasFolderHandlerWarning, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Preview -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Preview}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Preview" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Show the preview pane in new tabs" IsChecked="{Binding ShowPreviewPane}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Each tab keeps its own preview pane, so one pane can preview while another shows a full-width list. This is what a new tab starts with; Ctrl+P (or Alt+P) toggles the one in front of you."/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Read at most" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PreviewTextLimitText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="60"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="64" Maximum="8192"
                                TickFrequency="64" IsSnapToTickEnabled="True"
                                Value="{Binding PreviewTextLimitKb, Mode=TwoWay}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Trim text after this amount."/>

                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Search inside files up to" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ContentSearchLimitText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" MinWidth="60"
                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                        <Slider Margin="12,0,8,0" VerticalAlignment="Center" Minimum="64" Maximum="8192"
                                TickFrequency="64" IsSnapToTickEnabled="True"
                                Value="{Binding ContentSearchLimitKb, Mode=TwoWay}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="How much of each file content: reads. A file longer than this is searched to here and no further, and the status bar says so rather than reporting it as a miss."/>

                    <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                               Text="Previews don't hold file locks!"/>
                </StackPanel>

                <!--
                  History: the change timeline's switch. Its own page rather than a line on General
                  because what it records is sensitive enough to deserve the explanation beside it,
                  and off by default for the same reason.
                -->
                <StackPanel AutomationProperties.AutomationId="SettingsHistoryPage">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.History}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="History" Style="{StaticResource PageHeading}"/>

                    <CheckBox Content="Record file changes" IsChecked="{Binding RecordFileChanges}"
                              AutomationProperties.AutomationId="RecordFileChanges"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Keeps a log of every file created, changed, deleted or renamed on every indexed drive, so the &quot;What changed&quot; window (Ctrl+Shift+H) can show what an installer or a build just did. The log lives in BertBrowser's own database in your profile folder, readable by anything that can read your files — which is why it is off unless you turn it on. Turning it off deletes what was kept."/>

                    <DockPanel Margin="0,4,0,0" IsEnabled="{Binding RecordFileChanges}">
                        <TextBlock Text="Keep changes for" VerticalAlignment="Center"/>
                        <!-- ItemTemplate rather than DisplayMemberPath, for the reason spelled out
                             on the theme picker. -->
                        <ComboBox DockPanel.Dock="Right" MinWidth="110" HorizontalAlignment="Right"
                                  ItemsSource="{Binding RetentionOptions}"
                                  SelectedValue="{Binding FileChangeRetentionHours, Mode=TwoWay}"
                                  SelectedValuePath="Hours"
                                  AutomationProperties.Name="Keep changes for">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Older changes are dropped as new ones arrive. Whatever you pick, the log never grows past half a million rows."/>

                    <Separator Margin="0,4,0,14"/>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear history now" Padding="12,4"
                                Command="{Binding ClearHistoryCommand}"
                                IsEnabled="{Binding CanClearHistory}"
                                AutomationProperties.AutomationId="ClearHistory"/>
                        <TextBlock Text="{Binding RecordedCountText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource Theme.Text.Secondary}"
                                   AutomationProperties.AutomationId="RecordedCount"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Deletes the log straight away, whether or not you press Save."/>
                </StackPanel>

                <!--
                  Appearance sits outside the dialog's Save/Cancel contract on purpose: a theme you
                  cannot see until you press Save is not a theme you can choose. Picking one applies
                  and persists immediately, which is why the note below says so.
                -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Appearance}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Appearance" Style="{StaticResource PageHeading}"/>

                    <DockPanel>
                        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button DockPanel.Dock="Right" Content="Customise colours…" Margin="8,0,0,0"
                                Click="CustomiseTheme_Click"
                                ToolTip="Edit any colour in this theme and save it as your own"/>
                        <!-- ItemTemplate, not DisplayMemberPath: the themed ComboBox template drives
                             its closed state from SelectionBoxItemTemplate, which WPF only fills in
                             from ItemTemplate. With DisplayMemberPath the box shows ToString(). -->
                        <ComboBox ItemsSource="{Binding Appearance.Themes}"
                                  SelectedItem="{Binding Appearance.SelectedTheme, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource ThemeNameTemplate}"
                                  AutomationProperties.AutomationId="ThemePicker"
                                  AutomationProperties.Name="Theme"/>
                    </DockPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource Theme.Warning.Foreground}"
                               Text="{Binding Appearance.IssueText}"
                               Visibility="{Binding Appearance.IssueText, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>

                <!-- File types on the New submenu -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.NewItems}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="New file types"
                               Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               Text="These appear on the New submenu of the file list and folder tree, in this order. A type with no template file makes an empty file. New ▸ Folder is always offered and is not listed here."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Type list, in menu order -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add" Padding="12,3" Margin="0,0,6,0"
                                        Command="{Binding AddNewFileTypeCommand}"/>
                                <Button Content="Remove" Padding="12,3" Margin="0,0,6,0"
                                        Command="{Binding RemoveNewFileTypeCommand}"/>
                                <Button Content="↑" Padding="9,3" Margin="0,0,6,0" ToolTip="Move up"
                                        Command="{Binding MoveNewFileTypeUpCommand}"/>
                                <Button Content="↓" Padding="9,3" ToolTip="Move down"
                                        Command="{Binding MoveNewFileTypeDownCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding NewFileTypes}"
                                     SelectedItem="{Binding SelectedNewFileType, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2">
                                            <CheckBox DockPanel.Dock="Left" Margin="0,0,6,0"
                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      ToolTip="Show this type on the New menu"/>
                                            <TextBlock Text="{Binding Extension}" Margin="6,0,0,0"
                                                       DockPanel.Dock="Right" Opacity="0.6"/>
                                            <TextBlock Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Editor for the selected type -->
                        <Grid Grid.Column="2" VerticalAlignment="Top">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNewFileType}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.Label, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Extension:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.Extension, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Template:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,6,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedNewFileType.TemplatePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="…" Width="28" Margin="0,0,0,8"
                                    ToolTip="Browse for a template file" Click="BrowseTemplate_Click"/>

                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                       Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="Leave blank to create an empty file."/>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <Button Content="Import from Windows…" Padding="12,3"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ImportFromWindowsCommand}"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Adds the file types Windows offers in its own New menu. This only reads the registry — it never changes what Explorer shows, and types already listed keep their place."/>
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource Theme.Text.Secondary}"
                                           Text="{Binding ImportStatus}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>


                <!-- The default columns a new tab starts from -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Columns}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="Columns" Style="{StaticResource PageHeading}"
                               Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               Text="What a new tab starts with. Columns are per tab, so you can also right-click any column header to change just the tab you are in. Tabs you have already arranged by hand are left alone."/>

                    <!-- Two buttons where there were four: the popup behind Add reaches the whole
                         property system, and dragging a row replaced the up and down pair. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddColumnButton" Padding="10,3" Margin="0,0,6,0"
                                Click="AddColumn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}"
                                           Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Add column"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Reset" Padding="12,3" Command="{Binding ResetColumnsCommand}"/>
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                   Foreground="{StaticResource Theme.Text.Muted}"
                                   Text="Drag to reorder. Scroll a width to change it."/>
                    </StackPanel>

                    <ListBox x:Name="ColumnDefaultsList"
                             AutomationProperties.AutomationId="ColumnDefaultsList"
                             ItemsSource="{Binding Columns}"
                             SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="ColumnList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <!-- One line per column, not two: the canonical name moved onto the row
                                 beside the header, which is what took the height off these. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Fixed rather than Auto: Name has no × and the width boxes would
                                             otherwise sit a button further right on that one row. -->
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The grip is a label, not a handle: the whole row is draggable,
                                         and a target this small would be a worse one. E75F is the dot
                                         gripper — E76F next to it is two thin bars that read as an
                                         equals sign at this size. -->
                                    <Path Style="{StaticResource IconPath}" Grid.Column="0" Data="{StaticResource Icon.Reorder}" Margin="2,0,8,0" Width="12" Height="12"
                                               VerticalAlignment="Center" Opacity="0.55"/>

                                    <!-- DockPanel, not a horizontal StackPanel: a stack hands both
                                         children their full desired width, so the canonical name
                                         would be hard-clipped by the column instead of trimmed. -->
                                    <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Header}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- What lands in settings.json, and the only way to tell
                                             two similarly-named properties apart. Empty for a
                                             built-in, whose id is its header. -->
                                        <TextBlock Text="{Binding Detail}" Margin="8,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                    </DockPanel>
                                    <TextBox Grid.Column="2" Width="52" VerticalAlignment="Center"
                                             Padding="4,2" TextAlignment="Right"
                                             ToolTip="Width in pixels. Scroll to change it, or hold Ctrl to scroll by one."
                                             PreviewMouseWheel="ColumnWidth_Wheel"
                                             Text="{Binding Width, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"/>

                                    <!-- Hover-revealed, so a list of columns reads as a list of
                                         columns rather than a column of buttons. Absent on Name,
                                         the one row that cannot be removed. -->
                                    <Button Grid.Column="3" Width="22" Height="22" Margin="4,0,0,0"
                                            ToolTip="Remove this column"
                                            Visibility="{Binding Removable, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.RemoveColumnCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Content>
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Dismiss}"
                                                       Width="11" Height="11"/>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsMouseOver,
                                                                           RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <!-- Custom context menu commands -->
                <DockPanel>
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCategory.Id}"
                                             Value="{x:Static vm:SettingsCategory.Commands}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <TextBlock DockPanel.Dock="Top" Text="Custom context menu commands"
                               Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               Text="These commands appear in the right-click menu of the file list and folder tree. In Arguments, {path}, {name} and {dir} expand per item — quote tokens that may contain spaces, e.g. &quot;{path}&quot;. Blank arguments default to the quoted full path."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Command list -->
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Add" Padding="12,3" Margin="0,0,6,0" Command="{Binding AddCommand}"/>
                                <Button Content="Remove" Padding="12,3" Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Editor for the selected command -->
                        <Grid Grid.Column="2" VerticalAlignment="Top">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCommand}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedCommand.Name, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Program:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedCommand.Command, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="…" Width="28" Margin="0,0,0,8"
                                    ToolTip="Browse for a program" Click="Browse_Click"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                     VerticalContentAlignment="Center"
                                     ToolTip="{}{path} = full path, {name} = file name, {dir} = parent directory"
                                     Text="{Binding SelectedCommand.Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <CheckBox Content="Show for files" IsChecked="{Binding SelectedCommand.AppliesToFiles}"
                                          Margin="0,0,16,0"/>
                                <CheckBox Content="Show for folders" IsChecked="{Binding SelectedCommand.AppliesToDirectories}"/>
                            </StackPanel>

                            <!-- Its own row rather than beside the "show for" pair: those two say
                                 where the command appears, this one says what it can do. -->
                            <CheckBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                      Content="Run as administrator"
                                      ToolTip="Windows asks for confirmation each time this command runs."
                                      IsChecked="{Binding SelectedCommand.RunElevated}"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
