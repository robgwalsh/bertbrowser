<Window x:Class="BertBrowser.App.Views.TransferConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="540" SizeToContent="Height"
        MinHeight="260" MaxHeight="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap"
                   FontSize="14" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="Choose what to do with all of them." Foreground="#666"
                   Margin="0,0,0,10"/>

        <!-- Buttons are ordered least to most destructive, and Keep both is the default. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Skip these" Width="90" Margin="0,0,8,0" Click="Skip_Click"/>
            <Button Content="Replace" Width="90" Margin="0,0,8,0" Click="Replace_Click"
                    Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"/>
            <Button Content="Keep both" Width="100" IsDefault="True" Click="KeepBoth_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReplaceHint}" Foreground="#666" FontSize="11"
                   TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"/>

        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" BorderBrush="#EEE" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Incoming:" Foreground="#666"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IncomingDetail}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IncomingIsNewer}" Value="True">
                                                            <Setter Property="Foreground" Value="#1C86D1"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Text="Already here:" Foreground="#666"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExistingDetail}"
                                                   Foreground="#444" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
