<v:ThemedWindow x:Class="BertBrowser.App.Views.TransferConflictDialog"
        xmlns:v="clr-namespace:BertBrowser.App.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
        xmlns:tx="clr-namespace:BertBrowser.Core.Services.Transfer;assembly=BertBrowser.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TransferConflictsViewModel}"
        Title="{Binding Title}" Width="580" Height="560"
        MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="TransferConflicts"
        Background="{StaticResource Theme.Surface.Background}"
        TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Resizable, and taller than it is wide by default: the list is the point of it now that every
      row carries its own answer, the same reason the delete and sync dialogs are resizable.
    -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap"
                   FontSize="14" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitle}" TextWrapping="Wrap"
                   Foreground="{StaticResource Theme.Text.Secondary}" Margin="0,0,0,10"/>

        <!-- Cancel abandons the whole transfer; Continue carries out whatever each row now says.
             Continue is the default because every row starts on Keep both, which destroys nothing. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Continue" Width="100" IsDefault="True" Click="Continue_Click"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.AutomationId="ConflictContinue"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ReplaceHint}"
                   Foreground="{StaticResource Theme.Text.Secondary}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"/>

        <!-- The whole of what this dialog used to be able to say, kept as one press: a drop of forty
             onto forty taken names is almost always one decision. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Apply to all:" VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.Text.Secondary}"/>
            <Button Style="{StaticResource LinkButton}" Content="Skip" Margin="8,0,0,0"
                    Command="{Binding ApplyToAllCommand}" CommandParameter="{x:Static tx:ConflictResolution.Skip}"/>
            <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.Text.Muted}"
                       Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"/>
            <Button Style="{StaticResource LinkButton}" Content="Replace"
                    Command="{Binding ApplyToAllCommand}" CommandParameter="{x:Static tx:ConflictResolution.Replace}"
                    Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="·" Margin="8,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.Text.Muted}"/>
            <Button Style="{StaticResource LinkButton}" Content="Keep both"
                    Command="{Binding ApplyToAllCommand}" CommandParameter="{x:Static tx:ConflictResolution.KeepBoth}"/>
        </StackPanel>

        <!--
          A ListBox rather than an ItemsControl in a ScrollViewer, because that arrangement builds a
          container for every row up front. One merged folder can bring five thousand of them, each
          a Border, a Grid and three RadioButtons, all constructed inside ShowDialog. A ListBox
          virtualizes by default; the container style is only here to take the selection chrome off
          something that is a form rather than a list to pick from.
        -->
        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1" CornerRadius="3">
            <ListBox ItemsSource="{Binding Items}"
                     AutomationProperties.AutomationId="ConflictRows"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TransferConflictViewModel}">
                            <Border Padding="10,8" BorderBrush="{StaticResource Theme.Border.Subtle}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Incoming:" Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IncomingDetail}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IncomingIsNewer}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Link}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- "Already here:" for something on disk, "Also arriving:" when
                                             the clash is with another item in this same transfer. -->
                                        <TextBlock Grid.Row="1" Text="{Binding ExistingLabel}"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExistingDetail}"
                                                   Foreground="{StaticResource Theme.Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <!-- This row's own answer. GroupName is the canonical source path,
                                         not the display name: two sources from different folders can
                                         share a name, which is one of the ways a row gets here. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <RadioButton Content="Skip" Margin="0,0,14,0"
                                                     GroupName="{Binding GroupName}"
                                                     AutomationProperties.Name="{Binding Name}"
                                                     IsChecked="{Binding Resolution, Mode=TwoWay,
                                                         Converter={StaticResource EnumEqualsBool},
                                                         ConverterParameter=Skip}"/>
                                        <RadioButton Content="Replace" Margin="0,0,14,0"
                                                     GroupName="{Binding GroupName}"
                                                     Visibility="{Binding AllowReplace, Converter={StaticResource BoolToVisibility}}"
                                                     IsChecked="{Binding Resolution, Mode=TwoWay,
                                                         Converter={StaticResource EnumEqualsBool},
                                                         ConverterParameter=Replace}"/>
                                        <RadioButton Content="Keep both"
                                                     GroupName="{Binding GroupName}"
                                                     IsChecked="{Binding Resolution, Mode=TwoWay,
                                                         Converter={StaticResource EnumEqualsBool},
                                                         ConverterParameter=KeepBoth}"/>
                                    </StackPanel>

                                    <!-- Why this folder is still one question. -->
                                    <TextBlock Text="{Binding MergeNote}" TextWrapping="Wrap"
                                               Margin="0,6,0,0" FontSize="11"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               Visibility="{Binding MergeNote, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</v:ThemedWindow>
