<v:ThemedWindow x:Class="BertBrowser.App.Views.MessageDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Width="420" SizeToContent="Height" MinHeight="150"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!-- Replaces MessageBox, which is drawn by the OS and cannot be themed: a bright white box in
         the middle of a dark app is the one thing that gives the whole retheme away. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Margin="0,0,8,0"
                    IsCancel="True" Visibility="Collapsed"/>
            <Button x:Name="OkButton" Content="OK" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>

        <DockPanel>
            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontSize="22" Margin="0,0,12,0"
                       VerticalAlignment="Top" FontFamily="{StaticResource SymbolFont}"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </DockPanel>
</v:ThemedWindow>
