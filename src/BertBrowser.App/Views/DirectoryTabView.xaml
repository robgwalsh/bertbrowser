<UserControl x:Class="BertBrowser.App.Views.DirectoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:v="clr-namespace:BertBrowser.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DirectoryTabViewModel}"
             AutomationProperties.AutomationId="DirectoryTab"
             AutomationProperties.Name="{Binding CurrentPath}">
    <!--
      One browsable directory. Several of these are alive at once — one per tab, across every pane
      — so nothing here may reach for "the" current directory: the DataContext is this tab, and the
      GridView and ContextMenu are declared inline because those are element instances and cannot
      be shared between ListViews.
    -->
    <DockPanel>
        <!-- Breadcrumb / editable path + search. Per tab, not per window: two panes showing
             different folders each need their own address bar and their own search box. -->
        <Grid DockPanel.Dock="Top" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Address bar: same rounded field chrome as the search box. -->
            <Border Style="{StaticResource FieldBorder}" Padding="6,0">
                <!-- The click-to-edit handler sits on the Grid, not the ItemsControl: inside a
                     ScrollViewer the crumbs are measured at their natural width, so they don't fill
                     the bar and empty space to their right never reaches them. A breadcrumb Button
                     marks the mouse-up handled, so this only fires for genuine empty space. -->
                <Grid Background="Transparent" MouseLeftButtonUp="Breadcrumb_EmptyClick">
                    <ScrollViewer x:Name="BreadcrumbScroller" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Breadcrumb" ItemsSource="{Binding BreadcrumbSegments}"
                                      VerticalAlignment="Center"
                                      PreviewMouseDown="Breadcrumb_PreviewMouseDown"
                                      Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource BreadcrumbButton}" Content="{Binding Name}"
                                                Click="BreadcrumbSegment_Click" Tag="{Binding FullPath}"/>
                                        <TextBlock Text="›" VerticalAlignment="Center" Foreground="{StaticResource Theme.Text.Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="PathBox" Visibility="Collapsed" VerticalAlignment="Center"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus"/>
                </Grid>
            </Border>

            <!-- Local search that doesn't suck: files & folders under the current directory, and
                 nothing else. Whole-PC search is the header's field, so there is no scope toggle
                 here and no mode to read before typing. -->
            <Border Grid.Column="1" Style="{StaticResource FieldBorder}" Margin="6,0,0,0"
                    Width="280" MinWidth="150">
                <DockPanel>
                    <!-- The glyph carries the syntax help: an unexplained filter language is an
                         undiscoverable one, and this is the only fixed thing beside the box. -->
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource SymbolFont}"
                               Text="&#xE721;" FontSize="13" Margin="8,0,6,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Theme.Text.Secondary}"
                               ToolTipService.InitialShowDelay="300"
                               ToolTip="{StaticResource SearchSyntaxToolTip}"/>
                    <Button DockPanel.Dock="Right" ToolTip="Clear search (Esc)"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SearchClearButton}">
                        <TextBlock FontFamily="{StaticResource SymbolFont}" Text="&#xE711;" FontSize="12"/>
                    </Button>
                    <Grid>
                        <!-- These ids repeat once per open tab now. Only the visible tab of each
                             pane is in the automation tree (the rest are Collapsed), so a single
                             pane still exposes exactly one of each. -->
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="SearchBox"
                                 AutomationProperties.Name="Search this folder"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Search this folder and everything under it (Ctrl+F). Filters: ext: size: dm: path: is: re: in: content:, plus OR and !"/>
                        <TextBlock Text="Search this folder" Foreground="{StaticResource Theme.Text.Placeholder}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Activity indicator: search / directory load in progress (fixed height, no layout shift) -->
        <Grid DockPanel.Dock="Top" Height="3" Margin="4,1,4,0">
            <ProgressBar IsIndeterminate="True" BorderThickness="0"
                         Visibility="{Binding FileList.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!--
          Error banner. The Unlock button rides in it rather than in a dialog of its own because a
          locked archive is a *listing state*, not an event: it survives back and forward, it is
          still there when you come back to the tab, and it must never be raised from the background
          load that discovered it.
        -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Theme.Warning.Background}" Padding="8,4"
                Visibility="{Binding FileList.ErrorMessage, Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Unlock…" Margin="12,0,0,0" MinWidth="80"
                        Click="Unlock_Click"
                        Visibility="{Binding FileList.IsArchiveLocked, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding FileList.ErrorMessage}" VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.Warning.Foreground}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!--
          The list and the preview pane, with a splitter between them. The empty-state overlay
          stays in the same cell as the ListView: it is centred over the *list*, and moving it out
          here would centre it over list-and-preview together.

          The splitter and the preview column are Auto/0 rather than collapsed elements, and their
          widths are assigned from code-behind — ColumnDefinition.Width is not bindable, which is
          the same reason PaneLayoutHost is built in code. The precedent is UpdateRelPathColumn.
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120"/>
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- The implicit GridSplitter style themes this; it needs none of its own. -->
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ShowsPreview="False"
                          DragCompleted="PreviewSplitter_DragCompleted"/>

            <v:PreviewPane x:Name="PreviewPane" Grid.Column="2"
                           DataContext="{Binding Preview}"/>

        <Grid Grid.Column="0">
            <ListView x:Name="FileListView"
                      AutomationProperties.AutomationId="FileList"
                      ItemsSource="{Binding FileList.Items}"
                      BorderThickness="0"
                      IsTextSearchEnabled="False"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      GridViewColumnHeader.Click="FileList_HeaderClick"
                      MouseDoubleClick="FileList_DoubleClick"
                      PreviewMouseDown="FileList_PreviewMouseDown"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      SelectionChanged="FileList_SelectionChanged"
                      TextInput="FileList_TextInput"
                      KeyDown="FileList_KeyDown"
                      PreviewMouseWheel="Scroll_PreviewMouseWheel"
                      ContextMenuOpening="FileList_ContextMenuOpening">
                <ListView.ItemContainerStyle>
                    <StaticResource ResourceKey="FileRowStyle"/>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <!-- New targets the folder being shown, never the selection, which is why
                             it is above Open — and why right-clicking empty space, which opens this
                             same menu, gets it without needing its own affordance. -->
                        <MenuItem x:Name="NewMenuItem" Header="New">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE710;"/></MenuItem.Icon>
                            <MenuItem Header="Folder" InputGestureText="Ctrl+Shift+N"
                                      Click="ContextNewFolder_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B7;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- The configured file types are built here at ContextMenuOpening. -->
                            <Separator x:Name="NewFileTypesSeparator"/>
                            <Separator/>
                            <MenuItem Header="Empty file…" Click="ContextNewEmptyFile_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7C3;"/></MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open" Click="ContextOpen_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Spelled out rather than folded into "Open" behind a modifier, for the
                             same reason Delete permanently… is below: a menu whose meaning depends
                             on a key you are not holding while you read it is the wrong place to
                             hide "with full access to this computer". -->
                        <MenuItem x:Name="RunAsAdminMenuItem" Header="Run as administrator"
                                  InputGestureText="Ctrl+Shift+Enter" Click="ContextRunAsAdmin_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xEA18;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenInNewTabMenuItem" Header="Open in new tab"
                                  Click="ContextOpenInNewTab_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenInNewPaneMenuItem" Header="Open in new pane">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B0;"/></MenuItem.Icon>
                            <MenuItem Header="To the right" Click="ContextOpenInPaneRight_Click"/>
                            <MenuItem Header="Below" Click="ContextOpenInPaneBelow_Click"/>
                        </MenuItem>
                        <MenuItem x:Name="OpenInTerminalMenuItem" Header="Open in Terminal"
                                  Click="ContextOpenTerminal_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenInVSCodeMenuItem" Header="Open in VS Code"
                                  Click="ContextOpenVSCode_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Folders only: a single file's size is already in the Size column, so
                             analysing one would only ever restate it. -->
                        <MenuItem x:Name="DiskUsageMenuItem" Header="Analyse disk usage…"
                                  InputGestureText="Ctrl+Shift+D" Click="ContextDiskUsage_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9A9;"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Folders only, for the same reason: one file cannot be a duplicate of
                             itself, so a single selected file has nothing to search. -->
                        <MenuItem x:Name="DuplicatesMenuItem" Header="Find duplicates…"
                                  InputGestureText="Ctrl+Shift+U" Click="ContextDuplicates_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CompressMenuItem" Header="Compress…"
                                  Click="ContextCompress_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xF012;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ExtractHereMenuItem" Header="Extract here"
                                  Click="ContextExtractHere_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8DE;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ExtractToMenuItem" Header="Extract to…"
                                  Click="ContextExtractTo_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8DE;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="CopyPathMenuItem" Header="Copy as path"
                                  InputGestureText="Ctrl+Shift+C" Click="ContextCopyPath_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CopyNameMenuItem" Header="Copy name" Click="ContextCopyName_Click"/>
                        <Separator/>
                        <MenuItem x:Name="CutMenuItem" Header="Cut" InputGestureText="Ctrl+X" Click="ContextCut_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C6;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CopyMenuItem" Header="Copy" InputGestureText="Ctrl+C" Click="ContextCopy_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="PasteMenuItem" Header="Paste" InputGestureText="Ctrl+V" Click="ContextPaste_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE77F;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="RenameMenuItem" Header="Rename…" InputGestureText="F2"
                                  Click="ContextRename_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8AC;"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- Both spelled out rather than one entry that changes with Shift: a menu
                             whose meaning depends on a key you are not holding while you read it is
                             the wrong place to hide "cannot be undone". -->
                        <MenuItem x:Name="DeleteMenuItem" Header="Delete…" InputGestureText="Del"
                                  Click="ContextDelete_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="DeletePermanentlyMenuItem" Header="Delete permanently…"
                                  InputGestureText="Shift+Del" Click="ContextDeletePermanently_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74B;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="BookmarkMenuItem" Header="Bookmark" Click="ContextBookmark_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE734;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="CustomCommandsSeparator" Visibility="Collapsed"/>
                        <Separator/>
                        <MenuItem Header="Properties…" InputGestureText="Alt+Enter" Click="ContextProperties_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <!--
                  The columns are built in code, not declared here: which ones there are is the
                  user's, and GridView.Columns has no ItemsSource to bind a list through. See
                  DirectoryTabView.ReconcileColumns and Core/Services/Columns/ColumnLayoutRules.
                  The GridView itself still has to be an instance per view — element instances cannot
                  be shared between ListViews, which is why this file has its own rather than
                  pointing at a resource.
                -->
                <ListView.View>
                    <GridView x:Name="DetailsView"/>
                </ListView.View>
            </ListView>

            <!-- Inline empty state for searches with no hits -->
            <TextBlock IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource Theme.Text.Muted}"
                       Text="{Binding FileList.EmptyMessage}"
                       Visibility="{Binding FileList.EmptyMessage, Converter={StaticResource NullToCollapsed}}"/>
        </Grid>
        </Grid>
    </DockPanel>
</UserControl>
