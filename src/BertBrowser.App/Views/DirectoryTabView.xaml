<UserControl x:Class="BertBrowser.App.Views.DirectoryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DirectoryTabViewModel}"
             AutomationProperties.AutomationId="DirectoryTab"
             AutomationProperties.Name="{Binding CurrentPath}">
    <!--
      One browsable directory. Several of these are alive at once — one per tab, across every pane
      — so nothing here may reach for "the" current directory: the DataContext is this tab, and the
      GridView and ContextMenu are declared inline because those are element instances and cannot
      be shared between ListViews.
    -->
    <DockPanel>
        <!-- Breadcrumb / editable path + search. Per tab, not per window: two panes showing
             different folders each need their own address bar and their own search box. -->
        <Grid DockPanel.Dock="Top" Margin="4,4,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Address bar: same rounded field chrome as the search box. -->
            <Border Style="{StaticResource FieldBorder}" Padding="6,0">
                <!-- The click-to-edit handler sits on the Grid, not the ItemsControl: inside a
                     ScrollViewer the crumbs are measured at their natural width, so they don't fill
                     the bar and empty space to their right never reaches them. A breadcrumb Button
                     marks the mouse-up handled, so this only fires for genuine empty space. -->
                <Grid Background="Transparent" MouseLeftButtonUp="Breadcrumb_EmptyClick">
                    <ScrollViewer x:Name="BreadcrumbScroller" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Breadcrumb" ItemsSource="{Binding BreadcrumbSegments}"
                                      VerticalAlignment="Center"
                                      PreviewMouseDown="Breadcrumb_PreviewMouseDown"
                                      Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource BreadcrumbButton}" Content="{Binding Name}"
                                                Click="BreadcrumbSegment_Click" Tag="{Binding FullPath}"/>
                                        <TextBlock Text="›" VerticalAlignment="Center" Foreground="{StaticResource Theme.Text.Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox x:Name="PathBox" Visibility="Collapsed" VerticalAlignment="Center"
                             BorderThickness="0" Background="Transparent"
                             KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus"/>
                </Grid>
            </Border>

            <!-- Local search that doesn't suck: files & folders under the current directory. -->
            <Border Grid.Column="1" Style="{StaticResource FieldBorder}" Margin="6,0,0,0"
                    Width="280" MinWidth="150">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" IsChecked="{Binding SearchGlobal}"
                                  VerticalAlignment="Center" Margin="4,0,2,0" Padding="8,2"
                                  ToolTip="Search scope — the whole PC (MFT index) or just this folder">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="This folder"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Content" Value="This PC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource SymbolFont}"
                               Text="&#xE721;" FontSize="13" Margin="8,0,6,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Theme.Text.Secondary}"/>
                    <Button DockPanel.Dock="Right" ToolTip="Clear search (Esc)"
                            Command="{Binding ClearSearchCommand}"
                            Style="{StaticResource SearchClearButton}">
                        <TextBlock FontFamily="{StaticResource SymbolFont}" Text="&#xE711;" FontSize="12"/>
                    </Button>
                    <Grid>
                        <!-- These ids repeat once per open tab now. Only the visible tab of each
                             pane is in the automation tree (the rest are Collapsed), so a single
                             pane still exposes exactly one of each. -->
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.AutomationId="SearchBox"
                                 AutomationProperties.Name="Search this folder"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Search files and folders — whole PC or this folder (Ctrl+F)"/>
                        <TextBlock Text="Search files and folders" Foreground="{StaticResource Theme.Text.Placeholder}" Margin="4,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Activity indicator: search / directory load in progress (fixed height, no layout shift) -->
        <Grid DockPanel.Dock="Top" Height="3" Margin="4,1,4,0">
            <ProgressBar IsIndeterminate="True" BorderThickness="0"
                         Visibility="{Binding FileList.IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Error banner -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Theme.Warning.Background}" Padding="8,4"
                Visibility="{Binding FileList.ErrorMessage, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding FileList.ErrorMessage}" Foreground="{StaticResource Theme.Warning.Foreground}" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <ListView x:Name="FileListView"
                      AutomationProperties.AutomationId="FileList"
                      ItemsSource="{Binding FileList.Items}"
                      BorderThickness="0"
                      IsTextSearchEnabled="False"
                      SelectionMode="Extended"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      GridViewColumnHeader.Click="FileList_HeaderClick"
                      MouseDoubleClick="FileList_DoubleClick"
                      PreviewMouseDown="FileList_PreviewMouseDown"
                      PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                      SelectionChanged="FileList_SelectionChanged"
                      TextInput="FileList_TextInput"
                      KeyDown="FileList_KeyDown"
                      PreviewMouseWheel="Scroll_PreviewMouseWheel"
                      ContextMenuOpening="FileList_ContextMenuOpening">
                <ListView.ItemContainerStyle>
                    <StaticResource ResourceKey="FileRowStyle"/>
                </ListView.ItemContainerStyle>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Click="ContextOpen_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenInNewTabMenuItem" Header="Open in new tab"
                                  Click="ContextOpenInNewTab_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="OpenInNewPaneMenuItem" Header="Open in new pane">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B0;"/></MenuItem.Icon>
                            <MenuItem Header="To the right" Click="ContextOpenInPaneRight_Click"/>
                            <MenuItem Header="Below" Click="ContextOpenInPaneBelow_Click"/>
                        </MenuItem>
                        <MenuItem Header="Open in Terminal" Click="ContextOpenTerminal_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in VS Code" Click="ContextOpenVSCode_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="CutMenuItem" Header="Cut" InputGestureText="Ctrl+X" Click="ContextCut_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C6;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="CopyMenuItem" Header="Copy" InputGestureText="Ctrl+C" Click="ContextCopy_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="PasteMenuItem" Header="Paste" InputGestureText="Ctrl+V" Click="ContextPaste_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE77F;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Compute size" Click="ContextComputeSize_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE1D0;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="BookmarkMenuItem" Header="Bookmark" Click="ContextBookmark_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE734;"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="CustomCommandsSeparator" Visibility="Collapsed"/>
                        <Separator/>
                        <MenuItem Header="Properties…" InputGestureText="Alt+Enter" Click="ContextProperties_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE946;"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView x:Name="DetailsView">
                        <GridViewColumn Width="320" x:Name="NameColumn">
                            <GridViewColumnHeader Content="Name" Tag="Name"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                                               Opacity="{Binding IconOpacity}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="220" x:Name="RelPathColumn">
                            <GridViewColumnHeader Content="Folder" Tag="RelativePath"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelativePath}" Opacity="0.7"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="110">
                            <GridViewColumnHeader Content="Size" Tag="Size"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                                   ToolTip="{Binding SizeTooltip}"
                                                   Visibility="{Binding IsSizeComputing, Converter={StaticResource InverseBoolToVisibility}}"/>
                                        <ProgressBar IsIndeterminate="True" Height="10" Width="70"
                                                     Visibility="{Binding IsSizeComputing, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="120">
                            <GridViewColumnHeader Content="Type" Tag="Type"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="140">
                            <GridViewColumnHeader Content="Modified" Tag="Modified"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModifiedDisplay}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Inline empty state for searches with no hits -->
            <TextBlock IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource Theme.Text.Muted}"
                       Text="{Binding FileList.EmptyMessage}"
                       Visibility="{Binding FileList.EmptyMessage, Converter={StaticResource NullToCollapsed}}"/>
        </Grid>
    </DockPanel>
</UserControl>
