<v:ThemedWindow x:Class="BertBrowser.App.Views.DiskUsageWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:DiskUsageViewModel}"
                Title="Disk usage" Width="880" Height="620" MinWidth="560" MinHeight="360"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="DiskUsage"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless, for the reason the theme editor is: you look at this while browsing, and following
      what it says means going to a folder in a tab behind it.
    -->
    <DockPanel Margin="14">

        <!-- Where we are, and how to get back out of a drill-down. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Content="Up" MinWidth="54" Margin="0,0,8,0"
                    Command="{Binding GoUpCommand}"
                    IsEnabled="{Binding CanGoUp}"
                    AutomationProperties.Name="Go up"/>
            <Button DockPanel.Dock="Right" Content="Refresh" MinWidth="70" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}"/>
            <TextBlock Text="{Binding RootDisplay}" VerticalAlignment="Center"
                       FontSize="14" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="DiskUsageRoot"/>
        </DockPanel>

        <!--
          The banner is where an unusable answer is explained rather than silently drawn as zeros.
          Its four wordings are the four ways this can fail, and they are deliberately distinct: an
          unindexed drive must not read like an empty one.

          Docked at the bottom, which is both where MainWindow already carries this same indexing
          news and the only place it can appear and disappear without moving anything: its height
          depends on its wording, so no fixed slot could reserve it. From the top it would push the
          whole view down — and it really does toggle from one drill to the next while an index is
          still building, since a measured folder and an unmeasured one are a click apart.
        -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource Theme.Warning.Background}"
                BorderBrush="{StaticResource Theme.Warning.Border}" BorderThickness="1"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="DiskUsageBanner">
            <DockPanel>
                <!-- The same retry the status bar offers, and equally never automatic: a retry
                     raises a UAC prompt. -->
                <Button DockPanel.Dock="Right" Content="Try again" MinWidth="80" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.Warning.Foreground}"/>
            </DockPanel>
        </Border>

        <!--
          The bar is inside a container that is always there, so its space is reserved whether it
          is showing or not. Collapsing the bar itself would take 10px out of the vertical flow on
          every load and put them back a moment later — which, since drilling into a tile is a
          load, meant the whole dialog jumped every time you clicked a rectangle.
        -->
        <Border DockPanel.Dock="Top" Height="2" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- What this folder is made of, drillable. -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Biggest items here" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- Reserved the same way, and for the same reason: whether a folder has unmeasured
                     children varies from one drill to the next. The height is on the container,
                     not the TextBlock — a collapsed element has no size, so a MinHeight on it
                     would reserve exactly nothing. -->
                <Border DockPanel.Dock="Bottom" Height="15" Margin="0,6,0,0">
                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Theme.Text.Secondary}"
                               Text="{Binding UnknownChildCount, StringFormat={}{0} folders have never been measured and are shown without a size.}"
                               Visibility="{Binding HasUnknownChildren, Converter={StaticResource BoolToVisibility}}"/>
                </Border>

                <!--
                  The map and the list are the same numbers twice over, and both earn their place:
                  the map shows proportion at a glance, the list gives exact figures, names that are
                  too long to label a tile, and the unmeasured folders that get no tile at all.
                -->
                <Border DockPanel.Dock="Top" Height="180" Margin="0,0,0,6"
                        BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                        CornerRadius="3" ClipToBounds="True">
                    <v:TreemapCanvas x:Name="Treemap"/>
                </Border>

                <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                        CornerRadius="3">
                    <ListBox x:Name="ChildList" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Children}"
                             MouseDoubleClick="Child_DoubleClick"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             AutomationProperties.AutomationId="DiskUsageChildren">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="10,0,0,0"
                                               Foreground="{StaticResource Theme.Text.Secondary}"/>

                                    <!--
                                      The bar is the measurement made visible, so an unmeasured row
                                      gets none: Fraction is 0 for an unknown size, and an empty bar
                                      is the honest picture of a share nobody has established. A
                                      ProgressBar rather than a hand-sized Border because it scales
                                      itself to the row and is already themed.
                                    -->
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                                                 Margin="0,3,0,0" BorderThickness="0"
                                                 Minimum="0" Maximum="1"
                                                 Value="{Binding Fraction, Mode=OneWay}"
                                                 Focusable="False" IsHitTestVisible="False"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- The biggest files anywhere beneath this root. -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Largest files below here"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                        CornerRadius="3">
                  <Grid>
                    <!-- An unexplained blank panel reads as a failure, so it says why it is empty. -->
                    <TextBlock Text="{Binding LargestFilesEmptyMessage}" Margin="10"
                               TextWrapping="Wrap" VerticalAlignment="Top"
                               Foreground="{StaticResource Theme.Text.Secondary}"/>
                    <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding LargestFiles}"
                             MouseDoubleClick="File_DoubleClick"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             AutomationProperties.AutomationId="DiskUsageLargestFiles">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="16" Height="16"
                                           Margin="0,0,8,0" VerticalAlignment="Top"
                                           SnapsToDevicePixels="True"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                                               Margin="10,0,0,0" VerticalAlignment="Top"
                                               Foreground="{StaticResource Theme.Text.Secondary}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</v:ThemedWindow>
