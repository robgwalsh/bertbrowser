<v:ThemedWindow x:Class="BertBrowser.App.Views.ThemeEditorWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:AppearanceViewModel}"
                Title="Customise theme" Width="460" Height="620" MinWidth="380" MinHeight="360"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="ThemeEditor"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless on purpose: every change applies to the running app immediately, and a modal window
      would cover the file list you are trying to judge the colours against.
    -->
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- ItemTemplate, not DisplayMemberPath — see ThemeNameTemplate in Styles.xaml. -->
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                      ItemTemplate="{StaticResource ThemeNameTemplate}"
                      AutomationProperties.Name="Theme"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right" Content="All colours" VerticalAlignment="Center"
                      Margin="10,0,0,0" IsChecked="{Binding ShowAllColors}"
                      ToolTip="Show every colour the theme defines, not just the main ones"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search colours"/>
        </DockPanel>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Import…" Margin="0,0,6,6" Click="Import_Click"/>
                    <Button Content="Export…" Margin="0,0,6,6" Click="Export_Click"/>
                    <Button Content="Save as…" Margin="0,0,6,6" Click="SaveAs_Click"
                            ToolTip="Save the current colours as a new theme of your own"/>
                    <Button Content="Reset all" Margin="0,0,6,6" Command="{Binding ResetAllCommand}"/>
                    <Button Content="Revert" Margin="0,0,6,6" Command="{Binding RevertCommand}"
                            ToolTip="Discard changes made since they were last kept"/>
                    <Button Content="Keep" Margin="0,0,0,6" Style="{StaticResource PrimaryButton}"
                            Command="{Binding KeepCommand}" ToolTip="Save these colours"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ListBox ItemsSource="{Binding TokensView.View}" BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="ThemeTokenList">
            <ListBox.ItemContainerStyle>
                <!-- These rows are edited, not selected; the selection highlight would just fight
                     with the swatches. -->
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="2,10,0,4"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Theme.Text.Muted}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1" ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <!-- Bold marks a colour you have changed from the theme's own. -->
                                        <DataTrigger Binding="{Binding IsOverridden}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="1" Width="30" Height="22" Padding="0" Margin="0,0,6,0"
                                Click="Swatch_Click" Tag="{Binding}"
                                AutomationProperties.Name="{Binding DisplayName}">
                            <Border Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                    CornerRadius="1"/>
                        </Button>

                        <TextBox Grid.Column="2" Width="86" VerticalContentAlignment="Center"
                                 FontFamily="Consolas, Cascadia Mono, monospace" FontSize="11"
                                 Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHexValid}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource Theme.Error.Border}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Grid.Column="3" Width="24" Margin="4,0,0,0" Padding="0"
                                Content="&#xE7A7;" FontFamily="{StaticResource SymbolFont}" FontSize="12"
                                ToolTip="Reset this colour to the theme's own"
                                Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding DataContext.ResetTokenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</v:ThemedWindow>
