<!--
  The command palette: a box and, under it, whatever PaletteRules says belongs there.

  An overlay inside the main window rather than a Popup or a dialog. A Popup is its own top-level
  window — WPF would put it on a real monitor, where the UI harness could not photograph it and
  where its text would render without ClearType if it were ever given a rounded corner. In the
  tree it is an ordinary element: `shot` captures it, it sits over the settings page as well as
  over the folders, and it is disabled with everything else when a dialog is up.
-->
<UserControl x:Class="BertBrowser.App.Views.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:BertBrowser.App.Views"
             xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}">
    <UserControl.Resources>
        <!--
          A row's own look, rather than the list's: nothing in here ever has the keyboard — the box
          keeps it, so typing carries on while the arrows move the selection — and the stock
          ListBoxItem draws an unfocused selection in the muted "inactive" colours, which is the
          wrong thing to say about the row Enter is about to run.
        -->
        <Style x:Key="PaletteRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="4" Margin="6,0" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource Theme.List.HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource Theme.List.SelectedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource Theme.List.SelectedForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A heading cannot be hovered, selected or clicked: it is a label, and the view
                     model steps the selection over it. -->
                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Padding" Value="12,10,12,3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The two buttons a row grows when it is pointed at or selected. -->
        <Style x:Key="PaletteRowButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground"
                    Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="HeadingRow">
            <TextBlock Text="{Binding Text}" FontSize="10.5" FontWeight="SemiBold"
                       TextOptions.TextFormattingMode="Ideal"
                       Foreground="{StaticResource Theme.Text.Muted}"/>
        </DataTemplate>

        <DataTemplate x:Key="EntryRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="RowIcon" Style="{StaticResource IconPath}" Data="{Binding Icon}"
                      HorizontalAlignment="Left" Width="15" Height="15"/>

                <v:HighlightTextBlock x:Name="RowName" Grid.Column="1" VerticalAlignment="Center"
                                      Source="{Binding Text}" Ranges="{Binding Highlights}"
                                      TextTrimming="CharacterEllipsis"/>

                <!-- Category, location, or the reason it cannot run. The row's own colour at less
                     than full strength, so it stays legible on a selected row in every theme
                     without needing a second "muted on selected" token. -->
                <TextBlock x:Name="RowDetail" Grid.Column="2" Text="{Binding Detail}" Margin="16,0,0,0"
                           FontSize="11.5" Opacity="0.62" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>

                <TextBlock Grid.Column="3" Text="{Binding Gesture}" Margin="16,0,0,0"
                           FontSize="11.5" Opacity="0.8" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button x:Name="BindButton" Style="{StaticResource PaletteRowButton}"
                            ToolTip="Change its keyboard shortcut (Alt+K)" Click="Bind_Click"
                            AutomationProperties.Name="Change shortcut">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Keyboard}" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource PaletteRowButton}"
                            ToolTip="{Binding PinToolTip}" Click="Pin_Click"
                            AutomationProperties.Name="Pin">
                        <Path Style="{StaticResource IconPath}" Data="{Binding PinIcon}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Dimmed, but still there: finding a command greyed with its reason beside it
                     beats not finding it and concluding it does not exist. -->
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="RowIcon" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="RowName" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanBind}" Value="False">
                    <Setter TargetName="BindButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanPin}" Value="False">
                    <Setter TargetName="PinButton" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CategoryRow">
            <DockPanel>
                <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Forward}"
                      Width="11" Height="11" Margin="12,0,2,0" Opacity="0.6"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11.5" Opacity="0.62"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Text}" Margin="26,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <v:PaletteRowTemplateSelector x:Key="RowTemplates"
                                      Heading="{StaticResource HeadingRow}"
                                      Entry="{StaticResource EntryRow}"
                                      Category="{StaticResource CategoryRow}"/>
    </UserControl.Resources>

    <!-- The whole window, so a press anywhere outside the panel closes it. Transparent rather than
         a scrim: dimming everything behind would need a colour of its own in every theme, and the
         panel's border already says what is in front. -->
    <Grid x:Name="Backdrop" Background="Transparent" MouseDown="Backdrop_MouseDown">
        <Border x:Name="Panel" MaxWidth="660" Margin="24,8,24,24"
                VerticalAlignment="Top"
                Background="{StaticResource Theme.Menu.Background}"
                BorderBrush="{StaticResource Theme.Border.Focus}" BorderThickness="1" CornerRadius="7"
                TextElement.Foreground="{StaticResource Theme.Menu.Foreground}"
                MouseDown="Panel_MouseDown"
                AutomationProperties.AutomationId="CommandPalette">
            <DockPanel>
                <!-- The field is the border; the box inside it has none of its own, so the icon can
                     sit in a column beside the text instead of under padding that has to be kept
                     in step with it. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource FieldBorder}" Height="Auto"
                        Margin="12,12,12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Palette}" Width="14" Height="14"
                              IsHitTestVisible="False"
                              Fill="{StaticResource Theme.Text.Secondary}"/>
                        <TextBox x:Name="QueryBox" Grid.Column="1" Padding="0,6,8,6" FontSize="14"
                                 BorderThickness="0" Background="Transparent"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="QueryBox_PreviewKeyDown"
                                 AutomationProperties.AutomationId="CommandPaletteBox"
                                 AutomationProperties.Name="Command palette"/>
                        <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="2,0,8,0" FontSize="14"
                                   Text="Type a command, a bookmark or a setting — or a path to go there"
                                   IsHitTestVisible="False" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource Theme.Text.Placeholder}"/>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="14,7"
                        BorderBrush="{StaticResource Theme.Menu.Separator}">
                    <TextBlock x:Name="HintText" Text="{Binding Hint}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Theme.Text.Muted}"/>
                </Border>

                <ListBox x:Name="RowList" MaxHeight="430"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource PaletteRow}"
                         ItemTemplateSelector="{StaticResource RowTemplates}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,0,6"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="RowList_PreviewMouseLeftButtonUp"
                         SelectionChanged="RowList_SelectionChanged"
                         AutomationProperties.AutomationId="CommandPaletteList"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
