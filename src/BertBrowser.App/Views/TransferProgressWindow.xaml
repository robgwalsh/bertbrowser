<v:ThemedWindow x:Class="BertBrowser.App.Views.TransferProgressWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:TransferProgressViewModel}"
                Title="Transfer" Width="520" Height="400" MinWidth="380" MinHeight="260"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="TransferProgress"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless, and closing it does not cancel: the transfer outlives the window, unlike the delete
      dialog's survey, which nothing depends on. Only Cancel cancels.
    -->
    <DockPanel Margin="16">

        <!-- What is happening right now. -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Headline}" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <ProgressBar Margin="0,10,0,0" Height="6"
                         Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Focusable="False" IsHitTestVisible="False"/>
            <DockPanel Margin="0,8,0,0">
                <!-- Blank rather than zero when the size index has no total for this plan: an
                     invented percentage is worse than an absent one. -->
                <TextBlock DockPanel.Dock="Left" Text="{Binding BytesText}"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding EtaText}" HorizontalAlignment="Right"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>
                <TextBlock Text="{Binding RateText}" Margin="12,0,0,0"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>
            </DockPanel>
        </StackPanel>

        <!-- Cancel is the only button, and it is not the default: stopping a transfer part-way
             should take a deliberate press, not a stray Enter. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="88"
                    Command="{Binding CancelCommand}"
                    ToolTip="Stop this transfer. Whatever has already been transferred stays, and can be undone."/>
            <Button DockPanel.Dock="Right" Content="Close" MinWidth="88" Margin="0,0,8,0"
                    IsCancel="True" Click="Close_Click"
                    ToolTip="Hide this window. The transfer carries on."/>
            <TextBlock/>
        </DockPanel>

        <!-- Every item, so a batch says which ones are through and which are still to come. -->
        <ListBox x:Name="ItemList" Margin="0,14,0,0" ItemsSource="{Binding Items}"
                 BorderThickness="1" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TransferItemRow}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Theme.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="waiting"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Working">
                                            <Setter Property="Text" Value="in progress"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Text" Value="done"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis"
                                       FontSize="11" Foreground="{StaticResource Theme.Text.Secondary}"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</v:ThemedWindow>
