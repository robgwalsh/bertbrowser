<v:ThemedWindow x:Class="BertBrowser.App.Views.ColumnPickerDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Title="Choose columns" Width="480" Height="560"
                MinWidth="360" MinHeight="320"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource Theme.Text.Secondary}"
                   Text="Every property this PC can read. A file that has no value for one shows nothing in its column."/>

        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="0,0,0,10"
                 TextChanged="Filter_Changed"/>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Foreground="{StaticResource Theme.Text.Secondary}"/>

        <ListBox x:Name="PropertyList" AutomationProperties.AutomationId="ColumnPickerList"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}" Margin="2">
                        <StackPanel>
                            <TextBlock Text="{Binding Display}"/>
                            <TextBlock Text="{Binding Canonical}" FontSize="11"
                                       Foreground="{StaticResource Theme.Text.Secondary}"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</v:ThemedWindow>
