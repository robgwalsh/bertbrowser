<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:BertBrowser.App.Converters"
                    xmlns:v="clr-namespace:BertBrowser.App.Views">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    <conv:DepthToIndentConverter x:Key="DepthToIndent" IndentSize="16"/>

    <!--
      Windows-native icon glyphs. Segoe Fluent Icons is the Windows 11 shell font;
      Segoe MDL2 Assets is the Windows 10 fallback (most codepoints are shared). Used
      via glyph codepoints (see the Segoe Fluent Icons glyph list) on toolbar buttons
      and menu items so icons inherit Foreground and stay crisp at any DPI.
    -->
    <FontFamily x:Key="SymbolFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Shared row colors so the folder tree and the file list highlight identically. -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#E5F3FB"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#CBE8F6"/>
    <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#BEE0F2"/>
    <SolidColorBrush x:Key="RowSelectedInactiveBrush" Color="#E9E9E9"/>
    <!-- The folder a drag is currently hovering: stronger than selection, so the drop target is
         unmistakable before the button is released. -->
    <SolidColorBrush x:Key="DropTargetBrush" Color="#B3DDF7"/>
    <SolidColorBrush x:Key="DropTargetBorderBrush" Color="#1C86D1"/>

    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="28"/>
    </Style>

    <!-- Icon glyph inside a toolbar button; inherits the button's Foreground. -->
    <Style x:Key="ToolbarIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Icon glyph for a MenuItem.Icon slot. -->
    <Style x:Key="MenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#444"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BreadcrumbButton" TargetType="Button">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- Rounded toolbar field, shared by the address bar and the search box. -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#BBB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="28"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="#1C86D1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ✕ inside the search box; hidden while the box is empty. -->
    <Style x:Key="SearchClearButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#666"/>
        <Setter Property="Padding" Value="6,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SearchText}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Explorer-style chevron expander for the folder tree. -->
    <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Glyph" Data="M 0,0 L 4.5,4.5 L 0,9"
                              Stroke="#8A8A8A" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Data" Value="M 0,0 L 4.5,4.5 L 9,0"/>
                            <Setter TargetName="Glyph" Property="Stroke" Value="#555555"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="#1C86D1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section header above each sidebar group (Bookmarks, Drives & devices). -->
    <Style x:Key="SidebarHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#888"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8,10,4"/>
    </Style>

    <!--
      Full-width folder tree rows: indentation is applied inside the row (from the
      node's Depth), so hover/selection highlight and click target span the whole
      horizontal extent of the panel, like the file list. Drives are ordinary rows —
      same chevron, hover, and selection as any nested folder.
    -->
    <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" MinHeight="26"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpanderStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition SourceName="Bd" Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedInactiveBrush}"/>
                        </MultiTrigger>
                        <!-- Last, so hovering a drag over a folder always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DropTargetBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File list rows use the same hover/selection colors as the folder tree. -->
    <Style x:Key="FileRowStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedInactiveBrush}"/>
                        </MultiTrigger>
                        <!-- Last, so hovering a drag over a row always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DropTargetBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DropTargetBorderBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Thumbnail (tile) view for the file list: a wrap of square previews with the name beneath.
      The tile and image size track FileList.ThumbnailSize so the footer slider resizes them live.
      App-level rather than per-window because every pane's file list looks these up by name from
      its own ApplyViewMode() — a Style/DataTemplate/ItemsPanelTemplate can be shared across
      controls, unlike the GridView and ContextMenu, which stay inline per list.
    -->
    <ItemsPanelTemplate x:Key="ThumbPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ThumbTileTemplate">
        <StackPanel Margin="6,6,6,2"
                    Width="{Binding DataContext.FileList.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListView}}">
            <Image Source="{Binding Thumbnail}" Opacity="{Binding IconOpacity}"
                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="{Binding DataContext.FileList.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                   Height="{Binding DataContext.FileList.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,4,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

    <!-- Full-width row for folders / non-media files, shown above the tiles. Its width
         tracks the scroll viewport so each row takes a whole line in the WrapPanel. -->
    <DataTemplate x:Key="ThumbRowTemplate">
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,3">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                       Opacity="{Binding IconOpacity}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="#555"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" Foreground="#555"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>
    </DataTemplate>

    <v:ThumbnailTemplateSelector x:Key="ThumbOrRowSelector"
                                 TileTemplate="{StaticResource ThumbTileTemplate}"
                                 RowTemplate="{StaticResource ThumbRowTemplate}"/>

    <Style x:Key="ThumbItemStyle" TargetType="ListViewItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedHoverBrush}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelectedInactiveBrush}"/>
                        </MultiTrigger>
                        <!-- Last, so a drag hovering a tile always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DropTargetBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
