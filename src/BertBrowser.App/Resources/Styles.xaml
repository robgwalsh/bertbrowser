<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:BertBrowser.App.Converters"
                    xmlns:v="clr-namespace:BertBrowser.App.Views"
                    xmlns:search="clr-namespace:BertBrowser.Core.Services.Search;assembly=BertBrowser.Core">

    <!-- Merged, not merely listed alongside in App.xaml: StaticResource resolves against a
         dictionary's own merged children, never its siblings. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!--
      The search syntax cheat-sheet, on both search boxes. Its rows come from
      SearchSyntax.Entries in Core — the same table the parser resolves keys against — so the
      help cannot advertise a filter that does not exist.

      x:Shared="False" is load-bearing: a ToolTip is an element instance, and one instance
      cannot be the tooltip of two elements (the same rule that keeps GridView and ContextMenu
      declared inline per ListView). This hands out a fresh one per request instead.
    -->
    <ToolTip x:Key="SearchSyntaxToolTip" x:Shared="False" MaxWidth="420">
        <StackPanel>
            <TextBlock Text="Filters" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{x:Static search:SearchSyntax.Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Example}" FontFamily="Consolas, Courier New, monospace"/>
                            <TextBlock Grid.Column="1" Text="{Binding Meaning}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Theme.Text.Secondary}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ToolTip>

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    <conv:NullToCollapsedConverter x:Key="NullToVisible" Invert="True"/>
    <conv:ByteSizeConverter x:Key="ByteSize"/>
    <conv:DepthToIndentConverter x:Key="DepthToIndent" IndentSize="16"/>
    <conv:ColorAlphaToOpacityConverter x:Key="ColorAlphaToOpacity"/>
    <conv:ColorToBrushConverter x:Key="ColorToBrush"/>

    <!--
      Windows-native icon glyphs. Segoe Fluent Icons is the Windows 11 shell font;
      Segoe MDL2 Assets is the Windows 10 fallback (most codepoints are shared). Used
      via glyph codepoints (see the Segoe Fluent Icons glyph list) on toolbar buttons
      and menu items so icons inherit Foreground and stay crisp at any DPI.
    -->
    <FontFamily x:Key="SymbolFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--
      The theme picker's rows, in Settings and in the theme editor. This has to be an ItemTemplate
      rather than DisplayMemberPath: a ComboBox renders its closed state from
      SelectionBoxItemTemplate, and WPF only derives that from ItemTemplate. DisplayMemberPath is
      honoured by the stock template's presenter alone, so under our own template (Theme/Controls/
      Inputs.xaml) the closed box falls back to ToString() and shows the type name.
    -->
    <DataTemplate x:Key="ThemeNameTemplate">
        <TextBlock Text="{Binding Name}"/>
    </DataTemplate>

    <!--
      Colours come from the theme (Resources/Theme/Theme.xaml), which is merged ahead of this file
      in App.xaml. The Theme.* brushes are shared, mutable instances: switching themes recolours
      them in place, so nothing here needs DynamicResource.
    -->

    <!--
      Every keyed Button style below is BasedOn the implicit one on purpose: an explicit Style
      replaces the implicit style outright, so without this they would fall back to WPF's default
      template and look classic again next to everything else.
    -->
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Toolbar.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource Theme.Toolbar.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource Theme.Toolbar.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Text that happens to be clickable, for the status bar: no chrome, no padding, just the link
      colour and a hand cursor. The status bar uses this so the indexing line can offer a retry
      without turning into a control that draws a box in the middle of a sentence.
    -->
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Link}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="TextBlock.TextDecorations" Value="Underline"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon glyph inside a toolbar button; inherits the button's Foreground. -->
    <Style x:Key="ToolbarIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Icon glyph for a MenuItem.Icon slot. -->
    <Style x:Key="MenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Menu.IconForeground}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BreadcrumbButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Primary}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- One segment of the preview pane's Auto / Raw / Hex selector. A segmented set rather than
         one cycling button: with three states, a button labelled with the current one cannot say
         what comes next. Which segment is on is set per button, since the condition differs. -->
    <Style x:Key="PreviewModeButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Rounded toolbar field, shared by the address bar and the search box. -->
    <Style x:Key="FieldBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Theme.Input.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Height" Value="28"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Theme.Border.Focus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      A field sitting in the title bar rather than on a page.

      `Theme.Input.Background` and `Theme.TitleBar.Background` are the same colour in Dark+
      (#3C3C3C), so the whole-PC field was invisible up there until it took focus — which did not
      matter while it was collapsed behind a button and matters a great deal now it is always on
      show. It therefore takes the *content* background instead: the field belongs to what you are
      looking at, not to the chrome around it, and that reads correctly in both directions — darker
      than the chrome in a dark theme, lighter in a light one, which is the well every OS draws a
      search box as.

      BasedOn keeps FieldBorder's height, radius and — the part worth being careful about — its
      focus trigger. The brushes are overridden with Setters rather than assigned on the element,
      because a local value outranks a Style trigger and would silently kill the focus highlight.
    -->
    <Style x:Key="HeaderFieldBorder" TargetType="Border" BasedOn="{StaticResource FieldBorder}">
        <Setter Property="Background" Value="{StaticResource Theme.Window.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Border.Subtle}"/>
    </Style>


    <!-- ✕ inside the search box; hidden while the box is empty. -->
    <Style x:Key="SearchClearButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SearchText}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The same ✕ for the header's whole-PC field. Not BasedOn SearchClearButton: that one's
         trigger names SearchText, which the shell (the header's DataContext) hasn't got. -->
    <Style x:Key="GlobalSearchClearButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="6,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ActiveTab.GlobalSearchText}" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Explorer-style chevron expander for the folder tree. -->
    <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="16" Height="16">
                        <Path x:Name="Glyph" Data="M 0,0 L 4.5,4.5 L 0,9"
                              Stroke="{StaticResource Theme.Tree.ChevronForeground}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Data" Value="M 0,0 L 4.5,4.5 L 9,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke"
                                    Value="{StaticResource Theme.Tree.ChevronHoverForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Section header above each sidebar group (Bookmarks, Drives & devices). -->
    <Style x:Key="SidebarHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8,10,4"/>
    </Style>

    <!--
      Full-width folder tree rows: indentation is applied inside the row (from the
      node's Depth), so hover/selection highlight and click target span the whole
      horizontal extent of the panel, like the file list. Drives are ordinary rows —
      same chevron, hover, and selection as any nested folder.
    -->
    <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" MinHeight="26"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{Binding Depth, Converter={StaticResource DepthToIndent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpanderStyle}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedForeground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition SourceName="Bd" Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedHoverBackground}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedInactiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedInactiveForeground}"/>
                        </MultiTrigger>
                        <!-- Last, so hovering a drag over a folder always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.DropBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- File list rows use the same hover/selection colors as the folder tree. -->
    <Style x:Key="FileRowStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedForeground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedHoverBackground}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedInactiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedInactiveForeground}"/>
                        </MultiTrigger>
                        <!-- Last, so hovering a drag over a row always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.DropBackground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Theme.List.DropBorder}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Thumbnail (tile) view for the file list: a wrap of previews with the name beneath.
      Tile width tracks FileList.ThumbnailSize so the footer slider resizes them live; the height
      is FileList.ThumbnailTileHeight, i.e. that width through the configured aspect ratio.
      App-level rather than per-window because every pane's file list looks these up by name from
      its own ApplyViewMode() — a Style/DataTemplate/ItemsPanelTemplate can be shared across
      controls, unlike the GridView and ContextMenu, which stay inline per list.
    -->
    <ItemsPanelTemplate x:Key="ThumbPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ThumbTileTemplate">
        <StackPanel Margin="6,6,6,2"
                    Width="{Binding DataContext.FileList.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListView}}">
            <!-- Shell thumbnails are authored for a light background; the tile behind them keeps a
                 transparent PNG or a pale photo from dissolving into a dark window. -->
            <Border Background="{StaticResource Theme.Thumbnail.TileBackground}" CornerRadius="2"
                    Width="{Binding DataContext.FileList.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                    Height="{Binding DataContext.FileList.ThumbnailTileHeight, RelativeSource={RelativeSource AncestorType=ListView}}">
                <Image Source="{Binding Thumbnail}" Opacity="{Binding IconOpacity}"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,4,0,0" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

    <!-- Full-width row for folders / non-media files, shown above the tiles. Its width
         tracks the scroll viewport so each row takes a whole line in the WrapPanel. -->
    <DataTemplate x:Key="ThumbRowTemplate">
        <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,3">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                       Opacity="{Binding IconOpacity}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <!-- Dimmed by opacity rather than a fixed colour, so it stays secondary against the
                 row's own background whether the row is plain, hovered or selected. -->
            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Opacity="0.7"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" Text="{Binding ModifiedDisplay}" Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
        </Grid>
    </DataTemplate>

    <v:ThumbnailTemplateSelector x:Key="ThumbOrRowSelector"
                                 TileTemplate="{StaticResource ThumbTileTemplate}"
                                 RowTemplate="{StaticResource ThumbRowTemplate}"/>

    <Style x:Key="ThumbItemStyle" TargetType="ListViewItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedForeground}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedHoverBackground}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.SelectedInactiveBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource Theme.List.SelectedInactiveForeground}"/>
                        </MultiTrigger>
                        <!-- Last, so a drag hovering a tile always wins over selection. -->
                        <Trigger Property="v:DropTarget.IsActive" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Theme.List.DropBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
