<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Theme.Menu.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Menu.Foreground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Menu.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- IsSharedSizeScope lines the icon and shortcut columns up across every item
                         in the menu, which is what stops the labels looking ragged. -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid Grid.IsSharedSizeScope="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The app has no menu bar, so only the two submenu roles are templated. If one is ever added,
      TopLevelHeader and TopLevelItem will need their own triggers here.
    -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Theme.Menu.Foreground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIconColumn"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGestureColumn"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                              Margin="10,0,0,0" Width="16"
                                              VerticalAlignment="Center"/>
                            <!--
                              A checkable item's tick, in the icon column the way Windows puts it.
                              Retemplating a MenuItem drops the stock check indicator along with
                              everything else, so without this IsCheckable/IsChecked set perfectly
                              and render nothing at all — the state is simply invisible.

                              Drawn inline rather than named from Icons.xaml, because StaticResource
                              reaches a dictionary's own merged children, never its siblings: this
                              file merges Primitives → Tokens, so naming that key here would fail at
                              load.
                            -->
                            <Path x:Name="Check" Visibility="Collapsed"
                                  Data="M 0,4.5 L 3.2,7.8 L 9,1.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Margin="10,0,0,0" Width="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="1" ContentSource="Header"
                                              Margin="10,6,10,6" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock x:Name="Gesture" Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Theme.Menu.GestureForeground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- After the Icon trigger, so a checked item with an icon shows the tick:
                             the two share a column and the check is the more useful of the two. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource Theme.Menu.HoverBackground}"/>
                            <Setter Property="Foreground"
                                    Value="{StaticResource Theme.Menu.HoverForeground}"/>
                            <Setter TargetName="Gesture" Property="Foreground"
                                    Value="{StaticResource Theme.Menu.HoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{StaticResource Theme.Menu.DisabledForeground}"/>
                            <Setter TargetName="Icon" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuIconColumn"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                                      Margin="10,0,0,0" Width="16"
                                                      VerticalAlignment="Center"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      Margin="10,6,10,6" VerticalAlignment="Center"
                                                      RecognizesAccessKey="True"/>
                                    <Path x:Name="Arrow" Grid.Column="2" Margin="0,0,10,0"
                                          VerticalAlignment="Center" Data="M 0,0 L 4,4 L 0,8"
                                          Stroke="{StaticResource Theme.Menu.GestureForeground}"
                                          StrokeThickness="1.3"/>
                                    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2"
                                           AllowsTransparency="True" Focusable="False"
                                           PopupAnimation="None"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border Background="{StaticResource Theme.Menu.Background}"
                                                BorderBrush="{StaticResource Theme.Menu.Border}"
                                                BorderThickness="1" Padding="0,4"
                                                SnapsToDevicePixels="True">
                                            <Grid Grid.IsSharedSizeScope="True">
                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource Theme.Menu.HoverBackground}"/>
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Theme.Menu.HoverForeground}"/>
                                    <Setter TargetName="Arrow" Property="Stroke"
                                            Value="{StaticResource Theme.Menu.HoverForeground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Theme.Menu.DisabledForeground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      Separators inside a menu resolve through MenuItem.SeparatorStyleKey, NOT through an implicit
      Separator style — miss this and every in-menu rule keeps the classic look while the standalone
      ones change.
    -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource Theme.Menu.Separator}"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{StaticResource Theme.Border.Subtle}"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips are used all over the app; a popup inherits nothing, so every colour is explicit. -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Theme.Overlay.Background}"/>
        <Setter Property="Foreground" Value="{StaticResource Theme.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Theme.Overlay.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="420" SnapsToDevicePixels="True">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
