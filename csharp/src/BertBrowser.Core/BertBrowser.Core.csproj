<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- Microsoft.Data.Sqlite 10.0.10 still resolves the native SQLite to 2.1.11, which carries
         GHSA-2m69-gcr7-jv3q (high). Pinning only the native library keeps the managed provider on
         the version Microsoft.Data.Sqlite expects. Drop this once the dependency ships a fixed
         lib.e_sqlite3 on its own; "dotnet list package" with the vulnerable and include-transitive
         flags says when, and NuGetAudit fails the build if it regresses. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Reading 7z, rar, tar and the rest. MIT, and its net10.0 target group carries no
         transitive dependencies at all (net48/netstandard2.0 carry four; we take neither).
         Reached from exactly one class, Services/Archives/ArchiveReader.cs, which is what makes
         it replaceable — see the Archives section of CLAUDE.md for why this dependency exists
         where Markdig and PdfPig deliberately do not. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- CRC32, and only CRC32. It is the one algorithm of the five the checksum tool offers that
         .NET does not ship: MD5, SHA-1, SHA-256 and SHA-512 all come from IncrementalHash. MIT,
         published by Microsoft, and reached from exactly one class — Services/Checksums/DigestSink.cs
         — which is what makes it replaceable by the forty lines of table-driven CRC32 it saves us
         writing. Note its GetHashAndReset is little-endian; see Crc32DigestSink for why that matters. -->
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <!-- Reading and writing audio tags: ID3v2, Vorbis comments, MP4 atoms, ASF, APE. MIT, and
         reached from exactly one class, Services/Metadata/AudioTagCodec.cs. Ten container formats
         each with its own tag layout is the SharpCompress case over again, not the Markdig one —
         where the image codecs beside it are ours, because splicing a JPEG segment is small and
         nothing MIT does it without re-encoding the picture. -->
    <PackageReference Include="z440.atl.core" Version="7.18.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BertBrowser.Core.Tests" />
    <!-- The UI harness is the other half of verification, and reaches ArchiveFixtures for the
         containers nothing in the graph can write. One copy of those bytes, so a script and a
         unit test cannot disagree about what they are looking at. -->
    <InternalsVisibleTo Include="BertBrowser.Harness" />
    <!-- The benchmark tool measures internals the tests already see — the MFT builders, the
         digest sinks, the glob matcher — rather than making them public for its sake. -->
    <InternalsVisibleTo Include="BertBrowser.Bench" />
  </ItemGroup>

</Project>
