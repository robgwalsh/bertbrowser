<v:ThemedWindow x:Class="BertBrowser.App.Views.ChangeTimelineWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:ch="clr-namespace:BertBrowser.Core.Services.Changes;assembly=BertBrowser.Core"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:ChangeTimelineViewModel}"
                Title="What changed" Width="880" Height="600" MinWidth="620" MinHeight="360"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="ChangeTimeline"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless, for the reason the disk-usage view is — and more so: this is read while the changes
      are still happening, with the installer or build that causes them running behind it.
    -->
    <v:ThemedWindow.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" CanExecute="Copy_CanExecute"/>
    </v:ThemedWindow.CommandBindings>

    <DockPanel Margin="14">

        <!-- Where we are looking, and the mark. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" MinWidth="70" Margin="8,0,0,0"
                    Command="{Binding RefreshCommand}"/>
            <Button DockPanel.Dock="Right" Content="Mark now" MinWidth="80" Margin="8,0,0,0"
                    Command="{Binding MarkNowCommand}"
                    ToolTip="Remember this moment, then show only what changes after it — press it before running an installer"
                    AutomationProperties.AutomationId="ChangeTimelineMark"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding MarkText}" Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Theme.Text.Secondary}"/>
            <TextBlock Text="{Binding ScopeDisplay}" VerticalAlignment="Center"
                       FontSize="14" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="ChangeTimelineScope"/>
        </DockPanel>

        <!-- How far back, and which kinds. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <!-- ItemTemplate, not DisplayMemberPath: the themed ComboBox draws its closed state from
                 SelectionBoxItemTemplate, which WPF derives from ItemTemplate alone. -->
            <ComboBox DockPanel.Dock="Left" Width="140" VerticalAlignment="Center"
                      ItemsSource="{Binding RangeOptions}"
                      SelectedValue="{Binding Range}"
                      SelectedValuePath="Range"
                      AutomationProperties.Name="Range">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="Created" IsChecked="{Binding ShowCreated}"/>
            <CheckBox DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                      Content="Modified" IsChecked="{Binding ShowModified}"/>
            <CheckBox DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                      Content="Deleted" IsChecked="{Binding ShowDeleted}"/>
            <CheckBox DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                      Content="Renamed" IsChecked="{Binding ShowRenamed}"/>
            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="Hidden items" IsChecked="{Binding IncludeHidden}"
                      ToolTip="Include files and folders that are hidden, or sit under a hidden folder"/>
            <TextBlock/>
        </DockPanel>

        <!--
          The banner: four things can stop this answering and they get four wordings, because a
          feature that is switched off must not look like a quiet disk. Bottom-docked so it can
          appear and disappear without moving the list, as in the disk-usage view.
        -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource Theme.Warning.Background}"
                BorderBrush="{StaticResource Theme.Warning.Border}" BorderThickness="1"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="ChangeTimelineBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Try again" MinWidth="80" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                <Button DockPanel.Dock="Right" Content="Settings…" MinWidth="80" Margin="10,0,0,0"
                        VerticalAlignment="Center" Click="OpenSettings_Click"
                        Visibility="{Binding CanOpenSettings, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="ChangeTimelineSettings"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.Warning.Foreground}"/>
            </DockPanel>
        </Border>

        <!-- Reserved height, so a count appearing does not move the list. -->
        <Border DockPanel.Dock="Bottom" Height="16" Margin="0,6,0,0">
            <TextBlock FontSize="11" Text="{Binding SummaryText}"
                       Foreground="{StaticResource Theme.Text.Secondary}"
                       AutomationProperties.AutomationId="ChangeTimelineSummary"/>
        </Border>

        <!-- The bar's space is reserved the same way, for the same reason as the disk-usage view. -->
        <Border DockPanel.Dock="Top" Height="2" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Background="Transparent" BorderThickness="0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Border>

        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <!-- An unexplained blank list reads as a failure, so it says why it is empty. -->
                <TextBlock Text="{Binding EmptyMessage}" Margin="10" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           AutomationProperties.AutomationId="ChangeTimelineEmpty"/>

                <ListBox x:Name="RowList" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Rows}"
                         SelectionMode="Extended"
                         MouseDoubleClick="Row_DoubleClick"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.AutomationId="ChangeTimelineRows">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                              The tint is on a border inside the row rather than on the container,
                              so it composites over the hover and selection colours the themed
                              ListBoxItem already draws — the same reading the compare tints make.
                            -->
                            <Border CornerRadius="2" Padding="6,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static ch:ChangeKind.Created}">
                                                <Setter Property="Background" Value="{StaticResource Theme.Change.Created}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static ch:ChangeKind.Modified}">
                                                <Setter Property="Background" Value="{StaticResource Theme.Change.Modified}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static ch:ChangeKind.Deleted}">
                                                <Setter Property="Background" Value="{StaticResource Theme.Change.Deleted}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static ch:ChangeKind.Renamed}">
                                                <Setter Property="Background" Value="{StaticResource Theme.Change.Renamed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding KindLabel}" VerticalAlignment="Top" FontSize="11"
                                               Margin="0,1,8,0"
                                               Foreground="{StaticResource Theme.Text.Secondary}"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="{Binding RenamedFrom, Mode=OneWay}" FontSize="11"
                                                 Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Folder}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" Margin="10,0,0,0"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               ToolTip="{Binding WhenTooltip}"/>

                                    <TextBlock Grid.Column="3" Text="{Binding WhenText}" Margin="12,0,0,0"
                                               MinWidth="72" TextAlignment="Right" VerticalAlignment="Top"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               ToolTip="{Binding WhenTooltip}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
