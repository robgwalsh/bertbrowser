<v:ThemedWindow x:Class="BertBrowser.App.Views.UndoHistoryWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
                Title="Undo history" Width="760" Height="560" MinWidth="520" MinHeight="320"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="UndoHistory"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless, like the change timeline: it is read while working, with the folders it describes
      open behind it. Bound to the shell rather than to the history alone, because Undo and Redo
      here are the very same commands Ctrl+Z and Ctrl+Y run.
    -->
    <v:ThemedWindow.Resources>

        <!-- The divider at the cursor: undone above it, in effect below it. -->
        <DataTemplate DataType="{x:Type vm:UndoCursorMarker}">
            <DockPanel Margin="4,6" AutomationProperties.AutomationId="UndoHistoryCursor">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Text}" FontSize="11" Margin="0,0,8,0"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>
                <Border Height="1" VerticalAlignment="Center" Background="{StaticResource Theme.Border.Default}"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UndoEntryViewModel}">
            <Border x:Name="Row" CornerRadius="3" Padding="8,6" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Path x:Name="KindIcon" Style="{StaticResource IconPath}" VerticalAlignment="Top"
                          Margin="0,1,0,0" HorizontalAlignment="Left"
                          Data="{Binding Icon}"/>

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,0" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource Theme.Button.SecondaryBackground}"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                           Foreground="{StaticResource Theme.Button.SecondaryForeground}"/>
                            </Border>
                            <TextBlock x:Name="Title" Text="{Binding Description}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource Theme.Text.Secondary}" Margin="0,2,0,0">
                            <Run Text="{Binding WhenText, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding ItemsText, Mode=OneWay}"/>
                            <Run x:Name="HeldRun" Text="{Binding HeldText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding LastProblem}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{StaticResource Theme.Warning.Foreground}"
                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <!-- What can be done from this row. Undo to here on what is in effect, Redo to
                         here on what has been undone — never both, since only one side of the
                         cursor is reachable from each. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="Undo to here" Margin="0,0,12,0"
                                Command="{Binding UndoToHereCommand}"
                                AutomationProperties.Name="{Binding Description, StringFormat='Undo to {0}'}"
                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Redo to here" Margin="0,0,12,0"
                                Command="{Binding RedoToHereCommand}"
                                AutomationProperties.Name="{Binding Description, StringFormat='Redo to {0}'}"
                                Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <Button Style="{StaticResource LinkButton}" Content="Show" Margin="0,0,12,0"
                                Click="Reveal_Click"
                                ToolTip="Open the folder this happened in"/>
                        <Button Style="{StaticResource LinkButton}" Content="{Binding ExpandText}"
                                Command="{Binding ToggleExpandedCommand}"/>
                    </StackPanel>

                    <!-- Every item, only once asked for, and capped in the view model. -->
                    <ItemsControl Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0"
                                  ItemsSource="{Binding Details}"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Theme.Text.Secondary}" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Undone rows recede: they are what Redo would bring back, not what is on disk. -->
                <DataTrigger Binding="{Binding IsDone}" Value="False">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
                    <Setter TargetName="KindIcon" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <!-- The next undo is what Ctrl+Z will take back, so it is the one row marked. -->
                <DataTrigger Binding="{Binding IsNextUndo}" Value="True">
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Theme.List.HoverBackground}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </v:ThemedWindow.Resources>

    <DockPanel Margin="14">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0"
                    Command="{Binding RedoCommand}" ToolTip="{Binding RedoDescription}"
                    AutomationProperties.AutomationId="UndoHistoryRedo">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}" Margin="0,0,6,0"/>
                    <TextBlock Text="Redo"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0"
                    Command="{Binding UndoCommand}" ToolTip="{Binding UndoDescription}"
                    AutomationProperties.AutomationId="UndoHistoryUndo">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}" Margin="0,0,6,0"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="This session's moves, renames, deletes, pastes, archive edits and syncs"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock FontSize="11" Foreground="{StaticResource Theme.Text.Secondary}" TextWrapping="Wrap"
                           Text="Undoing an older action undoes everything after it first, newest to oldest."/>
            </StackPanel>
        </DockPanel>

        <!-- The budget, and what it has already cost. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Clear history…" MinWidth="110" Margin="8,0,0,0"
                    Click="Clear_Click"
                    IsEnabled="{Binding History.HasEntries}"
                    AutomationProperties.AutomationId="UndoHistoryClear"
                    ToolTip="Commit everything the history is holding. None of it can be undone afterwards."/>
            <Button DockPanel.Dock="Right" Content="Limits…" MinWidth="80" Margin="8,0,0,0"
                    Click="Limits_Click"
                    ToolTip="How many actions, and how much set-aside data, the history keeps"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding History.FooterText}" FontSize="11"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           AutomationProperties.AutomationId="UndoHistoryFooter"/>
                <TextBlock Text="{Binding History.ReleasedText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           Visibility="{Binding History.ReleasedText, Converter={StaticResource NullToCollapsed}}"/>
            </StackPanel>
        </DockPanel>

        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <!-- An unexplained blank list reads as a failure, so it says why it is empty. -->
                <TextBlock Margin="10" TextWrapping="Wrap" VerticalAlignment="Top"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           Visibility="{Binding History.HasEntries, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Nothing to undo yet. Moves, renames, deletes, merged pastes, archive edits and syncs appear here as you make them, and stay until BertBrowser closes."/>

                <ListBox BorderThickness="0" Background="Transparent" Padding="4"
                         ItemsSource="{Binding History.Rows}"
                         Focusable="False"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         AutomationProperties.AutomationId="UndoHistoryRows">
                    <!-- A history row is not a selectable thing; its own links are what act. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
