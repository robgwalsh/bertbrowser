<v:ThemedWindow x:Class="BertBrowser.App.Views.DuplicatesWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}"
                Title="Duplicates" Width="900" Height="640" MinWidth="620" MinHeight="400"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="Duplicates"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless for the reason the disk-usage view is: acting on what it says means going to a folder
      in a tab behind it, and a modal window would cover the thing being judged. It also outlives a
      long scan, which a dialog could not.
    -->
    <DockPanel Margin="14">

        <!-- What is being searched, and the knobs that change what counts. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" MinWidth="70" Margin="8,0,0,0"
                    Content="Stop"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            <Button DockPanel.Dock="Right" MinWidth="70" Margin="8,0,0,0"
                    Content="Scan"
                    Command="{Binding ScanCommand}"
                    AutomationProperties.AutomationId="DuplicatesScan"/>

            <TextBlock Text="{Binding RootDisplay}" VerticalAlignment="Center"
                       FontSize="14" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="DuplicatesRoot"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Ignore files under" VerticalAlignment="Center"
                       Margin="0,0,6,0" Foreground="{StaticResource Theme.Text.Secondary}"/>
            <ComboBox DockPanel.Dock="Left" Width="96" VerticalAlignment="Center"
                      ItemsSource="{Binding MinSizeOptions}"
                      SelectedValue="{Binding MinSizeBytes}"
                      SelectedValuePath="Bytes"
                      AutomationProperties.Name="Minimum file size">
                <!-- ItemTemplate, not DisplayMemberPath: the closed box renders
                     SelectionBoxItemTemplate, which WPF derives from ItemTemplate alone, and the
                     DisplayMemberPath fallback lives in the stock presenter this one replaces. -->
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="Skip Windows and Program Files"
                      IsChecked="{Binding SkipSystemFolders}"
                      ToolTip="Those folders are largely one file under several names, and their duplicates are not yours to remove."/>

            <TextBlock/>
        </DockPanel>

        <!--
          The banner, where an unusable answer is explained rather than shown as an empty list. Its
          three wordings are the three ways this can fail and are deliberately distinct: a drive
          indexed by name only must not read like a tidy one.
        -->
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10,7" CornerRadius="3"
                Background="{StaticResource Theme.Warning.Background}"
                BorderBrush="{StaticResource Theme.Warning.Border}" BorderThickness="1"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="DuplicatesBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Try again" MinWidth="80" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource Theme.Warning.Foreground}"/>
            </DockPanel>
        </Border>

        <!-- The totals, the auto-selection helpers, and the one destructive button. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" MinWidth="150" Margin="8,0,0,0"
                    Content="Delete selected copies…"
                    Command="{Binding RemoveTickedCommand}"
                    AutomationProperties.AutomationId="DuplicatesRemove"/>
            <Button DockPanel.Dock="Right" MinWidth="60" Margin="8,0,0,0"
                    Content="None" Command="{Binding ClearSelectionCommand}"
                    ToolTip="Clear every tick"/>
            <Button DockPanel.Dock="Right" MinWidth="90" Margin="8,0,0,0"
                    Content="Keep oldest" Command="{Binding KeepOldestCommand}"
                    ToolTip="Tick every copy but the least recently modified one in each group"/>
            <Button DockPanel.Dock="Right" MinWidth="90" Margin="8,0,0,0"
                    Content="Keep newest" Command="{Binding KeepNewestCommand}"
                    ToolTip="Tick every copy but the most recently modified one in each group"/>
            <Button DockPanel.Dock="Right" MinWidth="110" Margin="8,0,0,0"
                    Content="Keep shallowest" Command="{Binding KeepShallowestCommand}"
                    ToolTip="Tick every copy but the one nearest the top of the tree"/>

            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="DuplicatesSummary"/>
        </DockPanel>

        <!-- Said separately from the banner: the answer below is usable, just short. -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Caveat}" Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Theme.Text.Secondary}"
                   Visibility="{Binding HasCaveat, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="DuplicatesCaveat"/>

        <!--
          Progress lives in a container that is always there, so its space is reserved whether a
          scan is running or not — otherwise starting one would take the list's own height away and
          hand it back at the end, jumping the whole window twice per scan.
        -->
        <Border DockPanel.Dock="Top" Height="34" Margin="0,0,0,8">
            <DockPanel Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="DuplicatesProgress">
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Run Text="{Binding ProgressHeadline, Mode=OneWay}"/>
                    <Run Text="{Binding ProgressDetail, Mode=OneWay}"
                         Foreground="{StaticResource Theme.Text.Secondary}"/>
                </TextBlock>
                <ProgressBar Height="6" Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
            </DockPanel>
        </Border>

        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <!-- An unexplained blank panel reads as a failure, so it says why it is empty. -->
                <TextBlock Text="{Binding EmptyMessage}" Margin="10" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource Theme.Text.Secondary}"/>

                <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Groups}"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                         AutomationProperties.AutomationId="DuplicatesGroups">
                    <!-- A group is not a selectable thing; the copies inside it are what act. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4,4,4,10" Padding="8,6" CornerRadius="3"
                                    Background="{StaticResource Theme.Surface.Raised}"
                                    BorderBrush="{StaticResource Theme.Border.Subtle}"
                                    BorderThickness="1">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding WastedDisplay}"
                                                   Margin="10,0,0,0"
                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2" Background="Transparent"
                                                      MouseDown="Copy_MouseDown">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox VerticalAlignment="Center"
                                                              Margin="0,0,8,0"
                                                              IsChecked="{Binding IsTicked}"
                                                              IsEnabled="{Binding CanTick}"
                                                              ToolTip="Mark this copy to be deleted"
                                                              AutomationProperties.Name="{Binding FullPath}"/>

                                                    <Image Grid.Column="1" Source="{Binding Item.Icon}"
                                                           Width="16" Height="16" Margin="0,0,8,0"
                                                           VerticalAlignment="Top"
                                                           SnapsToDevicePixels="True"/>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding Item.Name}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FolderDisplay}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Theme.Text.Secondary}"/>
                                                        <!-- Not a copy: removing it reclaims nothing,
                                                             which the row has to say out loud. -->
                                                        <TextBlock Text="{Binding HardlinkNote}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource Theme.Text.Muted}"
                                                                   Visibility="{Binding IsHardlinked, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Item.ModifiedDisplay}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Top"
                                                               Foreground="{StaticResource Theme.Text.Secondary}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
