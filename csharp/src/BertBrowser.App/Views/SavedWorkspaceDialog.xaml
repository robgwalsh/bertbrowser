<v:ThemedWindow x:Class="BertBrowser.App.Views.SavedWorkspaceDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Title="Save workspace" Width="400" SizeToContent="Height" MinHeight="140"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Save" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Name" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" TextChanged="Field_TextChanged"
                     AutomationProperties.AutomationId="SavedWorkspaceName"/>

            <TextBlock x:Name="ProblemText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Error.Foreground}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</v:ThemedWindow>
