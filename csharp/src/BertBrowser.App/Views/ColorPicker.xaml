<UserControl x:Class="BertBrowser.App.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236">
    <!--
      Hand-rolled because WPF has no colour picker. Saturation/value square, hue strip, alpha strip,
      hex box. The maths lives in Core (ThemeColor.ToHsv/FromHsv) where it is unit-tested; this is
      only the mouse plumbing.
    -->
    <StackPanel Margin="10">
        <Border x:Name="SaturationValueArea" Height="140" Cursor="Cross"
                BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                MouseLeftButtonDown="Area_MouseDown" MouseMove="Area_MouseMove"
                MouseLeftButtonUp="Area_MouseUp">
            <Grid>
                <!-- Pure hue, then white washed out to the left, then black down the bottom. -->
                <Rectangle x:Name="HueFill"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF"/>
                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#00000000"/>
                            <GradientStop Offset="1" Color="#FF000000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="SaturationValueCanvas" ClipToBounds="False">
                    <Ellipse x:Name="SaturationValueThumb" Width="11" Height="11"
                             Stroke="White" StrokeThickness="2" IsHitTestVisible="False">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="3" ShadowDepth="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <Border x:Name="HueArea" Height="14" Margin="0,10,0,0" Cursor="Hand"
                BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                MouseLeftButtonDown="Area_MouseDown" MouseMove="Area_MouseMove"
                MouseLeftButtonUp="Area_MouseUp">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0.000" Color="#FF0000"/>
                            <GradientStop Offset="0.167" Color="#FFFF00"/>
                            <GradientStop Offset="0.333" Color="#00FF00"/>
                            <GradientStop Offset="0.500" Color="#00FFFF"/>
                            <GradientStop Offset="0.667" Color="#0000FF"/>
                            <GradientStop Offset="0.833" Color="#FF00FF"/>
                            <GradientStop Offset="1.000" Color="#FF0000"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas ClipToBounds="False">
                    <Rectangle x:Name="HueThumb" Width="3" Height="18" Canvas.Top="-3"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <Border x:Name="AlphaArea" Height="14" Margin="0,8,0,0" Cursor="Hand"
                BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                MouseLeftButtonDown="Area_MouseDown" MouseMove="Area_MouseMove"
                MouseLeftButtonUp="Area_MouseUp">
            <Grid>
                <!-- Checkerboard so a partly transparent colour reads as transparent. -->
                <Rectangle x:Name="Checkerboard"/>
                <Rectangle x:Name="AlphaFill"/>
                <Canvas ClipToBounds="False">
                    <Rectangle x:Name="AlphaThumb" Width="3" Height="18" Canvas.Top="-3"
                               Fill="White" Stroke="Black" StrokeThickness="1"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <DockPanel Margin="0,10,0,0">
            <Border DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,8,0"
                    BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1">
                <Grid>
                    <Rectangle x:Name="PreviewCheckerboard"/>
                    <Rectangle x:Name="PreviewFill"/>
                </Grid>
            </Border>
            <TextBox x:Name="HexBox" VerticalContentAlignment="Center"
                     ToolTip="#RRGGBB or #AARRGGBB"
                     AutomationProperties.Name="Colour hex value"
                     TextChanged="HexBox_TextChanged"/>
        </DockPanel>
    </StackPanel>
</UserControl>
