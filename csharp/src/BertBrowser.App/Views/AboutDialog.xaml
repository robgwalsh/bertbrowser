<v:ThemedWindow x:Class="BertBrowser.App.Views.AboutDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Title="About BertBrowser" Width="360" SizeToContent="Height" MinHeight="140"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <DockPanel Margin="20,18,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" MinWidth="88" IsCancel="True" IsDefault="True"/>
        </StackPanel>

        <Image x:Name="Logo" DockPanel.Dock="Left" Width="48" Height="48" Margin="0,2,16,0"
               VerticalAlignment="Top"/>

        <StackPanel>
            <TextBlock Text="BertBrowser" FontSize="18" FontWeight="SemiBold"/>
            <!-- The version, and with it the channel: an unstable build's version says so. This
                 is where the title bar used to show it. -->
            <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                       AutomationProperties.AutomationId="AboutVersion"/>
            <TextBlock x:Name="ChannelText" Margin="0,2,0,0"
                       Foreground="{StaticResource Theme.Text.Secondary}"/>
        </StackPanel>
    </DockPanel>
</v:ThemedWindow>
