<v:ThemedWindow x:Class="BertBrowser.App.Views.ChecksumWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:ChecksumViewModel}"
                Title="{Binding Title}" Width="720" Height="560" MinWidth="520" MinHeight="360"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="Checksums"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless, for the reason the duplicates window is: hashing a large selection under five
      algorithms outlives a dialog, and what you do with a digest is compare it against a browser
      tab — a modal that owns the app while you go and find it is the wrong shape.
    -->
    <v:ThemedWindow.Resources>
        <Style x:Key="DigestLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Theme.Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <!-- Read-only borderless TextBox so a digest stays selectable and copyable. -->
        <Style x:Key="DigestValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </v:ThemedWindow.Resources>

    <DockPanel Margin="14">

        <!-- Which algorithms. Tick boxes rather than a dropdown, because computing several in one
             read pass is the feature and a single-select control would hide it. -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Algorithms}" Margin="0,0,0,10"
                      AutomationProperties.AutomationId="ChecksumAlgorithms">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Label}"/>
                        <TextBlock Text="{Binding Note}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Theme.Text.Secondary}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- A checksum file that half parsed, or one that could not be read at all. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="3" Padding="8,6"
                Background="{StaticResource Theme.Warning.Background}"
                BorderBrush="{StaticResource Theme.Warning.Border}" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="ChecksumBanner">
            <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap"/>
        </Border>

        <!-- Progress lives in a container that is always there, so starting a run does not take the
             list's height away and hand it back at the end, jumping the window twice per run. -->
        <Border DockPanel.Dock="Top" Height="34" Margin="0,0,0,8">
            <DockPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="ChecksumProgress">
                <Button DockPanel.Dock="Right" MinWidth="70" Margin="8,0,0,0" Content="Stop"
                        Command="{Binding CancelCommand}"
                        AutomationProperties.AutomationId="ChecksumStop"/>
                <StackPanel>
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="{Binding ProgressHeadline, Mode=OneWay}"/>
                        <Run Text="{Binding ProgressDetail, Mode=OneWay}"
                             Foreground="{StaticResource Theme.Text.Secondary}"/>
                    </TextBlock>
                    <ProgressBar Height="6" Minimum="0" Maximum="1"
                                 Value="{Binding ProgressFraction, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The bottom bar. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Content="Close"
                    IsCancel="True"/>
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Content="Save as…"
                    Command="{Binding SaveCommand}"
                    ToolTip="Write these digests to a checksum file."
                    AutomationProperties.AutomationId="ChecksumSave"/>
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Content="Copy all"
                    Command="{Binding CopyAllCommand}"/>
            <Button DockPanel.Dock="Left" MinWidth="70" Content="Hash"
                    Command="{Binding RunCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}"
                    AutomationProperties.AutomationId="ChecksumRun"/>
            <TextBlock Text="{Binding VerifySummary}" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="ChecksumVerifySummary"/>
        </DockPanel>

        <!-- Paste a published checksum. One box for the window rather than one per file: with many
             files the useful question is not "does this match" but "which of these is it for". -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"
                   Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}">
            <TextBlock DockPanel.Dock="Left" Text="Compare:" Style="{StaticResource DigestLabel}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding PasteVerdict}" Margin="10,0,0,0"
                       VerticalAlignment="Center" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="ChecksumPasteVerdict">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Theme.Error.Foreground}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PasteMatched}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Theme.Text.Primary}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox Text="{Binding ExpectedInput, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" VerticalContentAlignment="Center"
                     ToolTip="Paste a checksum from a download page. Its length says which algorithm it is."
                     AutomationProperties.AutomationId="ChecksumPaste"/>
        </DockPanel>

        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1"
                CornerRadius="3">
            <Grid>
                <!-- An unexplained blank panel reads as a failure, so it says why it is empty. -->
                <TextBlock Text="{Binding EmptyMessage}" Margin="10" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>

                <ListBox x:Name="RowList" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Rows}"
                         HorizontalContentAlignment="Stretch"
                         Grid.IsSharedSizeScope="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="ChecksumRows">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,5" Padding="9,7" CornerRadius="3"
                                    Background="{StaticResource Theme.Surface.Raised}">
                                <StackPanel>
                                    <!-- The file. -->
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}"
                                               Width="20" Height="20" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Margin="8,0,0,0"
                                                CornerRadius="3" Padding="6,1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding VerifyState, Converter={StaticResource NullToCollapsed}}">
                                            <!-- Existing tokens only: the comparison's own green for
                                                 a pass, the feedback palette for the three kinds of
                                                 failure. Nothing new to contrast-check. -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Theme.Compare.Unknown}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VerifyState}" Value="Ok">
                                                            <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VerifyState}" Value="Mismatch">
                                                            <Setter Property="Background" Value="{StaticResource Theme.Error.Background}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VerifyState}" Value="Missing">
                                                            <Setter Property="Background" Value="{StaticResource Theme.Warning.Background}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VerifyState}" Value="Unreadable">
                                                            <Setter Property="Background" Value="{StaticResource Theme.Warning.Background}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VerifyState}" Value="Refused">
                                                            <Setter Property="Background" Value="{StaticResource Theme.Warning.Background}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Text="{Binding VerifyState}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding VerifyDetail}" Margin="28,3,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               Visibility="{Binding VerifyDetail, Converter={StaticResource NullToCollapsed}}"/>

                                    <TextBlock Text="{Binding ErrorMessage}" Margin="28,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Theme.Text.Secondary}"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- One row per algorithm. Shared-size columns so the labels
                                         line up down the whole list, not just inside one card. -->
                                    <ItemsControl ItemsSource="{Binding Digests}" Margin="28,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Algo"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Style="{StaticResource DigestLabel}"/>
                                                    <Border Grid.Column="1" CornerRadius="2" Padding="2,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPasteMatch}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBox Text="{Binding Digest, Mode=OneWay}"
                                                                 Style="{StaticResource DigestValue}"/>
                                                    </Border>
                                                    <Button Grid.Column="2" Content="Copy" Padding="10,2"
                                                            Margin="8,0,0,0" Command="{Binding CopyCommand}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
