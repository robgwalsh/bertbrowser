<v:ThemedWindow x:Class="BertBrowser.App.Views.FileCompareWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                xmlns:vm="clr-namespace:BertBrowser.App.ViewModels"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d"
                d:DataContext="{d:DesignInstance Type=vm:FileCompareViewModel}"
                Title="Compare files" Width="1100" Height="700" MinWidth="640" MinHeight="360"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                AutomationProperties.AutomationId="FileCompare"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <!--
      Modeless: it outlives a byte comparison of two disc images, and it is read while browsing the
      folders the two came from.
    -->
    <v:ThemedWindow.InputBindings>
        <KeyBinding Key="F3" Command="{Binding NextDifferenceCommand}"/>
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding PreviousDifferenceCommand}"/>
        <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding NextDifferenceCommand}"/>
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding PreviousDifferenceCommand}"/>
    </v:ThemedWindow.InputBindings>

    <DockPanel Margin="14">

        <!-- Which two files, and which way round. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding LeftName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LeftPath}"
                       AutomationProperties.AutomationId="CompareLeftName"/>
            <Button Grid.Column="1" Margin="10,0" Padding="8,1" Content="Swap"
                    Command="{Binding SwapCommand}" ToolTip="Put each file on the other side."/>
            <TextBlock Grid.Column="2" Text="{Binding RightName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RightPath}"
                       AutomationProperties.AutomationId="CompareRightName"/>
        </Grid>

        <!-- The answer to the question that was asked. Always present, always above the fold. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="3" Padding="9,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Theme.Compare.Differs}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsIdentical}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="CompareVerdict"/>
        </Border>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="3" Padding="8,6"
                Background="{StaticResource Theme.Warning.Background}"
                BorderBrush="{StaticResource Theme.Warning.Border}" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="CompareBanner">
            <TextBlock Text="{Binding BannerMessage}" TextWrapping="Wrap"/>
        </Border>

        <!-- Navigation and the two toggles. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Content="Close" IsCancel="True"/>
            <Button DockPanel.Dock="Left" MinWidth="34" Content="&#x2191;"
                    ToolTip="Previous difference (Shift+F3)"
                    Command="{Binding PreviousDifferenceCommand}"
                    AutomationProperties.Name="Previous difference"/>
            <Button DockPanel.Dock="Left" MinWidth="34" Margin="6,0,0,0" Content="&#x2193;"
                    ToolTip="Next difference (F3)"
                    Command="{Binding NextDifferenceCommand}"
                    AutomationProperties.Name="Next difference"/>
            <TextBlock DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding DifferenceCounter}"
                       Foreground="{StaticResource Theme.Text.Secondary}"
                       AutomationProperties.AutomationId="CompareCounter"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                <Button Content="Show as text anyway" Padding="10,2" Margin="0,0,10,0"
                        Command="{Binding ShowAsTextCommand}"
                        Visibility="{Binding CanForceText, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="CompareForceText"/>
                <CheckBox Content="Ignore trailing spaces" VerticalAlignment="Center" Margin="0,0,12,0"
                          IsChecked="{Binding IgnoreWhitespace}"
                          Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"/>
                <CheckBox Content="Ignore case" VerticalAlignment="Center"
                          IsChecked="{Binding IgnoreCase}"
                          Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DockPanel>

        <Border BorderBrush="{StaticResource Theme.Border.Default}" BorderThickness="1" CornerRadius="3">
            <Grid>
                <TextBlock Text="Comparing…" Margin="10" VerticalAlignment="Top"
                           Foreground="{StaticResource Theme.Text.Secondary}"
                           Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}"/>

                <!--
                  One list, not two. Two scrollers plus a ScrollChanged handler is a feedback loop
                  needing a re-entrancy guard, it breaks the moment rows differ in height, and it
                  cannot align at all where one side is blank. A single virtualising list whose row
                  holds both halves makes the synchronisation structural: there is nothing to
                  synchronise.
                -->
                <ListBox x:Name="DiffRows" BorderThickness="0" Background="Transparent"
                         ItemsSource="{Binding Rows}"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="CompareRows">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinWidth="600">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding LeftNumber}"
                                           FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                           Padding="0,0,8,0"
                                           Foreground="{StaticResource Theme.Text.Secondary}"/>
                                <!--
                                  The comparison's own tokens, meaning what they already mean: a line
                                  on one side only is "only here", a line that became another is
                                  "differs". Reusing them keeps this window and the folder comparison
                                  speaking one visual language, and inherits ThemeCatalogTests' AA
                                  check across all 21 built-ins rather than risking a new palette.
                                -->
                                <Border Grid.Column="1" Padding="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Op}" Value="Delete">
                                                    <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Op}" Value="Replace">
                                                    <Setter Property="Background" Value="{StaticResource Theme.Compare.Differs}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LeftText}" FontFamily="Consolas" FontSize="11"/>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding RightNumber}"
                                           FontFamily="Consolas" FontSize="11" TextAlignment="Right"
                                           Padding="0,0,8,0"
                                           Foreground="{StaticResource Theme.Text.Secondary}"/>
                                <Border Grid.Column="3" Padding="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Op}" Value="Insert">
                                                    <Setter Property="Background" Value="{StaticResource Theme.Compare.OnlyHere}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Op}" Value="Replace">
                                                    <Setter Property="Background" Value="{StaticResource Theme.Compare.Differs}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RightText}" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </DockPanel>
</v:ThemedWindow>
