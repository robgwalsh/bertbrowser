<v:ThemedWindow x:Class="BertBrowser.App.Views.NewItemDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:v="clr-namespace:BertBrowser.App.Views"
                Title="New" Width="460" SizeToContent="Height" MinHeight="180"
                ResizeMode="NoResize"
                WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                Background="{StaticResource Theme.Surface.Background}"
                TextElement.Foreground="{StaticResource Theme.Text.Primary}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Create" MinWidth="88" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="PromptText" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged"/>

            <!-- Where it will go, so a New from the folder tree says which folder it meant. -->
            <TextBlock x:Name="LocationText" Margin="0,10,0,0" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource Theme.Text.Secondary}"/>

            <TextBlock x:Name="ProblemText" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Theme.Error.Foreground}"
                       Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</v:ThemedWindow>
