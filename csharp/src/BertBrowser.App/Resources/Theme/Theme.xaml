<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      The whole theme, assembled for App.xaml. Each file below merges Tokens.xaml itself (via
      Controls/Primitives.xaml) because StaticResource does not reach sibling dictionaries — see
      ThemeTokenDictionary. Tokens.xaml is listed here as well so that views and Styles.xaml, which
      resolve through the application's resource tree rather than dictionary-to-dictionary, find the
      Theme.* keys too.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml"/>
        <ResourceDictionary Source="Controls/ScrollBars.xaml"/>
        <ResourceDictionary Source="Controls/Buttons.xaml"/>
        <ResourceDictionary Source="Controls/Inputs.xaml"/>
        <ResourceDictionary Source="Controls/Lists.xaml"/>
        <ResourceDictionary Source="Controls/Menus.xaml"/>
        <ResourceDictionary Source="Controls/Misc.xaml"/>
        <ResourceDictionary Source="Controls/Window.xaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
