<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="BertBrowser.App"/>

  <!-- asInvoker. A file browser runs as the person using it: what it opens, deletes and launches
       should carry their rights and no more. Two jobs need more than that, and each lives in its
       own short-lived helper: reading the NTFS MFT needs a raw volume handle (BertBrowser.Indexer),
       and a file operation Windows refused needs a token for exactly that operation
       (BertBrowser.Elevator, started only from a click on a shield, one request, then it exits).

       Do not put requireAdministrator back here to fix an access-denied error. Browsing stays as it
       is — a folder this app cannot read is a folder Explorer cannot read either — and a *write*
       that is refused is now offered a retry through the helper, with a prompt the user answers,
       rather than by handing this process a token it holds all session for everything it does. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
