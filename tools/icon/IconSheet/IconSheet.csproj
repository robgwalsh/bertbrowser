<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately outside bertbrowser.sln. It is a thing you run when changing an icon, not part
       of the app, and nothing should have to build it to build the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
