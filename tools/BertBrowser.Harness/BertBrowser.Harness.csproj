<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- UseWPF infers WinExe, which detaches the process from the console its output is
         being read from. This harness exists to be read, so keep it a console app. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>

    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <AssemblyName>BertBrowser.Harness</AssemblyName>
    <RootNamespace>BertBrowser.Harness</RootNamespace>

    <!-- asInvoker, unlike the app's requireAdministrator manifest. Nothing the harness drives
         needs the MFT — it never starts the indexer — and a run that prompted for elevation
         would be exactly the interruption this tool exists to avoid. Launched from an already
         elevated shell it simply inherits that token. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- A WPF project's implicit usings are the desktop set, which leaves System.IO out.
         Everything here writes captures and fixtures to disk. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BertBrowser.App\BertBrowser.App.csproj" />
  </ItemGroup>

</Project>
